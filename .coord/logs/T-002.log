                e.Handled = true;
            }
        }, RoutingStrategies.Tunnel, true);

        Opened += (_, _) =>
        {
            Log("probe-start", $"os={RuntimeInformation.OSDescription}; framework={RuntimeInformation.FrameworkDescription}; renderScaling={RenderScaling:F3}; dpi={RenderScaling * 96:F1}; editorFocused={_editor.IsFocused}; log={_logPath}");
            if (OperatingSystem.IsWindows())
                Win32Properties.AddWndProcHookCallback(this, WndProcHook);
            _editor.Focus();
        };
        Closed += (_, _) =>
        {
            if (OperatingSystem.IsWindows())
                Win32Properties.RemoveWndProcHookCallback(this, WndProcHook);
            Log("probe-close", "window closed");
            _writer.Dispose();
        };
    }

    private void LogPointer(string name, PointerEventArgs e)
    {
        var p = e.GetPosition(_editor);
        Log(name, $"type={e.Pointer.Type} position=({F(p.X)},{F(p.Y)})");
    }

    private IntPtr WndProcHook(IntPtr hWnd, uint msg, IntPtr wParam, IntPtr lParam, ref bool handled)
    {
        var name = msg switch
        {
            WmPointerUpdate => "WM_POINTERUPDATE",
            WmPointerDown => "WM_POINTERDOWN",
            WmPointerUp => "WM_POINTERUP",
            WmPointerEnter => "WM_POINTERENTER",
            WmPointerLeave => "WM_POINTERLEAVE",
            WmPointerCaptureChanged => "WM_POINTERCAPTURECHANGED",
            WmMouseWheel => "WM_MOUSEWHEEL",
            WmMouseHWheel => "WM_MOUSEHWHEEL",
            WmGesture => "WM_GESTURE",
            _ => null
        };
        if (name is not null)
        {
            var detail = msg is WmMouseWheel or WmMouseHWheel
                ? $"delta={unchecked((short)((long)wParam >> 16))} keyState={unchecked((ushort)(long)wParam)} lParam=0x{lParam.ToInt64():X}"
                : $"wParam=0x{wParam.ToInt64():X} lParam=0x{lParam.ToInt64():X}";
            Log($"native-{name}", detail);
        }
        return IntPtr.Zero;
    }

    private void Log(string name, string detail)
    {
        var elapsed = Stopwatch.GetElapsedTime(_startedTimestamp);
        var line = $"{DateTimeOffset.UtcNow:O} +{elapsed.TotalMilliseconds.ToString("F1", CultureInfo.InvariantCulture)}ms focused={_editor.IsFocused} scale={RenderScaling:F3} {name} {detail}";
        _writer.WriteLine(line);
        Dispatcher.UIThread.Post(() =>
        {
            _latest.Text = line;
            _recent.Add(line);
            while (_recent.Count > 30)
                _recent.RemoveAt(0);
        });
    }

    private static string F(double value) => value.ToString("F3", CultureInfo.InvariantCulture);
}
# spike — Avalonia input probe

This is Gate 1 only: a focused AvaloniaEdit window that records Avalonia pointer, wheel, scroll-gesture and capture events plus selected native Win32 messages. It deliberately does not infer finger release from an idle timeout.

## Run

From the repository root in PowerShell:

```powershell
dotnet restore .\spikes\A\InputProbe.csproj
dotnet run --project .\spikes\A\InputProbe.csproj
```

The app writes timestamped logs under `spikes/A/logs/`. It displays the active log path in the window. The log includes UTC and monotonic elapsed milliseconds, editor focus, render scaling/DPI, OS/runtime, native message IDs/parameters, and Avalonia event data. `WM_GESTURE` is recorded as a raw message only; this probe does not decode its `HGESTUREINFO` payload.

## Build status in this restricted session

The pinned package restore could not reach NuGet.org here. On 2026-10-17, `dotnet restore .\spikes\A\InputProbe.csproj` failed with NU1301 because the configured route to `api.nuget.org` (`127.0.0.1:9`) refused the connection. The global package cache did not contain Avalonia packages, so a cache-only build was unavailable. `dotnet build --no-restore .\spikes\A\InputProbe.csproj` also failed because restore assets were absent. No successful build, launch, or touchpad observation is claimed.

When package restore is available, run from the repository root:

```powershell
dotnet restore .\spikes\A\InputProbe.csproj
dotnet build .\spikes\A\InputProbe.csproj --no-restore
dotnet run --no-build --project .\spikes\A\InputProbe.csproj
```

## Physical precision-touchpad procedure

Keep the editor focused. Pan horizontally with two fingers (F1 marks movement), pause with fingers still on the surface (F2), resume and lift both fingers (F3), and mark any visible post-lift glide (F4). Then try a reversed or aborted pan and mark cancellation (F5) and interaction end (F6). Function keys mark human-observed phases in the same log; they do not themselves validate a native event. Repeat with a vertical pan and horizontal/vertical mouse wheel for comparison. Avoid clicking outside the editor during a sample because that changes the focus condition.

## Disposable manual smoke checks

| # | Check | Expected evidence |
|---|---|---|
| 1 | Launch using the command above | Window opens; log path is visible and file exists |
| 2 | Type a few characters in editor | Text changes; logged focus is true |
| 3 | Press F1 then F6 | `human-phase MOVE` and `human-phase END` appear in order |
| 4 | Mouse press and drag in editor | Pointer pressed/moved/released appear |
| 5 | Release capture by dragging out or switching target | Capture loss appears if the platform delivers it to the editor |
| 6 | Vertical mouse wheel | Avalonia wheel delta and `WM_MOUSEWHEEL` are logged on Windows |
| 7 | Horizontal mouse wheel/tilt | Horizontal delta and `WM_MOUSEHWHEEL` are logged when provided by device/driver |
| 8 | Precision-touchpad horizontal pan | Record whether Avalonia wheel/gesture and native messages appear |
| 9 | Pause while touching; press F2 | No event silence is classified as lift; manual PAUSE marker appears |
| 10 | Lift after a pan; press F3, then F4 if glide continues | Compare human markers with native/Avalonia event sequence |
| 11 | Reverse or abort a pan; press F5 and F6 | Compare cancellation marker with native capture/gesture sequence |
| 12 | Inspect log during a long pan | Timestamps remain ordered; log records OS and display scaling |

This checklist is a disposable capability probe, not application coverage. Native `WM_POINTER*` events may not represent precision-touchpad contacts, and no result is considered a PTP release signal until the target device is exercised.
