using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.ApplicationLifetimes;
using Avalonia.Media;
using Avalonia.Threading;

namespace AntiQuickPad.Design;

// Isolated from resident notes, hotkey, tray and single-instance ownership.
internal static class DesignEntry
{
    public static string[]? Arguments { get; private set; }
    public static int Run(string[] args)
    {
        Arguments = args;
        if (args[0] == \"--render-design\" && (args.Length "'!= 3 || !new[] { "quiet", "card", "pro" }.Contains(args[1].ToLowerInvariant())))
        { Console.Error.WriteLine("Usage: --render-design <quiet|card|pro> <outdir>"); return 2; }
        if (args[0] == "--probe-backdrop" && (args.Length < 2 || !new[] { "none", "mica", "acrylic", "blur" }.Contains(args[1])))
        { Console.Error.WriteLine("Usage: --probe-backdrop <none|mica|acrylic|blur> [--report path] [--close-after-ms milliseconds]"); return 2; }
        return AppBuilder.Configure<App>().UsePlatformDetect().LogToTrace().StartWithClassicDesktopLifetime(args);
    }

    public static void Start(IClassicDesktopStyleApplicationLifetime desktop)
    {
        var args = Arguments!;
        if (args[0] == "--render-design")
        {
            var window = new DesignWindow(args[1].ToLowerInvariant());
            desktop.MainWindow = window;
            window.Opened += async (_, _) =>
            {
                try { await window.RenderStates(Path.GetFullPath(args[2])); window.Close(); desktop.Shutdown(0); }
                catch (Exception ex) { Console.Error.WriteLine(ex); desktop.Shutdown(1); }
            };
        }
        else
        {
            var mode = args[1];
            var level = mode switch { "mica" => WindowTransparencyLevel.Mica, "acrylic" => WindowTransparencyLevel.AcrylicBlur,
                "blur" => WindowTransparencyLevel.Blur, _ => WindowTransparencyLevel.None };
            var window = new Window
            {
                Title = $"AntiQuickPad · {mode} backdrop probe", Width = 800, Height = 600,
                WindowDecorations = WindowDecorations.Full,
                TransparencyLevelHint = new[] { level },
                Background = new SolidColorBrush(Color.Parse("#99171D25")),
                TransparencyBackgroundFallback = new SolidColorBrush(Color.Parse("#171D25")),
                Content = new StackPanel { Margin = new Thickness(48), Spacing = 18, Children = {
                    new TextBlock { Text = "Backdrop / " + mode, FontSize = 28, Foreground = Brushes.White },
                    new TextBlock { Text = "Move this window across a bright and dark desktop.'"\\nCheck the background, text edges, resize and focus changes.\\nClose this probe when finished.\", FontSize = 17, Foreground = Brushes.White, LineHeight = 28 }
                }}
            };
            desktop.MainWindow = window;
            window.Opened += async (_, _) =>
            {
                await Task.Delay(800);
                var report = "'$"mode={mode}; requested={level}; actual={window.ActualTransparencyLevel}; OS={System.Runtime.InteropServices.RuntimeInformation.OSDescription}; Avalonia={typeof(Window).Assembly.GetName().Version}";
                ((StackPanel)window.Content!).Children.Add(new TextBlock { Text = report, TextWrapping = TextWrapping.Wrap, Foreground = Brushes.White });
                Console.WriteLine(report);
                var ri = Array.IndexOf(args, "--report");
                if (ri >= 0 && ri + 1 < args.Length) File.WriteAllText(Path.GetFullPath(args[ri + 1]), report + Environment.NewLine);
                var ci = Array.IndexOf(args, "--close-after-ms");
                if (ci >= 0 && ci + 1 < args.Length) { await Task.Delay(int.Parse(args[ci + 1])); window.Close(); }
            };
            window.Closed += (_, _) => desktop.Shutdown();
        }
    }
}
