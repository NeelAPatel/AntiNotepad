            </summary>
        </member>
        <member name="F:Avalonia.Controls.WindowDecorations.BorderOnly">
            <summary>
            Window border without titlebar
            </summary>
        </member>
        <member name="F:Avalonia.Controls.WindowDecorations.Full">
            <summary>
            Fully decorated (default)
            </summary>
        </member>
        <member name="T:Avalonia.Controls.WindowClosingBehavior">
            <summary>
