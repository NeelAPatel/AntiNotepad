namespace AntiQuickPad.Design;
internal sealed record DesignSpec(string Id, string Title, string Subtitle, string Surface, string Canvas, string Rule, Look Look)
{
    public static DesignSpec Get(string id)
    {
        static Color C(string hex) => Color.Parse(hex);
        return id switch
        {
            "quiet" => new(id, "Quiet", "A little room to think", "#FAFAF7", "#FAFAF7", "#E2E4DF",
                new Look("Quiet", C("#FAFAF7"), C("#29332F"), C("#758079"), C("#537864"), "Segoe UI Variable Text", "Segoe UI Variable Text", 17, false)
                { EditorPadding = 0, HeadingColors = [C("#29332F"), C("#3F5146"), C("#3F5146")], HeadingSizes = [30, 22, 19], MarkdownMarker = C("#9DA69F"),
                    CodeFont = "Cascadia Mono", CodePanel = C("#EEF0EB"), Keyword = C("#70578C"), String = C("#52765B"), Comment = C("#7E8880"),
                    CheckboxSize = 14, CheckboxRadius = 4, CheckboxStroke = 1.25, CheckboxCheck = C("#FFFFFF"), IndentGuide = C("#DDE2DC"), IndentGuideActive = C("#A1B5A5"), StrikeThicknessEm = .10 }),
            "card" => new(id, "Card", "Your thoughts, one at a time", "#F8FAFF", "#DEE5F0", "#D5DDEB",
                new Look("Card", C("#F8FAFF"), C("#283852"), C("#76849C"), C("#556CD2"), "Segoe UI Variable Text", "Segoe UI Variable Text", 16, false)
                { EditorPadding = 0, HeadingColors = [C("#283852"), C("#475B8B"), C("#475B8B")], HeadingSizes = [30, 22, 19], MarkdownMarker = C("#A0ABC0"),
                    CodeFont = "Cascadia Mono", CodePanel = C("#ECF0F9"), Keyword = C("#7955A2"), String = C("#47745A"), Comment = C("#79889D"),
                    CheckboxSize = 15, CheckboxRadius = 5, CheckboxStroke = 1.4, CheckboxCheck = C("#FFFFFF"), IndentGuide = C("#D6DEEF"), IndentGuideActive = C("#9BAADE"), StrikeThicknessEm = .10 }),
            _ => new("pro", "Pro", "Everything within reach", "#20252C", "#1A1E24", "#343B45",
                Look.Default with { Name = "Pro", EditorFont = "Consolas", CodeFont = "Consolas", Background = C("#20252C"), Foreground = C("#DCE2EA"), Muted = C("#8896A8"), Accent = C("#9BB8DB"),
                    FontSize = 15, EditorPadding = 0, ShowGutter = true, HeadingColors = [C("#E4EBF5"), C("#A9BCD6"), C("#A9BCD6")], HeadingSizes = [25, 20, 18],
                    CodePanel = C("#272F39"), CheckboxSize = 13, CheckboxRadius = 3, CheckboxStroke = 1.2, IndentGuide = C("#37414F"), IndentGuideActive = C("#758BA9"), StrikeThicknessEm = .10 })
        };
    }
}



using Avalonia.Controls;
using AvaloniaEdit;
using AntiQuickPad.ViewModels;
namespace AntiQuickPad.Views;
/// <summary>A resident shell hosts one editor and binds its controls to the supplied view model.</summary>
public interface IEditorHost
{
    TextEditor Editor { get; }
}

public interface IShellView : IEditorHost
{
    Window Host { get; }
    MainViewModel ViewModel { get; }
    void ShowResident(string source, long started = 0);
    void HideResident();
    void Quit(int exitCode = 0, string source = "tray");
    void MeasurementHeavy();
}
# T-013: build Quiet (A) and Card (B) as production shells, light + dark

Director: Codex gpt-6.1-sol medium. Luna workers: one per shell is a good split (one writer per file; shared code owned by the Director).
Branch: feat/shells (manager handles git).
Read first: AGENTS.md, docs/architecture.md (dependency rule + "how to add a shell"), docs/design/m6/README.md and its PNGs (the approved look for Quiet and Card), docs/feedback/TRACKER.md (M6, F4, F20, F24), .coord/reports/T-011.md, .coord/reports/T-012.md, src/.
Write only in src/AntiQuickPad/ (Views/Quiet, Views/Card, shared Views/Common, Editor, App wiring), docs/design/m6/built/, docs/architecture.md (update), .coord/reports/T-013.md, .coord/status-T013.md. Core and ViewModels may change ONLY if a shell genuinely needs a new command/property; list each such change and why. No git, no STATUS.md, no network, no new packages.
Build: from src/AntiQuickPad `dotnet bin/Release/net10.0/AntiQuickPad.dll --quit`, then `$env:AVALONIA_TELEMETRY_OPTOUT='1'; dotnet build -c Release --no-restore -p:UseSharedCompilation=false`. Never kill processes.
Finish in ONE turn; checkpoint per shell; end only when the report is written or blocked.

## Decisions (user)
- Build BOTH Quiet and Card, "built and well supported": the real resident app, not render fixtures. Classic stays as a fallback shell id.
- Each shell has a light AND dark palette. Default follows the Windows app theme (live: switching Windows theme updates the open app). Manual override in the More menu: Theme = System / Light / Dark. Persisted.
- Shell choice in the More menu (Quiet / Card), switchable at runtime without restart, persisted. Default shell: Quiet.
- UI stays separate from backend: shells bind to MainViewModel commands/properties only (see architecture.md).

## Per shell (match the approved renders; dark palette designed to the same standard, not an inversion)
- Window: unified in-client title/toolbar (ExtendClientArea) with the rendered controls: New, More, Pin, Minimize, Close (= hide). Drag region on empty toolbar space; keep Windows snap layouts/double-click maximize working. Bottom bar as rendered (Quiet: prev/next + "3 of 8", save state, Esc hint, delete; Card: floating pager with dots + exact count, save state).
- Bars: subdued when idle, full strength on pointer hover or keyboard focus (first step toward F4 hover-reveal; layout must not shift).
- Editor: production EditorFactory with the shell's Look; F20 active line highlight and F24 chevron fold margin in the real app (not design-only); typography/spacing per README.
- Carousel: existing gestures and 220 ms slide via MainViewModel. Card shows neighbour card peeks and moves the dots; Quiet slides the page. Dot range must handle >8 notes (sliding window).
- Empty note: hint text overlay as rendered.
- Menu: Theme (System/Light/Dark), Shell (Quiet/Card), Quit. Keyboard accessible.
- Show/hide path, focus-on-show, hotkey, tray, single instance, --quit, autosave, Pin, bounds restore must behave as today.

## Proof
- Extend `--render-design` (or add `--render-shell <quiet|card> <light|dark> <outdir>`) to render the REAL resident shells (not the T-011 design host): states main, bars-hover, menu-open, carousel mid-slide, empty; light and dark; scale 1 and 1.5. Output docs/design/m6/built/<shell>/<theme>/.
- View every PNG yourself. Compare against the approved T-011 renders: list any intentional differences.
- --selftest exit 0, extended with: shell switch at runtime keeps the same note/caret; theme switch updates brushes; System theme follows a simulated theme change; menu commands invoke the VM commands; scripted show-to-focus < 100 ms for BOTH shells.
- Update docs/architecture.md (shell list, theme service location).

## Done when
Release build 0 warnings/0 errors, --selftest exit 0, all renders made and viewed, report lists Core/VM changes (ideally none), differences vs approved designs, what needs the user's eyes, and the --measure command for the manager to re-run per shell.

