diff --git a/src/AntiQuickPad/Views/Common/ShellLayoutContext.cs b/src/AntiQuickPad/Views/Common/ShellLayoutContext.cs
new file mode 100644
index 0000000000000000000000000000000000000000..88624ae6d8799e2b32fa97f3d5fe157aa29047fe
--- /dev/null
+++ b/src/AntiQuickPad/Views/Common/ShellLayoutContext.cs
@@ -0,0 +1,63 @@
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Input;
+using Avalonia.Layout;
+using Avalonia.Media;
+using Avalonia.Controls.Chrome;
+using Avalonia.Automation;
+
+namespace AntiQuickPad.Views.Common;
+
+internal sealed class ShellLayoutContext(ResidentShellWindow owner, ShellPalette palette, Control page)
+{
+    public Look Look => palette.Look;
+    public Control Page => page;
+    public IBrush Ink => new SolidColorBrush(Look.Foreground);
+    public IBrush Muted => new SolidColorBrush(Look.Muted);
+    public IBrush Surface => new SolidColorBrush(Look.Background);
+    public IBrush Canvas => new SolidColorBrush(palette.Canvas);
+    public IBrush Rule => new SolidColorBrush(palette.Rule);
+    public TextBlock Count { get; } = new();
+    public TextBlock Save { get; } = new();
+    public StackPanel Dots { get; } = new() { Orientation = Orientation.Horizontal, Spacing = 7, VerticalAlignment = VerticalAlignment.Center };
+    public Control Hint { get; } = new Border { IsHitTestVisible = false, VerticalAlignment = VerticalAlignment.Top, Child = new StackPanel { Spacing = 16, Children = {
+        new TextBlock { Text = "A fresh thought.", FontSize = 34, FontWeight = FontWeight.SemiBold, Foreground = new SolidColorBrush(palette.Look.Foreground) },
+        new TextBlock { Text = "Start typing. This space is yours.", FontSize = 17, Foreground = new SolidColorBrush(palette.Look.Muted) },
+        new TextBlock { Text = "Markdown welcome. Everything saves as you go.", FontSize = 13, Foreground = new SolidColorBrush(palette.Look.Muted) }
+    } } };
+    public bool HasPrevious => owner.ViewModel.CurrentIndex > 0;
+    public bool HasNext => owner.ViewModel.CurrentIndex + 1 < owner.ViewModel.Notes.Count;
+    public List<Control> Bars { get; } = [];
+    public Control? PreviousPeek { get; set; }
+    public Control? NextPeek { get; set; }
+    public Dictionary<string, Button> Buttons { get; } = [];
+    public TextBlock Text(string value, double size, IBrush? brush = null, FontWeight? weight = null) => new()
+    { Text = value, FontSize = size, Foreground = brush ?? Ink, FontWeight = weight ?? FontWeight.Normal, VerticalAlignment = VerticalAlignment.Center };
+    public Button Button(string glyph, string label)
+    {
+        var b = new Button { Content = new TextBlock { Text = glyph, FontFamily = new FontFamily("Segoe Fluent Icons"), FontSize = 15, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center },
+            Width = 32, Height = 30, Padding = new Thickness(0), CornerRadius = new CornerRadius(6), BorderThickness = new Thickness(0),
+            Background = Brushes.Transparent, Foreground = Ink, VerticalAlignment = VerticalAlignment.Center };
+        ToolTip.SetTip(b, label); AutomationProperties.SetName(b, label);
+        b.Command = owner.CommandFor(label);
+        Buttons[label] = b;
+        return b;
+    }
+    public StackPanel Row(params Control[] controls)
+    { var row = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 4, VerticalAlignment = VerticalAlignment.Center }; foreach (var c in controls) row.Children.Add(c); return row; }
+    public Control Bar(Control control)
+    {
+        Bars.Add(control);
+        void Refresh() => control.Opacity = control.IsPointerOver || control.IsKeyboardFocusWithin ? 1 : .65;
+        control.PointerEntered += (_, _) => Refresh(); control.PointerExited += (_, _) => Refresh();
+        control.GotFocus += (_, _) => Refresh(); control.LostFocus += (_, _) => Refresh(); Refresh(); return control;
+    }
+    public Control DragRegion(Control control)
+    {
+        // Native non-client hit testing preserves Windows drag, double-click maximize and snap docking.
+        WindowDecorationProperties.SetElementRole(control, WindowDecorationsElementRole.TitleBar);
+        return control;
+    }
+    public void Place(Grid root, Control control, HorizontalAlignment horizontal, VerticalAlignment vertical, Thickness margin)
+    { control.HorizontalAlignment = horizontal; control.VerticalAlignment = vertical; control.Margin = margin; root.Children.Add(control); }
+}
diff --git a/src/AntiQuickPad/Views/Common/ShellPalette.cs b/src/AntiQuickPad/Views/Common/ShellPalette.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c91a57e160000fb62bf0c45f95ae9bbcd3d50fca
--- /dev/null
+++ b/src/AntiQuickPad/Views/Common/ShellPalette.cs
@@ -0,0 +1,26 @@
+using Avalonia.Media;
+
+namespace AntiQuickPad.Views.Common;
+
+internal sealed record ShellPalette(Look Look, Color Canvas, Color Rule, Color ActiveLine)
+{
+    public static ShellPalette Get(string shell, bool dark)
+    {
+        var light = Design.DesignSpec.Get(shell);
+        static Color C(string value) => Color.Parse(value);
+        if (!dark) return new(light.Look, C(light.Canvas), C(light.Rule), C(shell == "card" ? "#E9EDF9" : "#EAF0E9"));
+        var card = shell == "card";
+        var look = light.Look with
+        {
+            Name = card ? "Card Dark" : "Quiet Dark", Background = C(card ? "#232B3C" : "#202823"),
+            Foreground = C(card ? "#DFE6F5" : "#E1E9E1"), Muted = C(card ? "#9AA9C4" : "#9CAA9F"),
+            Accent = C(card ? "#A2B2FF" : "#9FC8AA"),
+            HeadingColors = card ? [C("#E7EDFA"), C("#B4C5ED"), C("#B4C5ED")] : [C("#E8EEE7"), C("#B8D1BD"), C("#B8D1BD")],
+            MarkdownMarker = C(card ? "#7E8DAA" : "#798C7D"), CodePanel = C(card ? "#1B2333" : "#19221D"),
+            Keyword = C("#C5ACE8"), String = C("#A5C9AD"), Comment = C("#8E9E9B"),
+            IndentGuide = C(card ? "#38445F" : "#34483B"), IndentGuideActive = C(card ? "#8395CB" : "#84A58E"),
+            CheckboxCheck = C(card ? "#232B3C" : "#202823")
+        };
+        return new(look, C(card ? "#151D2C" : "#202823"), C(card ? "#3B4862" : "#3C4B40"), C(card ? "#303D5C" : "#304537"));
+    }
+}
diff --git a/src/AntiQuickPad/Views/Common/ShellRender.cs b/src/AntiQuickPad/Views/Common/ShellRender.cs
new file mode 100644
index 0000000000000000000000000000000000000000..5b5fa46d0974ad4fac8203f9ee1ea8ef34538619
--- /dev/null
+++ b/src/AntiQuickPad/Views/Common/ShellRender.cs
@@ -0,0 +1,60 @@
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Layout;
+using Avalonia.Media;
+using Avalonia.Media.Imaging;
+
+namespace AntiQuickPad.Views.Common;
+
+internal static class ShellRender
+{
+    private static string[]? _args;
+    internal static bool IsRendering => _args is not null;
+    public static void Initialize(string[] args) => _args = args;
+    public static async Task Capture(ResidentShellWindow window)
+    {
+        var code = 1;
+        try { await window.RenderProductionStates(_args![2], Path.GetFullPath(_args[3])); code = 0; }
+        catch (Exception ex) { Console.Error.WriteLine(ex); }
+        window.Quit(code, "render");
+    }
+}
+
+public sealed partial class ResidentShellWindow
+{
+    internal async Task RenderProductionStates(string theme, string output)
+    {
+        Directory.CreateDirectory(output);
+        for (var i = _vm.Notes.Count; i < 8; i++) _vm.CreateCommand.Execute(null);
+        for (var i = 0; i < 8; i++)
+        {
+            _vm.Select(i); _editor.Text = i == 3 ? "# Make it feel effortless\n\nThe best tools get out of the way.\n\n## Next time\n- [ ] Try the shortcut without looking\n- [ ] Read a long note at 150% scaling\n" : Design.DesignWindow.Fixture;
+        }
+        _vm.Select(2); SetTheme(theme);
+        Width = 960; Height = 800;
+        _root.Width = 960; _root.Height = 800;
+        _frame.Child = null;
+        var capture = new Viewbox { Stretch = Stretch.Fill, Child = _root }; Content = capture;
+        foreach (var state in new[] { "main", "bars-hover", "menu-open", "carousel", "empty" })
+        {
+            _carousel.Cancel();
+            if (state == "empty") { _vm.CreateCommand.Execute(null); }
+            else { _editor.CaretOffset = _editor.Document.GetLineByNumber(13).Offset + 20; }
+            SaveNotes();
+            _menu.IsVisible = state == "menu-open";
+            foreach (var bar in _layout.Bars) bar.Opacity = state == "main" ? .65 : 1;
+            if (_layout.Buttons.TryGetValue("More", out var more)) more.Background = state is "bars-hover" or "menu-open" ? new SolidColorBrush(CurrentLook.CodePanel) : Brushes.Transparent;
+            await Task.Delay(100); UpdateLayout(); _editor.TextArea.Focus(); _editor.TextArea.TextView.EnsureVisualLines();
+            if (state == "carousel") { _carousel.BeginDrag(0, 0); _carousel.MoveDrag(-350, 100); }
+            foreach (var scale in new[] { 1d, 1.5d })
+            {
+                if (state == "empty") _editor.TextArea.Caret.Hide(); else _editor.TextArea.Caret.Show();
+                await Task.Delay(30);
+                capture.Measure(new Size(960 * scale, 800 * scale)); capture.Arrange(new Rect(0, 0, 960 * scale, 800 * scale));
+                using var bitmap = new RenderTargetBitmap(new PixelSize((int)(960 * scale), (int)(800 * scale)), new Vector(96, 96));
+                bitmap.Render(capture);
+                var path = Path.Combine(output, state + (scale == 1 ? "@1x.png" : "@1.5x.png")); bitmap.Save(path, PngBitmapEncoderOptions.Default); Console.WriteLine(path);
+            }
+        }
+    }
+}
