 /// <summary>Builds the Markdown-aware editor and keeps each document's parsed line map shared by every renderer.</summary>
 internal static class EditorFactory
 {
-    public static TextEditor Create(Look look, ViewModels.MainViewModel? viewModel = null)
+    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<TextEditor, Action> Cleanup = new();
+    public static void Release(TextEditor editor)
+    {
+        if (Cleanup.TryGetValue(editor, out var cleanup)) { cleanup(); Cleanup.Remove(editor); }
+        editor.TextArea.TextView.LineTransformers.Clear();
+        editor.TextArea.TextView.BackgroundRenderers.Clear();
