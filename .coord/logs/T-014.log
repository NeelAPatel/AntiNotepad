            var dot = new Button { Width = selected ? 20 : 8, Height = 18, Padding = new Thickness(0), BorderThickness = new Thickness(0),
                Background = Brushes.Transparent, Content = new Border { Width = selected ? 20 : 5, Height = 5, CornerRadius = new CornerRadius(3),
                    Background = selected ? new SolidColorBrush(CurrentLook.Accent) : _layout.Muted, Opacity = selected ? 1 : .5 },
                Command = new RelayCommand(() => _vm.Select(index)) };
