using Avalonia.Threading;
using AvaloniaEdit;
using AntiQuickPad.Editor;

namespace AntiQuickPad.Carousel;

// A burst owns one destination for its entire animation and until 140ms idle.
// No accumulated wheel delta and no queued page requests: a notch cannot skip pages.
internal sealed class WheelGate
{
    private long _last = long.MinValue / 2;
    public int Request(double delta, long now, bool busy)
    {
        if (Math.Abs(delta) < .001) return 0;
        var fresh = now - _last > 140;
        _last = now;
        return !busy && fresh ? Math.Sign(delta) : 0;
    }
}

internal sealed class CarouselController
{
    public const double SlideMs = 220;
    private readonly TextEditor _editor, _preview;
    private readonly Func<int> _index, _count;
    private readonly Func<int, string> _text;
    private readonly Func<int, Vector> _scroll;
    private readonly Action<int> _select;
    private readonly Action _activity;
    private readonly Grid _viewport = new() { ClipToBounds = true };
    private readonly TranslateTransform _currentTransform = new(), _previewTransform = new();
    private readonly DispatcherTimer _timer = new() { Interval = TimeSpan.FromMilliseconds(16) };
    private readonly WheelGate _wheel = new();
    private readonly Stopwatch _clock = Stopwatch.StartNew();
    private readonly Border _grab;
    private long _started;
    private double _from, _to, _offset, _origin, _lastX, _lastMs, _velocity;
    private int _target, _previewIndex = -1;
    private bool _animating, _dragging;
    private IPointer? _pointer;
    private readonly Func<double, double>? _pageStride;
    public Control View { get; }
    public bool IsBusy => _animating || _dragging;
    private double PageWidth => Math.Max(1, _pageStride?.Invoke(_viewport.Bounds.Width) ?? _viewport.Bounds.Width);

