        if (_layout is null) return;
        _layout.Count.Text = $"{_vm.CurrentIndex + 1} of {_vm.Notes.Count}";
        _layout.Count.FontSize = 12; _layout.Count.Foreground = _layout.Muted;
        _layout.Save.Text = _vm.Status.Failed || _vm.Status.Saving ? _vm.Status.Text : _editor.Text.Length == 0 ? "Ready to write" : "All changes saved"; _layout.Save.FontSize = 12;
        _layout.Save.Foreground = _vm.Status.Failed ? new SolidColorBrush(CurrentLook.Accent) : _layout.Muted;
