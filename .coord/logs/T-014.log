using Avalonia;
using Avalonia.Controls;
using Avalonia.Layout;
using Avalonia.Media;
using AntiQuickPad.Views.Common;

namespace AntiQuickPad.Views.Card;

internal static class CardLayout
{
    private const double CardMaxWidth = 816;
    private const double PreviousPeekOffset = -862;
    private const double NextPeekOffset = 818;

    public static Control Build(ShellLayoutContext c)
    {
        var root = new Grid
        {
            Background = c.Canvas,
            ClipToBounds = true
        };

        var deck = new Grid
        {
            ClipToBounds = true,
            Margin = new Thickness(0, 82, 0, 62)
        };
        root.Children.Add(deck);

        c.PreviousPeek = CreatePeek(c, "Previous note", PreviousPeekOffset, HorizontalAlignment.Center);
        c.NextPeek = CreatePeek(c, "Next note", NextPeekOffset, HorizontalAlignment.Center);
        deck.Children.Add(c.PreviousPeek); deck.Children.Add(c.NextPeek);

        deck.Children.Add(c.Page);

        c.Place(root, c.Hint, HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(146, 150, 80, 0));

        // Keep the native drag surface below the toolbar controls in z order.
        var drag = new Border
        {
            Background = Brushes.Transparent,
            Height = 58,
            HorizontalAlignment = HorizontalAlignment.Stretch,
            VerticalAlignment = VerticalAlignment.Top
        };
        c.Place(root, c.DragRegion(drag), HorizontalAlignment.Stretch,
            VerticalAlignment.Top, new Thickness(190, 0, 280, 0));

        var title = c.Row(
            c.Text("AntiQuickPad", 14, c.Ink, FontWeight.SemiBold),
            c.Text("  /  Notes", 13, c.Muted));
        c.Place(root, c.Bar(title), HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(30, 28, 0, 0));

        var actions = Capsule(c,
            c.Button("\uE710", "New note"),
            c.Button("\uE74D", "Delete note"),
            c.Button("\uE712", "More"),
            Rule(c),
            c.Button("\uE718", "Pin"),
            c.Button("\uE921", "Minimize"),
            c.Button("\uE8BB", "Hide"));
        c.Place(root, c.Bar(actions), HorizontalAlignment.Right, VerticalAlignment.Top,
            new Thickness(0, 17, 27, 0));

        var pager = Capsule(c,
            c.Button("\uE76B", "Previous"),
            c.Dots,
            c.Button("\uE76C", "Next"));
        c.Place(root, c.Bar(pager), HorizontalAlignment.Center, VerticalAlignment.Bottom,
            new Thickness(0, 0, 0, 12));

        c.Place(root, c.Bar(c.Count), HorizontalAlignment.Left, VerticalAlignment.Bottom,
            new Thickness(33, 0, 0, 28));
        c.Place(root, c.Bar(c.Save), HorizontalAlignment.Right, VerticalAlignment.Bottom,
            new Thickness(0, 0, 31, 28));

        return root;
    }

    private static Control CreatePeek(ShellLayoutContext c, string label, double offset,
        HorizontalAlignment alignment)
    {
        var peek = new Border
        {
            Width = CardMaxWidth,
            MaxWidth = CardMaxWidth,
            Margin = new Thickness(0, 18, 0, 18),
            CornerRadius = new CornerRadius(18),
            Background = c.Surface,
            BorderBrush = c.Rule,
            BorderThickness = new Thickness(1),
            HorizontalAlignment = alignment,
            VerticalAlignment = VerticalAlignment.Stretch,
            IsHitTestVisible = false,
            Child = new Border
            {
                Margin = new Thickness(42, 28, 0, 0),
                VerticalAlignment = VerticalAlignment.Top,
                Child = c.Text(label, 20, c.Muted)
            }
        };

        peek.RenderTransform = new TranslateTransform(offset, 0);
        return peek;
    }

    private static Control Capsule(ShellLayoutContext c, params Control[] children) => new Border
    {
        Padding = new Thickness(9, 5),
        CornerRadius = new CornerRadius(12),
        Background = c.Surface,
        BorderBrush = c.Rule,
        BorderThickness = new Thickness(1),
        BoxShadow = new BoxShadows(new BoxShadow
        {
            OffsetY = 3,
            Blur = 12,
            Color = Color.Parse("#1233486C")
        }),
        Child = c.Row(children)
    };

    private static Control Rule(ShellLayoutContext c) => new Border
    {
        Width = 1,
        Height = 16,
        Background = c.Rule,
        Margin = new Thickness(7, 0)
    };
}


using Avalonia;
using Avalonia.Controls;
