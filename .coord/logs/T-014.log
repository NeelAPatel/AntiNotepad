            Margin = new Thickness(0, _shellId == "card" ? 66 : 52, 24, 0), Padding = new Thickness(5),
            CornerRadius = new CornerRadius(10), BorderBrush = _layout.Rule, BorderThickness = new Thickness(1),
            Background = _layout.Surface, BoxShadow = new BoxShadows(new BoxShadow { OffsetY = 10, Blur = 30, Color = Color.Parse("#30000000") }), Child = list, IsVisible = false };
        KeyboardNavigation.SetTabNavigation(menu, KeyboardNavigationMode.Cycle);
        menu.KeyDown += (_, e) =>
        {
