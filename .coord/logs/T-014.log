    private Control DecorateCard(Control editor) => new Border
    {
        MaxWidth = 816, Margin = new Thickness(72, 0), Padding = new Thickness(44, 28, 38, 16),
        CornerRadius = new CornerRadius(16), Background = new SolidColorBrush(CurrentLook.Background),
