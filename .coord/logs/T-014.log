namespace AntiQuickPad.Views.Common;

public sealed partial class ResidentShellWindow
{
    private static void Check(bool condition, string message) { if (!condition) throw new Exception(message); }
    private async Task RunSelfTest()
    {
        var code = 1;
        try
        {
            await Task.Delay(150);
            EditorFactory.RunSmoke(); CarouselController.RunSmoke();
            foreach (var shell in new[] { "quiet", "card" })
            {
                SwitchShell(shell);
                _editor.Text = "# Same note\nkeep this caret\n- [ ] task"; _editor.CaretOffset = 17;
                var id = _vm.Current.Id; var text = _editor.Text;
                var document = _editor.Document;
                SwitchShell(shell == "quiet" ? "card" : "quiet");
                Check(_vm.Current.Id == id && _editor.Text == text && _editor.CaretOffset == 17, "Shell switch lost note/caret");
                Check(ReferenceEquals(document, _editor.Document), "Shell switch replaced the note document/undo history");
                SwitchShell(shell);
                var count = _vm.Notes.Count;
                Check(ReferenceEquals(_menuCommands["New note"], _vm.CreateCommand) && ReferenceEquals(_menuCommands["Delete note"], _vm.DeleteCommand), "Menu did not route to VM commands");
                _menuCommands["New note"].Execute(null); Check(_vm.Notes.Count == count + 1, "Menu New failed");
                _menuCommands["Delete note"].Execute(null); Check(_vm.Notes.Count == count, "Menu Delete failed");
                foreach (var theme in new[] { "light", "dark" })
                {
                    _menuCommands[theme == "light" ? "Light" : "Dark"].Execute(null);
                    Check(((SolidColorBrush)_editor.Background!).Color == ShellPalette.Get(shell, theme == "dark").Look.Background, "Theme brush mismatch");
                }
                _menuCommands["System"].Execute(null);
                _theme.SimulateSystem(false); var light = ((SolidColorBrush)_editor.Background!).Color;
                _theme.SimulateSystem(true); Check(((SolidColorBrush)_editor.Background!).Color != light, "System simulated update did not reach editor");
                _theme.SimulateSystem(null);
                _vm.Pinned = true; Check(Topmost, "Pin failed"); _vm.Pinned = false;
                Check(_vm.LoadSettings() is { } saved && saved.ShellId == shell && saved.LookId == "system", "Appearance persistence failed");
                var original = _editor;
                for (var i = 0; i < 3; i++)
                {
                    HideResident(); await Task.Delay(30);
                    _focusCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
                    ShowResident("selftest-" + shell);
                    var ms = await _focusCompletion.Task.WaitAsync(TimeSpan.FromSeconds(3));
                    Check(ms < 100 && ReferenceEquals(original, _editor), "Resident focus budget/editor identity failed");
                    Console.WriteLine($"T013 {shell} show-to-focus internal ms={ms:F3}");
                }
                Close(); Check(!IsVisible && !_quitting, "Close must hide"); ShowResident("selftest-close");
                _editor.Text = "debounced " + shell; _editor.CaretOffset = 7; await Task.Delay(500);
                Check(ViewModels.MainViewModel.VerifyCurrentText(Program.Paths.Notes, _editor.Text), "Autosave failed");
                _vm.CreateCommand.Execute(null); _vm.PreviousCommand.Execute(null);
                _carousel.RequestWheel(1, 1000); await Task.Delay(300);
                Check(_vm.CurrentIndex == _vm.Notes.Count - 1 && !_carousel.IsBusy, "Live carousel wheel failed");
                _vm.DeleteCommand.Execute(null);
                if (shell == "card")
                {
                    for (var n = _vm.Notes.Count; n < 12; n++) _vm.CreateCommand.Execute(null);
                    Check(_layout.Dots.Children.Count == 8 && _layout.Count.Text == "12 of 12", "Sliding dot range/count failed above eight notes");
                    _vm.Select(0); Check(_layout.Dots.Children.Count == 8 && _layout.PreviousPeek?.IsVisible == false && _layout.NextPeek?.IsVisible == true, "Neighbour visibility/dot window did not follow navigation");
                }
                Console.WriteLine($"T013 {shell} PASS: switching/caret, palettes, simulated system update, menu VM routes, persistence, pin, resident focus, close/hide, autosave, carousel.");
            }
            // Retain the entire pre-existing capability suite, including process/quit and measurement contracts.
            var start = new ProcessStartInfo(Environment.ProcessPath!) { UseShellExecute = false, CreateNoWindow = true };
            if (string.Equals(Path.GetFileNameWithoutExtension(Environment.ProcessPath),"dotnet", StringComparison.OrdinalIgnoreCase)) start.ArgumentList.Add(typeof(Program).Assembly.Location);
            foreach (var arg in new[] { "--selftest", "--shell", "classic" }) start.ArgumentList.Add(arg);
            using var child = Process.Start(start)!;
            await child.WaitForExitAsync().WaitAsync(TimeSpan.FromMinutes(5));
            Check(child.ExitCode == 0, "Retained Classic selftest failed");
            Console.WriteLine("SELFTEST PASS: Quiet + Card production shells and retained Classic capability suite.");
            Log("SELFTEST PASS"); code = 0;
        }
        catch (Exception ex) { Console.Error.WriteLine("SELFTEST FAIL: " + ex); Log("SELFTEST FAIL: " + ex); }
        finally { Quit(code); }
    }
}

