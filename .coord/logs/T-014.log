                HorizontalAlignment = HorizontalAlignment.Stretch, HorizontalContentAlignment = HorizontalAlignment.Left,
                Height = 32, Padding = new Thickness(10, 0), Background = Brushes.Transparent, Foreground = _layout.Ink,
