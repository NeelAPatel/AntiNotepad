        }
        void Heading(string title) => list.Children.Add(new TextBlock { Text = title, FontSize = 11, Foreground = _layout.Muted, Margin = new Thickness(14, 8, 0, 3) });
        Item("New note", _vm.CreateCommand); Item("Delete note", _vm.DeleteCommand);
        Heading("THEME");
