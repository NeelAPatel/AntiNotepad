            _layout.Dots.Children.Add(dot);
        }
        if (_layout.Buttons.TryGetValue("Pin", out var pin))
        { pin.Background = _vm.Pinned ? new SolidColorBrush(CurrentLook.CodePanel) : Brushes.Transparent; }
    }
