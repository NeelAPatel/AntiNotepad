    }

    private sealed class BaseTypeface(string font) : DocumentColorizingTransformer
    {
        protected override void ColorizeLine(DocumentLine line)
        {
            if (line.Length > 0) ChangeLinePart(line.Offset, line.EndOffset,
                e => e.TextRunProperties.SetTypeface(new Typeface(new FontFamily(font), FontStyle.Normal, FontWeight.Normal)));
        }
    }
    private sealed class ActiveLineRenderer(TextEditor editor, IBrush brush) : IBackgroundRenderer
    {
        public KnownLayer Layer => KnownLayer.Background;
        public void Draw(TextView view, DrawingContext dc)
        {
            if (!view.VisualLinesValid || view.Document is null || view.Document.TextLength == 0) return;
            var line = view.VisualLines.FirstOrDefault(v => v.FirstDocumentLine.LineNumber <= editor.TextArea.Caret.Line && v.LastDocumentLine.LineNumber >= editor.TextArea.Caret.Line);
            if (line is not null) dc.DrawRectangle(brush, null, new Rect(0, line.VisualTop - view.VerticalOffset, view.Bounds.Width, line.Height), 3, 3);
        }
    }

    /// <summary>Small deterministic M3 smoke checks, called by the app selftest.</summary>
    public static void RunSmoke()
    {
        var fixture = "# Heading\n**bold** *italic* ~~gone~~\n    - [ ] task\n```python\ndef f(): # comment\n    return 'ok'\n```\n";
        var document = new TextDocument(fixture);
        var scanner = new MarkdownScanner(document);
        var lines = scanner.Lines;
        if (lines[0].HeadingLevel != 1 || lines[1].Bold.Count != 1 || lines[1].Italic.Count != 1 || lines[1].Strike.Count != 1 ||
            lines[2].CheckboxOffset < 0 || !lines[4].IsPython || lines[4].CommentOffset < 0 || scanner.GetFoldings().Count < 2)
            throw new InvalidOperationException("Markdown scanner fixture classification failed.");
        var sections = new TextDocument("# One\nbody\n\n\noutside\n# Two\nbody\n## Child\nchild\n# Three\nend");
        var sectionFolds = new MarkdownScanner(sections).GetFoldings();
        if (sectionFolds[0].EndOffset != sections.GetLineByNumber(2).EndOffset ||
            sectionFolds[1].EndOffset != sections.GetLineByNumber(9).EndOffset ||
            sectionFolds[2].EndOffset != sections.GetLineByNumber(9).EndOffset)
            throw new InvalidOperationException("Heading blank-pair / next-heading boundary failed.");
        var nested = new TextDocument("# Section\n```\na\n\n\nb\n```\ntail\n\n\noutside");
        var nestedFolds = new MarkdownScanner(nested).GetFoldings();
        if (nestedFolds.Count != 2 || nestedFolds[0].EndOffset != nested.GetLineByNumber(8).EndOffset ||
            nestedFolds[1].EndOffset != nested.GetLineByNumber(6).EndOffset)
            throw new InvalidOperationException("Independent fence folding failed.");
        foreach (var (input, expected) in new (string, string)[]
        {
            ("- text", "- text\n- "), ("  - text", "  - text\n  - "), ("\t* text", "\t* text\n\t* "),
            ("- [ ] x", "- [ ] x\n- [ ] "), ("- [x] x", "- [x] x\n- [ ] "),
            ("1. text", "1. text\n2. "), ("9. text", "9. text\n10. "),
            ("- ", ""), ("* ", ""), ("1. ", ""), ("  - [ ] ", "  "), ("- [x] ", "")
        })
        {
            var list = new TextDocument(input);
            var newCaret = EditorOperations.ContinueList(list, list.TextLength);
            if (newCaret != list.TextLength || list.Text.Replace("\r\n", "\n") != expected)
                throw new InvalidOperationException($"List Enter failed for '{input}'.");
            list.UndoStack.Undo();
            if (list.Text != input || list.UndoStack.CanUndo) throw new InvalidOperationException("List Enter was not one undo step.");
        }
        foreach (var (input, expected, outdent) in new (string, string, bool)[]
        {
            ("- ", "    - ", false), ("* ", "    * ", false), ("- [ ] ", "    - [ ] ", false),
            ("8. ", "    1. ", false), ("3. parent\n    1. ", "3. parent\n4. ", true),
            ("    - [ ] ", "- [ ] ", true), ("\t* ", "* ", true)
        })
        {
            var item = new TextDocument(input);
            var tab = EditorOperations.ApplyTab(item, item.TextLength, null, null, outdent);
            if (item.Text != expected || tab.CaretOffset != item.TextLength) throw new Exception($"Empty list indent failed: {input}");
            item.UndoStack.Undo();
            if (item.Text != input || item.UndoStack.CanUndo) throw new Exception("Empty list indent must be one undo step.");
        }
        Console.WriteLine("T007 indent PASS: 7 empty marker indent/outdent/numbering cases and single undo.");
        var checkbox = document.GetLineByNumber(3).Offset + lines[2].CheckboxOffset;
        var caret = document.TextLength;
        if (EditorOperations.ToggleCheckbox(document, checkbox, ref caret) != "[x]" || document.GetText(checkbox, 3) != "[x]" || !document.UndoStack.CanUndo)
            throw new InvalidOperationException("Checkbox toggle was not an undoable text edit.");
        document.UndoStack.Undo();
        var taskLine = document.GetLineByNumber(3);
        var result = EditorOperations.ApplyTab(document, checkbox, null, null, outdent: true);
        if (!result.Changed || document.GetText(taskLine.Offset, 5) != "- [ ]")
            throw new InvalidOperationException("Shift+Tab outdent smoke failed.");
        var selected = new TextDocument("    one\n    two");
        EditorOperations.ApplyTab(selected, selected.TextLength, 0, selected.TextLength, true);
        if (selected.Text != "one\ntwo") throw new InvalidOperationException("Selection outdent failed.");
        var typed = new MarkdownScanner(new TextDocument("python:\nreturn '# string' # comment"));
        var fenced = new MarkdownScanner(new TextDocument("```\npython:\nreturn 1\n```"));
        if (!typed.Lines[1].IsPython || typed.Lines[1].CommentOffset != 18 || !fenced.Lines[2].IsPython)
            throw new InvalidOperationException("Python language marker classification failed.");
    }

    private static void ApplyKey(TextEditor editor, MarkdownScanner scanner, KeyEventArgs e)
    {
        if (e.Key == Key.Enter && e.KeyModifiers == KeyModifiers.None && !editor.IsReadOnly && editor.SelectionLength == 0 &&
            !scanner.GetLine(editor.Document.GetLineByOffset(editor.CaretOffset).LineNumber).IsCode &&
            EditorOperations.ContinueList(editor.Document, editor.CaretOffset) is int caret)
        {
            editor.CaretOffset = caret;
            e.Handled = true;
            return;
        }
        if (e.Key != Key.Tab || editor.IsReadOnly) return;
        var selection = editor.TextArea.Selection.SurroundingSegment;
        var result = EditorOperations.ApplyTab(editor.Document, editor.CaretOffset, selection?.Offset, selection?.EndOffset,
            e.KeyModifiers.HasFlag(KeyModifiers.Shift), !scanner.GetLine(editor.Document.GetLineByOffset(editor.CaretOffset).LineNumber).IsCode);
        if (result.SelectionStart is int start && result.SelectionEnd is int end && end != start)
            editor.TextArea.Selection = Selection.Create(editor.TextArea, start, end);
        editor.CaretOffset = result.CaretOffset;
        e.Handled = true;
    }

    internal static bool TryCheckboxAt(TextEditor editor, Point point, out int markerOffset)
    {
        markerOffset = -1;
        var view = editor.TextArea.TextView;
        var hit = view.BackgroundRenderers.OfType<CheckboxRenderer>().Single().Boxes
            .FirstOrDefault(b => b.Bounds.Contains(point));
        markerOffset = hit.Offset;
        return hit.Bounds.Width > 0;
    }

    internal static void UpdateCursor(TextEditor editor, Point point) => SetHandCursor(editor, TryCheckboxAt(editor, point, out _));
    internal static readonly Cursor CheckboxHand = new(StandardCursorType.Hand);
    private static readonly Cursor TextCursor = new(StandardCursorType.Ibeam);
    private static void SetHandCursor(TextEditor editor, bool hand)
    {
        var cursor = hand ? CheckboxHand : TextCursor;
        editor.Cursor = cursor; editor.TextArea.Cursor = cursor; editor.TextArea.TextView.Cursor = cursor;
        ToolTip.SetTip(editor.TextArea.TextView, hand ? "Toggle task checkbox" : null);
    }
}

/// <summary>Pure document operations shared by input handlers and smoke checks.</summary>
internal static class EditorOperations
{
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<TextDocument, ViewModels.MainViewModel> Models = new();
    internal static void Bind(TextDocument document, ViewModels.MainViewModel model) { Models.Remove(document); Models.Add(document, model); }
    internal readonly record struct TabResult(int CaretOffset, int? SelectionStart, int? SelectionEnd, bool Changed);

    public static string? ToggleCheckbox(TextDocument document, int markerOffset, ref int caretOffset)
    {
        var result = Execute(document, new(CoreText.TextEditKind.ToggleCheckbox, document.Text, caretOffset, MarkerOffset: markerOffset));
        caretOffset = result.CaretOffset;
        return result.CheckboxToken;
    }

    public static TabResult ApplyTab(TextDocument document, int caretOffset, int? selectionStart, int? selectionEnd, bool outdent, bool allowList = true)
    {
        var result = Execute(document, new(CoreText.TextEditKind.ApplyTab, document.Text, caretOffset, selectionStart, selectionEnd, outdent, allowList));
        return new(result.CaretOffset, result.SelectionStart, result.SelectionEnd, result.Changed);
    }

    // One replace operation gives continuation/exit its own single undo step.
    public static int? ContinueList(TextDocument document, int caretOffset)
    {
        return Execute(document, new(CoreText.TextEditKind.ContinueList, document.Text, caretOffset)).ContinuationCaret;
    }

    private static CoreText.TextEditResult Execute(TextDocument document, CoreText.TextEditRequest request)
    {
        var result = Models.TryGetValue(document, out var model) ? model.PlanEdit(request) : ViewModels.MainViewModel.PlanFixtureEdit(request);
        if (result.Edits.Count > 0)
        {
            document.BeginUpdate();
            try { foreach (var edit in result.Edits) document.Replace(edit.Offset, edit.Length, edit.Replacement); }
            finally { document.EndUpdate(); }
        }
        return result;
    }
}

/// <summary>UI adapter retaining renderer-facing signatures while Core owns Markdown rules.</summary>
internal sealed class MarkdownScanner : IDisposable
{
    private readonly TextDocument _document;
    private bool _dirty = true;
    private LineInfo[] _lines = [];
    private NewFolding[] _foldings = [];
    public IReadOnlyList<LineInfo> Lines { get { Ensure(); return _lines; } }
    public MarkdownScanner(TextDocument document) { _document = document; document.Changed += OnChanged; }
    private void OnChanged(object? sender, DocumentChangeEventArgs e) => _dirty = true;
    public void Dispose() => _document.Changed -= OnChanged;
    public LineInfo GetLine(int number) { Ensure(); return _lines[Math.Clamp(number - 1, 0, _lines.Length - 1)]; }
    public IReadOnlyList<NewFolding> GetFoldings() { Ensure(); return _foldings; }

    private void Ensure()
    {
        if (!_dirty) return;
        var scan = ViewModels.MainViewModel.ScanMarkdown(_document.Text);
        _lines = scan.Lines.Select(source =>
        {
            var line = new LineInfo(source.Text)
            {
                HeadingLevel = source.HeadingLevel,
                HeadingMarkerLength = source.HeadingMarkerLength,
                CheckboxOffset = source.CheckboxOffset,
                CheckboxChecked = source.CheckboxChecked,
                BulletLength = source.BulletLength,
                FenceMarker = source.FenceMarker,
                FenceLanguage = source.FenceLanguage,
                IsFence = source.IsFence,
                IsCode = source.IsCode,
                IsPython = source.IsPython,
                PythonMarker = source.PythonMarker,
                CommentOffset = source.CommentOffset
            };
            line.Bold.AddRange(source.Bold.Select(s => new Span(s.Start, s.Length, s.MarkerLength)));
            line.Italic.AddRange(source.Italic.Select(s => new Span(s.Start, s.Length, s.MarkerLength)));
            line.Strike.AddRange(source.Strike.Select(s => new Span(s.Start, s.Length, s.MarkerLength)));
            return line;
        }).ToArray();
        _foldings = scan.Foldings.Select(f => new NewFolding(f.StartOffset, f.EndOffset)).ToArray();
        _dirty = false;
    }

    internal sealed class LineInfo(string text)
    {
        public string Text { get; } = text;
        public int HeadingLevel { get; init; }
        public int HeadingMarkerLength { get; init; }
        public int CheckboxOffset { get; init; } = -1;
        public bool CheckboxChecked { get; init; }
        public int BulletLength { get; init; }
        public string? FenceMarker { get; init; }
        public string FenceLanguage { get; init; } = string.Empty;
        public bool IsFence { get; set; }
        public bool IsCode { get; set; }
        public bool IsPython { get; set; }
        public bool PythonMarker { get; set; }
        public int CommentOffset { get; set; } = -1;
        public List<Span> Bold { get; } = [];
        public List<Span> Italic { get; } = [];
        public List<Span> Strike { get; } = [];
    }
    internal readonly record struct Span(int Start, int Length, int MarkerLength);
}
internal sealed class MarkdownColorizer(Look look, MarkdownScanner scanner) : DocumentColorizingTransformer
{
    private readonly IBrush _dim = new SolidColorBrush(look.MarkdownMarker), _keyword = new SolidColorBrush(look.Keyword),
        _string = new SolidColorBrush(look.String), _comment = new SolidColorBrush(look.Comment), _accent = new SolidColorBrush(look.Accent);
    private readonly IBrush[] _heading = look.HeadingColors.Select(c => (IBrush)new SolidColorBrush(c)).ToArray();
    private readonly Typeface _codeTypeface = new(new FontFamily(look.CodeFont));
    private static readonly Regex Strings = new("""(?<q>['"])(?:\\.|(?!\k<q>).)*?\k<q>""", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Keywords = new(@"\b(def|class|return|if|elif|else|for|while|in|import|from|as|try|except|with|yield|async|await|True|False|None|pass|break|continue|lambda|and|or|not|is|raise|finally|global|nonlocal|del|assert)\b", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));

    protected override void ColorizeLine(DocumentLine line)
    {
        var info = scanner.GetLine(line.LineNumber); var text = info.Text; var offset = line.Offset;
        if (info.IsCode)
        {
            ChangeLinePart(offset, line.EndOffset, e => e.TextRunProperties.SetTypeface(_codeTypeface));
            if (info.IsFence) { Paint(offset, line.EndOffset, _dim); return; }
            if (!info.IsPython) return;
            if (info.PythonMarker) { Paint(offset, line.EndOffset, _dim); return; }
            var codeEnd = info.CommentOffset < 0 ? text.Length : info.CommentOffset;
            foreach (Match m in Keywords.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _keyword);
            foreach (Match m in Strings.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _string);
            if (info.CommentOffset >= 0) Paint(offset + info.CommentOffset, line.EndOffset, _comment);
            return;
        }
        if (info.HeadingLevel > 0)
        {
            var idx = Math.Clamp(info.HeadingLevel - 1, 0, _heading.Length - 1);
            Paint(offset, line.EndOffset, _heading[idx]);
            Paint(offset, offset + info.HeadingMarkerLength, _dim);
            ChangeLinePart(offset, line.EndOffset, e =>
            {
                var old = e.TextRunProperties.Typeface;
                e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, FontStyle.Normal, info.HeadingLevel <= 2 ? FontWeight.Bold : FontWeight.SemiBold, old.Stretch));
                e.TextRunProperties.SetFontRenderingEmSize(look.HeadingSizes[Math.Clamp(info.HeadingLevel - 1, 0, look.HeadingSizes.Length - 1)]);
            });
            return;
        }
        foreach (var span in info.Bold) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Bold, FontStyle.Normal, null); }
        foreach (var span in info.Italic) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Normal, FontStyle.Italic, null); }
        foreach (var span in info.Strike) Markers(offset + span.Start, span.Length, span.MarkerLength);
        if (info.BulletLength > 0) Paint(offset, offset + info.BulletLength, _accent);
        if (info.CheckboxOffset >= 0) Paint(offset + info.CheckboxOffset, offset + info.CheckboxOffset + 3, Brushes.Transparent);
    }

    private void Markers(int start, int length, int count) { Paint(start, start + count, _dim); Paint(start + length - count, start + length, _dim); }
    private void Paint(int start, int end, IBrush brush) { if (end > start) ChangeLinePart(start, end, e => e.TextRunProperties.SetForegroundBrush(brush)); }
    private void Format(int start, int end, FontWeight weight, FontStyle style, TextDecorationCollection? decorations)
    {
        if (end <= start) return;
        ChangeLinePart(start, end, e => { var old = e.TextRunProperties.Typeface; e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, style, weight, old.Stretch)); if (decorations is not null) e.TextRunProperties.SetTextDecorations(decorations); });
    }
}

internal sealed class CodePanelRenderer(Look look, MarkdownScanner scanner) : IBackgroundRenderer
{
    private readonly IBrush _fill = new SolidColorBrush(look.CodePanel);
    public KnownLayer Layer => KnownLayer.Background;
    public void Draw(TextView textView, DrawingContext dc)
    {
        if (!textView.VisualLinesValid || textView.Document is null) return;
        foreach (var group in scanner.Lines.Select((line, i) => (line, i)).Where(x => x.line.IsCode).GroupAdjacent())
        {
            double top = double.NaN, bottom = 0;
            foreach (var visual in textView.VisualLines)
            {
                var n = visual.FirstDocumentLine.LineNumber - 1;
                if (n < group.Start || n > group.End) continue;
                var y = visual.VisualTop - textView.VerticalOffset;
                if (double.IsNaN(top)) top = y;
                bottom = y + visual.Height;
            }
            if (!double.IsNaN(top)) dc.DrawRectangle(_fill, null, new Rect(look.CodePanelInset, top, Math.Max(0, textView.Bounds.Width - 2 * look.CodePanelInset), bottom - top), look.CodeRadius, look.CodeRadius);
        }
    }
}

internal static class AdjacentGrouping
{
    public static IEnumerable<(int Start, int End)> GroupAdjacent(this IEnumerable<(MarkdownScanner.LineInfo line, int i)> source)
    {
        var start = -1; var end = -1;
        foreach (var item in source)
        {
            if (start < 0) start = end = item.i;
            else if (item.i == end + 1) end = item.i;
            else { yield return (start, end); start = end = item.i; }
        }
        if (start >= 0) yield return (start, end);
    }
}

using System.Diagnostics;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.ApplicationLifetimes;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media;
using Avalonia.Threading;
using AvaloniaEdit;
using AntiQuickPad.Editor;
using AntiQuickPad.ViewModels;
using AntiQuickPad.Shell;
using AntiQuickPad.Carousel;
using System.Text.Json;
using Avalonia.Controls.Primitives;
namespace AntiQuickPad.Views.Common;

public sealed partial class ResidentShellWindow : Window, IShellView
{
    private TextEditor _editor = null!;
    private readonly MainViewModel _vm;
    private readonly ShellServices _services;
    private readonly IWindowPlatform _platform;
    public Window Host => this;
    public TextEditor Editor => _editor;
    public MainViewModel ViewModel => _vm;
    private CarouselController _carousel = null!;
    private readonly Dictionary<string, Vector> _scroll = new();
    private readonly TextBlock _count = new();
    private readonly ToggleButton _pin = new() { Content = "Pin" };
    
    private WindowSnapshot? _normalSettings;
    private readonly DispatcherTimer _autosave = new() { Interval = TimeSpan.FromMilliseconds(350) };
    private readonly DispatcherTimer _cue = new() { Interval = TimeSpan.FromMilliseconds(130) };
    private readonly Border _frame = new();
    private readonly TextBlock _status = new();
    private readonly StreamWriter _log;
    private ITrayService? _tray;
    private IHotkeyService? _hotkey;
    private bool _binding, _quitting, _initialized, _saveFailed;
    private string? _lastSaveError;
    private string? _departingId;
    private long _showStarted;
    private string _quitSource = "tray";
    private string _showSource = "startup";
    private TaskCompletionSource<double>? _focusCompletion;
    public double LastShowToFocusMs { get; private set; }

    public ResidentShellWindow(MainViewModel viewModel, ShellServices services, string shellId = "quiet")
    {
        _vm = viewModel; _services = services; _platform = services.CreateWindowPlatform(this);
        DataContext = _vm;
        Title = "AntiQuickPad"; Width = 960; Height = 800; MinWidth = 600; MinHeight = 480;
        WindowStartupLocation = WindowStartupLocation.CenterScreen;
        WindowDecorations = WindowDecorations.BorderOnly;
        ExtendClientAreaToDecorationsHint = true;
        ExtendClientAreaTitleBarHeightHint = 58;
        RestoreWindowSnapshot();
        _shellId = shellId;
        _theme = new ThemeService(this, _vm.LookId);
        _theme.Changed += (_, _) => RebuildAppearance();
        Directory.CreateDirectory(Path.GetDirectoryName(Program.Paths.Log)!);
        _log = new StreamWriter(new FileStream(Program.Paths.Log, FileMode.Append, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
        RebuildAppearance();
        _vm.Navigating += (_, e) => { _carousel.Cancel(); e.Cancel = !SaveNotes(); if (!e.Cancel) { RememberScroll(); _departingId = _vm.Current.Id; } };
        _vm.Navigated += (_, e) => { _menu.IsVisible = false; if (e.Kind == "delete" && _departingId is not null) _scroll.Remove(_departingId); BindCurrent(); if (e.Kind != "delete") SaveNotes(); FocusEditor(); };
        _vm.OperationFailed += (_, ex) => { UpdateStatus(); Log($"note-operation-error {ex}"); };
        _vm.PropertyChanged += (_, e) => { if (e.PropertyName == nameof(MainViewModel.Pinned)) SetPinned(_vm.Pinned); UpdateStatus(); };
        _vm.Status.PropertyChanged += (_, _) => UpdateStatus();
        BindCurrent();



        _autosave.Tick += (_, _) => SaveNotes();
        _cue.Tick += (_, _) => { _cue.Stop(); _frame.BorderBrush = new SolidColorBrush(CurrentLook.Muted); };
        AddHandler(KeyDownEvent, OnKeyDown, RoutingStrategies.Tunnel, true);
        Opened += (_, _) => InitializeResident();
        SizeChanged += (_, _) => RememberNormalBounds();
        PositionChanged += (_, _) => RememberNormalBounds();
        Activated += (_, _) => Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        Closing += (_, e) => { if (!_quitting) { e.Cancel = true; HideResident(); } };
        Deactivated += (_, _) => _carousel.Cancel();
        Closed += (_, _) => { _carousel.Cancel(); _autosave.Stop(); _cue.Stop(); _hotkey?.Dispose(); _tray?.Dispose(); _theme.Dispose(); if (_quitting) Log($"quit-finish window-closed=true source={_quitSource}"); _log.Dispose(); };
    }

    private void InitializeResident()
    {
        if (_initialized) return;
        _initialized = true;
        // The selftest does not claim the real hotkey or affect an existing resident app.
        if (!Program.SelfTest && !Program.QuitResidentTest && !ShellRender.IsRendering)
        {
            InstallHotkey();
            SetupTray();
        }
        _showStarted = Stopwatch.GetTimestamp();
        if (Measurement.IsChild) Measurement.Attach(this, _hotkey?.IsRegistered == true, RenderScaling);
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        if (Program.QuitResidentTest)
        {
            _editor.Text = "command quit saves this pending edit";
            Hide();
            File.WriteAllText(Path.Combine(Program.Paths.Root, "ready"), "ready");
        }
        if (Program.SelfTest) Dispatcher.UIThread.Post(async () => await RunSelfTest(), DispatcherPriority.Background);
    }

    private void InstallHotkey()
    {
        try
        {
            _hotkey = _services.CreateHotkey(this, timestamp => Toggle(timestamp));
            Log($"hotkey gesture={_hotkey.GestureLabel} registered={_hotkey.IsRegistered} error={_hotkey.RegistrationError} {_hotkey.RegistrationErrorMessage}");
        }
        catch (FormatException ex) { Log($"hotkey-configuration-error {ex.Message}"); }
    }

    public void Toggle(long started = 0)
    {
        Measurement.Event("hotkey", started);
        if (IsVisible) HideResident(); else ShowResident("toggle", started);
    }

    public void ShowResident(string source, long started = 0)
    {
        _showStarted = started == 0 ? Stopwatch.GetTimestamp() : started; _showSource = source;
        _platform.Show(); _platform.Activate();
        Measurement.Frame(this);
        _frame.BorderBrush = new SolidColorBrush(CurrentLook.Accent); _cue.Stop(); _cue.Start();
        FocusEditor();
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
    }

    public void HideResident()
    {
        _carousel.Cancel();
        if (!SaveNotes()) return;
        _showStarted = 0; _platform.Hide(); Measurement.Event("hidden"); Log("hidden resident=true");
    }

    private void FocusEditor()
    {
        if (!IsVisible) return;
        _platform.Activate(); _editor.TextArea.Focus(); CompleteFocus();
    }

    private void CompleteFocus()
    {
        if (_showStarted == 0 || !IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) return;
        if (Measurement.IsChild && (!IsActive || !Measurement.IsForeground(this))) return;
        Measurement.Event("focused");
        LastShowToFocusMs = Stopwatch.GetElapsedTime(_showStarted).TotalMilliseconds;
        _showStarted = 0;
        Log($"show-to-focus source={_showSource} ms={LastShowToFocusMs:F3} focused=true");
        _focusCompletion?.TrySetResult(LastShowToFocusMs);
    }

    private void ScheduleSave()
    {
        if (_binding) return;
        _vm.UpdateCurrent(_editor.Text, _editor.CaretOffset);
        UpdateStatus();
        _autosave.Stop(); _autosave.Start();
    }

    private bool SaveNotes()
    {
        _autosave.Stop();
        try
        {
            _vm.UpdateCurrent(_editor.Text, _editor.CaretOffset); _vm.Save(); SaveWindowSnapshot();
            _saveFailed = false; _lastSaveError = null; UpdateStatus(); return true;
        }
        catch (Exception ex)
        {
            _vm.Fail(ex); _saveFailed = true; _lastSaveError = ex.Message; UpdateStatus(); Log($"save-error {ex}"); return false;
        }
    }

    private void BindCurrent()
    {
        _binding = true;
        try { _editor.Text = _vm.Current.Text; _editor.CaretOffset = _vm.Current.CaretOffset; _editor.Document.UndoStack.ClearAll(); }
        finally { _binding = false; }
        var scroll = _scroll.GetValueOrDefault(_vm.Current.Id);
        EditorViewport.Restore(_editor, scroll);
        UpdateStatus();
    }

    private void RememberScroll() => _scroll[_vm.Current.Id] = _editor.TextArea.TextView.ScrollOffset;
    public void CreateNote() => _vm.CreateNote();
    public void DeleteCurrentNote() => _vm.DeleteCurrent();
    public void SelectNote(int index) => _vm.Select(index);
    private void ShowIndicator() => _count.Opacity = 1;
    private void UpdateStatus()
    {
        _count.Text = _vm.CountText;
        _saveFailed = _vm.Status.Failed;
        _status.Foreground = new SolidColorBrush(_saveFailed ? CurrentLook.Accent : CurrentLook.Muted);
        _status.Text = _vm.Status.Text; UpdateShellStatus();
    }

    private void RestoreWindowSnapshot()
    {
        try
        {
            var settings = _vm.LoadSettings();
            if (settings is null || !double.IsFinite(settings.Width) || !double.IsFinite(settings.Height)) return;
            _platform.Bounds = new WindowBounds(Math.Max(MinWidth, settings.Width), Math.Max(MinHeight, settings.Height), settings.X, settings.Y); WindowStartupLocation = WindowStartupLocation.Manual;
            _platform.Pinned = settings.Pinned; _vm.Pinned = settings.Pinned;
        }
        catch (Exception ex) { System.Diagnostics.Trace.WriteLine($"window-settings-load: {ex.Message}"); }
    }
    private void RememberNormalBounds()
    {
        if (_initialized && WindowState == WindowState.Normal && IsVisible)
            _normalSettings = new WindowSnapshot(Width, Height, Position.X, Position.Y, Topmost, _vm.ShellId, _vm.LookId);
    }
    private void SaveWindowSnapshot()
    {
        RememberNormalBounds();
        var settings = (_normalSettings ?? new WindowSnapshot(Width, Height, Position.X, Position.Y, Topmost, _vm.ShellId, _vm.LookId)) with { Pinned = Topmost, ShellId = _shellId, LookId = _theme.Preference };
        _vm.SaveSettings(settings);
    }
    private void SetPinned(bool pinned)
    {
        _platform.Pinned = pinned; _pin.IsChecked = pinned;
        try { SaveWindowSnapshot(); }
        catch (Exception ex) { Log($"window-settings-save-error {ex}"); }
    }

    public void Quit(int exitCode = 0, string source = "tray")
    {
        _quitSource = source;
        Log($"quit-start source={source}");
        _carousel.Cancel();
        if (!SaveNotes())
        {
            Log($"quit-aborted save-failed reason={_lastSaveError}");
            if (source != "command") ShowResident("quit-save-failed");
            UpdateStatus();
            return;
        }
        _quitting = true; Close();
        (Application.Current!.ApplicationLifetime as IClassicDesktopStyleApplicationLifetime)!.Shutdown(exitCode);
    }

    private void OnKeyDown(object? sender, KeyEventArgs e)
    {
        if (e.Key == Key.Escape) { if (_menu.IsVisible) { _menu.IsVisible = false; FocusEditor(); } else HideResident(); e.Handled = true; }
        else if (e.Key == Key.N && e.KeyModifiers == KeyModifiers.Control) { CreateNote(); e.Handled = true; }
        else if (e.Key == Key.Delete && e.KeyModifiers == (KeyModifiers.Control | KeyModifiers.Shift)) { DeleteCurrentNote(); e.Handled = true; }
    }

    private void SetupTray()
    {
        _tray = _services.CreateTray();
        var hotkeyStatus = _hotkey is { IsRegistered: true } ? _hotkey.GestureLabel : "hotkey unavailable; see log";
        _tray.Initialize(() => Toggle(), () => Quit(), () => ShowResident("tray"), hotkeyStatus);
    }

    private void Log(string message) => _log.WriteLine($"{DateTimeOffset.UtcNow:O} {message}");

    public void MeasurementHeavy()
    {
        _vm.PopulateMeasurementFixture(); BindCurrent(); SaveNotes();
    }
}


