using System.Globalization;
using System.Text.RegularExpressions;
using Avalonia;
using Avalonia.Controls;
using Path = Avalonia.Controls.Shapes.Path;
using Avalonia.Input;
using Avalonia.Layout;
using Avalonia.Media;
using AvaloniaEdit;
using AvaloniaEdit.Document;
using AvaloniaEdit.Editing;
using AvaloniaEdit.Folding;
using AvaloniaEdit.Rendering;

namespace AntiQuickPad.Editor;

/// <summary>Builds the Markdown-aware editor and keeps each document's parsed line map shared by every renderer.</summary>
internal static class EditorFactory
{
    public static TextEditor Create(Look look)
    {
        var editor = new TextEditor
        {
            FontFamily = new FontFamily(look.EditorFont), FontSize = look.FontSize,
            Background = new SolidColorBrush(look.Background), Foreground = new SolidColorBrush(look.Foreground),
            LineNumbersForeground = new SolidColorBrush(look.Muted), ShowLineNumbers = look.ShowGutter,
            WordWrap = true, Padding = new Thickness(look.EditorPadding),
            HorizontalScrollBarVisibility = Avalonia.Controls.Primitives.ScrollBarVisibility.Disabled,
            VerticalScrollBarVisibility = Avalonia.Controls.Primitives.ScrollBarVisibility.Auto
        };
        var scan = new MarkdownScanner(editor.Document);
        editor.TextArea.TextView.LineTransformers.Add(new MarkdownColorizer(look, scan));
        editor.TextArea.TextView.BackgroundRenderers.Add(new CodePanelRenderer(look, scan));
        editor.TextArea.TextView.ElementGenerators.Add(new CheckboxGenerator(look, scan, editor));
        editor.Document.Changed += (_, _) => editor.TextArea.TextView.Redraw();
        editor.AddHandler(InputElement.PointerMovedEvent, (_, e) => UpdateCursor(editor, scan, e.GetPosition(editor.TextArea.TextView)), Avalonia.Interactivity.RoutingStrategies.Tunnel, true);
        editor.PointerExited += (_, _) => SetHandCursor(editor, false);
        editor.TextArea.TextView.PointerExited += (_, _) => SetHandCursor(editor, false);
        editor.AddHandler(InputElement.KeyDownEvent, (_, e) => ApplyKey(editor, scan, e), Avalonia.Interactivity.RoutingStrategies.Tunnel, true);

        if (look.ShowFolding)
        {
            var folding = FoldingManager.Install(editor.TextArea);
            foreach (var margin in editor.TextArea.LeftMargins.OfType<FoldingMargin>())
                margin.SetValue(FoldingMargin.FoldingMarkerBrushProperty, new SolidColorBrush(look.Accent));
            void UpdateFoldings()
            {
                var folds = scan.GetFoldings().ToList();
                folding.UpdateFoldings(folds, -1);
            }
            UpdateFoldings();
            editor.Document.Changed += (_, _) => UpdateFoldings();
        }
        return editor;
    }

    /// <summary>Small deterministic M3 smoke checks, called by the app selftest.</summary>
    public static void RunSmoke()
    {
        var fixture = "# Heading\n**bold** *italic* ~~gone~~\n    - [ ] task\n```python\ndef f(): # comment\n    return 'ok'\n```\n";
        var document = new TextDocument(fixture);
        var scanner = new MarkdownScanner(document);
        var lines = scanner.Lines;
        if (lines[0].HeadingLevel != 1 || lines[1].Bold.Count != 1 || lines[1].Italic.Count != 1 || lines[1].Strike.Count != 1 ||
            lines[2].CheckboxOffset < 0 || !lines[4].IsPython || lines[4].CommentOffset < 0 || scanner.GetFoldings().Count < 2)
            throw new InvalidOperationException("Markdown scanner fixture classification failed.");
        var sections = new TextDocument("# One\nbody\n\n\noutside\n# Two\nbody\n## Child\nchild\n# Three\nend");
        var sectionFolds = new MarkdownScanner(sections).GetFoldings();
        if (sectionFolds[0].EndOffset != sections.GetLineByNumber(2).EndOffset ||
            sectionFolds[1].EndOffset != sections.GetLineByNumber(9).EndOffset ||
            sectionFolds[2].EndOffset != sections.GetLineByNumber(9).EndOffset)
            throw new InvalidOperationException("Heading blank-pair / next-heading boundary failed.");
        var nested = new TextDocument("# Section\n```\na\n\n\nb\n```\ntail\n\n\noutside");
        var nestedFolds = new MarkdownScanner(nested).GetFoldings();
        if (nestedFolds.Count != 2 || nestedFolds[0].EndOffset != nested.GetLineByNumber(8).EndOffset ||
            nestedFolds[1].EndOffset != nested.GetLineByNumber(6).EndOffset)
            throw new InvalidOperationException("Independent fence folding failed.");
        foreach (var (input, expected) in new (string, string)[]
        {
            ("- text", "- text\n- "), ("  - text", "  - text\n  - "), ("\t* text", "\t* text\n\t* "),
            ("- [ ] x", "- [ ] x\n- [ ] "), ("- [x] x", "- [x] x\n- [ ] "),
            ("1. text", "1. text\n2. "), ("9. text", "9. text\n10. "),
            ("- ", ""), ("* ", ""), ("1. ", ""), ("  - [ ] ", "  "), ("- [x] ", "")
        })
        {
            var list = new TextDocument(input);
            var newCaret = EditorOperations.ContinueList(list, list.TextLength);
            if (newCaret != list.TextLength || list.Text.Replace("\r\n", "\n") != expected)
                throw new InvalidOperationException($"List Enter failed for '{input}'.");
            list.UndoStack.Undo();
            if (list.Text != input || list.UndoStack.CanUndo) throw new InvalidOperationException("List Enter was not one undo step.");
        }
        var checkbox = document.GetLineByNumber(3).Offset + lines[2].CheckboxOffset;
        var caret = document.TextLength;
        if (EditorOperations.ToggleCheckbox(document, checkbox, ref caret) != "[x]" || document.GetText(checkbox, 3) != "[x]" || !document.UndoStack.CanUndo)
            throw new InvalidOperationException("Checkbox toggle was not an undoable text edit.");
        document.UndoStack.Undo();
        var taskLine = document.GetLineByNumber(3);
        var result = EditorOperations.ApplyTab(document, checkbox, null, null, outdent: true);
        if (!result.Changed || document.GetText(taskLine.Offset, 5) != "- [ ]")
            throw new InvalidOperationException("Shift+Tab outdent smoke failed.");
        var selected = new TextDocument("    one\n    two");
        EditorOperations.ApplyTab(selected, selected.TextLength, 0, selected.TextLength, true);
        if (selected.Text != "one\ntwo") throw new InvalidOperationException("Selection outdent failed.");
        var typed = new MarkdownScanner(new TextDocument("python:\nreturn '# string' # comment"));
        var fenced = new MarkdownScanner(new TextDocument("```\npython:\nreturn 1\n```"));
        if (!typed.Lines[1].IsPython || typed.Lines[1].CommentOffset != 18 || !fenced.Lines[2].IsPython)
            throw new InvalidOperationException("Python language marker classification failed.");
    }

    private static void ApplyKey(TextEditor editor, MarkdownScanner scanner, KeyEventArgs e)
    {
        if (e.Key == Key.Enter && e.KeyModifiers == KeyModifiers.None && !editor.IsReadOnly && editor.SelectionLength == 0 &&
            !scanner.GetLine(editor.Document.GetLineByOffset(editor.CaretOffset).LineNumber).IsCode &&
            EditorOperations.ContinueList(editor.Document, editor.CaretOffset) is int caret)
        {
            editor.CaretOffset = caret;
            e.Handled = true;
            return;
        }
        if (e.Key != Key.Tab || editor.IsReadOnly) return;
        var selection = editor.TextArea.Selection.SurroundingSegment;
        var result = EditorOperations.ApplyTab(editor.Document, editor.CaretOffset, selection?.Offset, selection?.EndOffset,
            e.KeyModifiers.HasFlag(KeyModifiers.Shift));
        if (result.SelectionStart is int start && result.SelectionEnd is int end && end != start)
            editor.TextArea.Selection = Selection.Create(editor.TextArea, start, end);
        editor.CaretOffset = result.CaretOffset;
        e.Handled = true;
    }

    private static bool TryCheckboxAt(TextEditor editor, MarkdownScanner scan, Point point, out int markerOffset)
    {
        markerOffset = -1;
        var view = editor.TextArea.TextView;
        var position = view.GetPosition(point + view.ScrollOffset);
        if (position is null) return false;
        var line = editor.Document.GetLineByNumber(position.Value.Location.Line);
        var info = scan.GetLine(line.LineNumber);
        if (info.CheckboxOffset < 0) return false;
        var charOffset = editor.Document.GetOffset(position.Value.Location);
        markerOffset = line.Offset + info.CheckboxOffset;
        return charOffset >= markerOffset && charOffset < markerOffset + 3;
    }

    private static void UpdateCursor(TextEditor editor, MarkdownScanner scan, Point point) => SetHandCursor(editor, TryCheckboxAt(editor, scan, point, out _));
    private static void SetHandCursor(TextEditor editor, bool hand)
    {
        var cursor = new Cursor(hand ? StandardCursorType.Hand : StandardCursorType.Ibeam);
        editor.Cursor = cursor; editor.TextArea.Cursor = cursor; editor.TextArea.TextView.Cursor = cursor;
        ToolTip.SetTip(editor.TextArea.TextView, hand ? "Toggle task checkbox" : null);
    }
}

/// <summary>Pure document operations shared by input handlers and smoke checks.</summary>
internal static class EditorOperations
{
    internal readonly record struct TabResult(int CaretOffset, int? SelectionStart, int? SelectionEnd, bool Changed);

    public static string? ToggleCheckbox(TextDocument document, int markerOffset, ref int caretOffset)
    {
        if (markerOffset < 0 || markerOffset + 3 > document.TextLength) return null;
        var token = document.GetText(markerOffset, 3);
        var replacement = token == "[ ]" ? "[x]" : token.Equals("[x]", StringComparison.OrdinalIgnoreCase) ? "[ ]" : null;
        if (replacement is null) return null;
        document.Replace(markerOffset, 3, replacement);
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        return replacement;
    }

    public static TabResult ApplyTab(TextDocument document, int caretOffset, int? selectionStart, int? selectionEnd, bool outdent)
    {
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        if (selectionStart is null || selectionEnd is null || selectionStart == selectionEnd)
        {
            var line = document.GetLineByOffset(caretOffset);
            if (!outdent) { document.Insert(caretOffset, "    "); return new(caretOffset + 4, null, null, true); }
            var prefix = document.GetText(line.Offset, Math.Min(4, line.Length));
            var remove = prefix.StartsWith('\t') ? 1 : prefix.TakeWhile(c => c == ' ').Count();
            if (remove == 0) return new(caretOffset, null, null, false);
            document.Remove(line.Offset, remove);
            return new(MapRemove(caretOffset, line.Offset, remove), null, null, true);
        }

        var start = Math.Clamp(Math.Min(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var end = Math.Clamp(Math.Max(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var first = document.GetLineByOffset(start); var last = document.GetLineByOffset(Math.Max(start, end - 1));
        var lineNumbers = Enumerable.Range(first.LineNumber, last.LineNumber - first.LineNumber + 1);
        var caret = caretOffset; var a = selectionStart.Value; var b = selectionEnd.Value; var changed = false;
        document.BeginUpdate();
        try
        {
            foreach (var number in lineNumbers.Reverse())
            {
                var line = document.GetLineByNumber(number);
                if (!outdent)
                {
                    document.Insert(line.Offset, "    "); caret = MapInsert(caret, line.Offset, 4); a = MapInsert(a, line.Offset, 4); b = MapInsert(b, line.Offset, 4); changed = true;
                }
                else
                {
                    var p = document.GetText(line.Offset, Math.Min(4, line.Length));
                    var count = p.StartsWith('\t') ? 1 : p.TakeWhile(c => c == ' ').Count();
                    if (count == 0) continue;
                    document.Remove(line.Offset, count); caret = MapRemove(caret, line.Offset, count); a = MapRemove(a, line.Offset, count); b = MapRemove(b, line.Offset, count); changed = true;
                }
            }
        }
        finally { document.EndUpdate(); }
        return new(caret, a, b, changed);
    }

    // One replace operation gives continuation/exit its own single undo step.
    public static int? ContinueList(TextDocument document, int caretOffset)
    {
        var line = document.GetLineByOffset(caretOffset);
        var prefix = document.GetText(line.Offset, caretOffset - line.Offset);
        var match = Regex.Match(prefix, @"^(?<indent>[ \t]*)(?<bullet>[-*+]|[0-9]+[.)])(?:[ \t]+(?<task>\[[ xX]\])(?:[ \t]+|$)|[ \t]+)(?<text>.*)$");
        if (!match.Success) return null;
        var indent = match.Groups["indent"].Value;
        var rest = document.GetText(caretOffset, line.EndOffset - caretOffset);
        string replacement;
        int start, length;
        if (string.IsNullOrWhiteSpace(match.Groups["text"].Value + rest))
        {
            start = line.Offset; length = line.Length; replacement = indent;
        }
        else
        {
            var bullet = match.Groups["bullet"].Value;
            if (char.IsDigit(bullet[0]))
            {
                if (!long.TryParse(bullet[..^1], out var number) || number == long.MaxValue) return null;
                bullet = (number + 1).ToString(CultureInfo.InvariantCulture) + bullet[^1];
            }
            var newline = line.DelimiterLength > 0 ? document.GetText(line.EndOffset, line.DelimiterLength)
                : document.Lines.FirstOrDefault(l => l.DelimiterLength > 0) is { } other
                    ? document.GetText(other.EndOffset, other.DelimiterLength) : Environment.NewLine;
            start = caretOffset; length = 0;
            replacement = newline + indent + bullet + " " + (match.Groups["task"].Success ? "[ ] " : "");
        }
        document.BeginUpdate();
        try { document.Replace(start, length, replacement); }
        finally { document.EndUpdate(); }
        return start + replacement.Length;
    }

    private static int MapInsert(int p, int at, int length) => p >= at ? p + length : p;
    private static int MapRemove(int p, int at, int length) => p >= at + length ? p - length : p >= at ? at : p;
}

/// <summary>Cached parsed metadata. A single rebuild supplies syntax, folds, panels and checkbox hit testing.</summary>
internal sealed class MarkdownScanner
{
    private static readonly Regex Heading = new(@"^(?<indent> {0,3})(?<hash>#{1,6})(?:[ \t]+|$)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Task = new(@"^\s*[-*+]\s+\[(?<mark>[ xX])\]", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Bullet = new(@"^\s*(?:[-*+]|\d+[.)])\s+", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex FenceOpen = new(@"^\s*(`{3,}|~{3,})\s*(?<lang>[^\s`]*)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex BoldPattern = new(@"\*\*[^*\r\n].*?\*\*|__[^_\r\n].*?__", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex ItalicPattern = new(@"(?<!\*)\*(?!\*)[^*\r\n].*?\*(?!\*)|(?<!_)_(?!_)[^_\r\n].*?_(?!_)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex StrikePattern = new(@"~~[^~\r\n].*?~~", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private readonly TextDocument _document;
    private bool _dirty = true;
    private LineInfo[] _lines = [];
    private NewFolding[] _foldings = [];
    public IReadOnlyList<LineInfo> Lines { get { Ensure(); return _lines; } }
    public MarkdownScanner(TextDocument document) { _document = document; document.Changed += (_, _) => _dirty = true; }
    public LineInfo GetLine(int number) { Ensure(); return _lines[Math.Clamp(number - 1, 0, _lines.Length - 1)]; }
    public IReadOnlyList<NewFolding> GetFoldings() { Ensure(); return _foldings; }

    private void Ensure()
    {
        if (!_dirty) return;
        var count = _document.LineCount;
        var lines = new LineInfo[count];
        for (var i = 0; i < count; i++)
        {
            var line = _document.GetLineByNumber(i + 1); var text = _document.GetText(line); var headingMatch = Heading.Match(text);
            var headingLevel = headingMatch.Success ? headingMatch.Groups["hash"].Length : 0;
            var taskMatch = Task.Match(text); var fenceMatch = FenceOpen.Match(text);
            var info = new LineInfo(text)
            {
                HeadingLevel = headingLevel,
                HeadingMarkerLength = headingMatch.Success ? headingMatch.Groups["indent"].Length + headingLevel : 0,
                CheckboxOffset = taskMatch.Success ? taskMatch.Groups["mark"].Index - 1 : -1,
                CheckboxChecked = taskMatch.Success && taskMatch.Groups["mark"].Value is "x" or "X",
                BulletLength = Bullet.Match(text) is { Success: true } bullet ? bullet.Length : 0,
                FenceMarker = fenceMatch.Success ? fenceMatch.Groups[1].Value : null,
                FenceLanguage = fenceMatch.Success ? fenceMatch.Groups["lang"].Value : string.Empty
            };
            info.Bold.AddRange(BoldPattern.Matches(text).Select(m => new Span(m.Index, m.Length, 2)));
            info.Italic.AddRange(ItalicPattern.Matches(text).Select(m => new Span(m.Index, m.Length, 1)));
            info.Strike.AddRange(StrikePattern.Matches(text).Select(m => new Span(m.Index, m.Length, 2)));
            lines[i] = info;
        }

        var folds = new List<NewFolding>();
        var openFence = -1; var fenceChar = '\0'; var fenceLen = 0; var pythonFence = false; var firstPython = lines.Length > 0 && lines[0].Text.TrimStart().StartsWith("python:", StringComparison.OrdinalIgnoreCase);
        for (var i = 0; i < lines.Length; i++)
        {
            var info = lines[i];
            if (firstPython && i == 0) { info.PythonMarker = true; info.IsCode = true; info.IsPython = true; continue; }
            if (info.FenceMarker is string marker)
            {
                if (openFence < 0)
                {
                    openFence = i; fenceChar = marker[0]; fenceLen = marker.Length;
                    pythonFence = info.FenceLanguage.Equals("python", StringComparison.OrdinalIgnoreCase) || info.FenceLanguage.Equals("py", StringComparison.OrdinalIgnoreCase);
                    info.IsFence = true; info.IsCode = true; info.IsPython = pythonFence;
                }
                else if (marker[0] == fenceChar && marker.Length >= fenceLen)
                {
                    info.IsFence = true; info.IsCode = true; info.IsPython = pythonFence;
                    if (i > openFence + 1) folds.Add(Fold(_document, openFence, i - 1));
                    openFence = -1; pythonFence = false;
                }
                else { info.IsCode = openFence >= 0; info.IsPython = pythonFence; }
                continue;
            }
            if (openFence >= 0 && i == openFence + 1 && lines[openFence].FenceLanguage.Length == 0 &&
                info.Text.Trim().Equals("python:", StringComparison.OrdinalIgnoreCase))
            {
                pythonFence = true; info.PythonMarker = true;
            }
            info.IsCode = openFence >= 0;
            info.IsPython = pythonFence;
            if (firstPython && i > 0) { info.IsCode = true; info.IsPython = true; }
        }

        for (var i = 0; i < lines.Length; i++)
            if (lines[i].IsPython && !lines[i].IsFence && !lines[i].PythonMarker)
                lines[i].CommentOffset = FindComment(lines[i].Text);
        if (openFence >= 0)
        {
            for (var i = openFence + 1; i < lines.Length; i++) { lines[i].IsCode = true; lines[i].IsPython = pythonFence; }
            if (lines.Length > openFence + 1) folds.Add(Fold(_document, openFence, lines.Length - 1));
        }

        // Blank pairs outside code also end a heading section; fence folding remains independent.
        var headings = Enumerable.Range(0, lines.Length).Where(i => lines[i].HeadingLevel > 0 && !lines[i].IsCode).ToArray();
        for (var h = 0; h < headings.Length; h++)
        {
            var start = headings[h]; var end = lines.Length - 1;
            for (var j = h + 1; j < headings.Length; j++) if (lines[headings[j]].HeadingLevel <= lines[start].HeadingLevel) { end = headings[j] - 1; break; }
            for (var j = start + 1; j < end; j++)
                if (!lines[j].IsCode && !lines[j + 1].IsCode && string.IsNullOrWhiteSpace(lines[j].Text) && string.IsNullOrWhiteSpace(lines[j + 1].Text))
                { end = j - 1; break; }
            if (end > start) folds.Add(Fold(_document, start, end));
        }

        if (firstPython)
        {
            var end = lines.Length - 1;
            if (end > 0) folds.Add(Fold(_document, 0, end));
        }
        _lines = lines; _foldings = folds.OrderBy(f => f.StartOffset).ToArray(); _dirty = false;
    }

    private static int FindComment(string text)
    {
        char quote = '\0'; var escaped = false;
        for (var i = 0; i < text.Length; i++)
        {
            var c = text[i];
            if (escaped) { escaped = false; continue; }
            if (c == '\\' && quote != '\0') { escaped = true; continue; }
            if (quote != '\0') { if (c == quote) quote = '\0'; continue; }
            if (c is '\'' or '"') { quote = c; continue; }
            if (c == '#') return i;
        }
        return -1;
    }

    private static NewFolding Fold(TextDocument doc, int startLine, int endLine) => new(doc.GetLineByNumber(startLine + 1).EndOffset, doc.GetLineByNumber(endLine + 1).EndOffset);
    internal sealed class LineInfo(string text)
    {
        public string Text { get; } = text;
        public int HeadingLevel { get; init; }
        public int HeadingMarkerLength { get; init; }
        public int CheckboxOffset { get; init; } = -1;
        public bool CheckboxChecked { get; init; }
        public int BulletLength { get; init; }
        public string? FenceMarker { get; init; }
        public string FenceLanguage { get; init; } = string.Empty;
        public bool IsFence { get; set; }
        public bool IsCode { get; set; }
        public bool IsPython { get; set; }
        public bool PythonMarker { get; set; }
        public int CommentOffset { get; set; } = -1;
        public List<Span> Bold { get; } = [];
        public List<Span> Italic { get; } = [];
        public List<Span> Strike { get; } = [];
    }
    internal readonly record struct Span(int Start, int Length, int MarkerLength);
}

internal sealed class MarkdownColorizer(Look look, MarkdownScanner scanner) : DocumentColorizingTransformer
{
    private readonly IBrush _dim = new SolidColorBrush(look.MarkdownMarker), _keyword = new SolidColorBrush(look.Keyword),
        _string = new SolidColorBrush(look.String), _comment = new SolidColorBrush(look.Comment), _accent = new SolidColorBrush(look.Accent);
    private readonly IBrush[] _heading = look.HeadingColors.Select(c => (IBrush)new SolidColorBrush(c)).ToArray();
    private readonly TextDecorationCollection _strike = new()
    {
        new TextDecoration
        {
            Location = TextDecorationLocation.Strikethrough,
            StrokeThickness = look.StrikeThicknessEm, StrokeThicknessUnit = TextDecorationUnit.FontRenderingEmSize
        }
    };
    private readonly Typeface _codeTypeface = new(new FontFamily(look.CodeFont));
    private static readonly Regex Strings = new("""(?<q>['"])(?:\\.|(?!\k<q>).)*?\k<q>""", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Keywords = new(@"\b(def|class|return|if|elif|else|for|while|in|import|from|as|try|except|with|yield|async|await|True|False|None|pass|break|continue|lambda|and|or|not|is|raise|finally|global|nonlocal|del|assert)\b", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));

    protected override void ColorizeLine(DocumentLine line)
    {
        var info = scanner.GetLine(line.LineNumber); var text = info.Text; var offset = line.Offset;
        if (info.IsCode)
        {
            ChangeLinePart(offset, line.EndOffset, e => e.TextRunProperties.SetTypeface(_codeTypeface));
            if (info.IsFence) { Paint(offset, line.EndOffset, _dim); return; }
            if (!info.IsPython) return;
            if (info.PythonMarker) { Paint(offset, line.EndOffset, _dim); return; }
            var codeEnd = info.CommentOffset < 0 ? text.Length : info.CommentOffset;
            foreach (Match m in Keywords.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _keyword);
            foreach (Match m in Strings.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _string);
            if (info.CommentOffset >= 0) Paint(offset + info.CommentOffset, line.EndOffset, _comment);
            return;
        }
        if (info.HeadingLevel > 0)
        {
            var idx = Math.Clamp(info.HeadingLevel - 1, 0, _heading.Length - 1);
            Paint(offset, line.EndOffset, _heading[idx]);
            Paint(offset, offset + info.HeadingMarkerLength, _dim);
            ChangeLinePart(offset, line.EndOffset, e =>
            {
                var old = e.TextRunProperties.Typeface;
                e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, FontStyle.Normal, info.HeadingLevel <= 2 ? FontWeight.Bold : FontWeight.SemiBold, old.Stretch));
                e.TextRunProperties.SetFontRenderingEmSize(look.HeadingSizes[Math.Clamp(info.HeadingLevel - 1, 0, look.HeadingSizes.Length - 1)]);
            });
            return;
        }
        foreach (var span in info.Bold) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Bold, FontStyle.Normal, null); }
        foreach (var span in info.Italic) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Normal, FontStyle.Italic, null); }
        foreach (var span in info.Strike) { Markers(offset + span.Start, span.Length, span.MarkerLength); ChangeLinePart(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength,
            e => e.TextRunProperties.SetTextDecorations(_strike)); }
        if (info.BulletLength > 0) Paint(offset, offset + info.BulletLength, _accent);
        if (info.CheckboxOffset >= 0) Paint(offset + info.CheckboxOffset, offset + info.CheckboxOffset + 3, _accent);
    }

    private void Markers(int start, int length, int count) { Paint(start, start + count, _dim); Paint(start + length - count, start + length, _dim); }
    private void Paint(int start, int end, IBrush brush) { if (end > start) ChangeLinePart(start, end, e => e.TextRunProperties.SetForegroundBrush(brush)); }
    private void Format(int start, int end, FontWeight weight, FontStyle style, TextDecorationCollection? decorations)
    {
        if (end <= start) return;
        ChangeLinePart(start, end, e => { var old = e.TextRunProperties.Typeface; e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, style, weight, old.Stretch)); if (decorations is not null) e.TextRunProperties.SetTextDecorations(decorations); });
    }
}

internal sealed class CodePanelRenderer(Look look, MarkdownScanner scanner) : IBackgroundRenderer
{
    private readonly IBrush _fill = new SolidColorBrush(look.CodePanel);
    public KnownLayer Layer => KnownLayer.Background;
    public void Draw(TextView textView, DrawingContext dc)
    {
        if (!textView.VisualLinesValid || textView.Document is null) return;
        foreach (var group in scanner.Lines.Select((line, i) => (line, i)).Where(x => x.line.IsCode).GroupAdjacent())
        {
            double top = double.NaN, bottom = 0;
            foreach (var visual in textView.VisualLines)
            {
                var n = visual.FirstDocumentLine.LineNumber - 1;
                if (n < group.Start || n > group.End) continue;
                var y = visual.VisualTop - textView.VerticalOffset;
                if (double.IsNaN(top)) top = y;
                bottom = y + visual.Height;
            }
            if (!double.IsNaN(top)) dc.DrawRectangle(_fill, null, new Rect(look.CodePanelInset, top, Math.Max(0, textView.Bounds.Width - 2 * look.CodePanelInset), bottom - top), look.CodeRadius, look.CodeRadius);
        }
    }
}

internal static class AdjacentGrouping
{
    public static IEnumerable<(int Start, int End)> GroupAdjacent(this IEnumerable<(MarkdownScanner.LineInfo line, int i)> source)
    {
        var start = -1; var end = -1;
        foreach (var item in source)
        {
            if (start < 0) start = end = item.i;
            else if (item.i == end + 1) end = item.i;
            else { yield return (start, end); start = end = item.i; }
        }
        if (start >= 0) yield return (start, end);
    }
}

internal sealed class CheckboxGenerator(Look look, MarkdownScanner scanner, TextEditor editor) : VisualLineElementGenerator
{
    private static readonly Cursor Hand = new(StandardCursorType.Hand);
    public override int GetFirstInterestedOffset(int startOffset)
    {
        var doc = CurrentContext.Document; var line = doc.GetLineByOffset(Math.Min(startOffset, doc.TextLength));
        if (line is not null)
        {
            var info = scanner.GetLine(line.LineNumber);
            if (info.CheckboxOffset >= 0 && !info.IsCode)
            {
                var offset = line.Offset + info.CheckboxOffset;
                if (offset >= startOffset) return offset;
            }
        }
        return -1;
    }
    public override VisualLineElement? ConstructElement(int offset)
    {
        var doc = CurrentContext.Document; var line = doc.GetLineByOffset(offset); var info = scanner.GetLine(line.LineNumber);
        if (info.IsCode || info.CheckboxOffset != offset - line.Offset) return null;
        var checkedBox = info.CheckboxChecked;
        var accent = new SolidColorBrush(look.Accent);
        var box = new Border
        {
            Width = look.CheckboxSize, Height = look.CheckboxSize,
            CornerRadius = new CornerRadius(look.CheckboxRadius), BorderThickness = new Thickness(look.CheckboxStroke),
            BorderBrush = checkedBox ? accent : new SolidColorBrush(look.Muted), Background = checkedBox ? accent : Brushes.Transparent,
            Margin = look.CheckboxMargin, VerticalAlignment = VerticalAlignment.Bottom,
            Child = checkedBox ? new Avalonia.Controls.Shapes.Path { Data = Geometry.Parse("M3.5,8.5 L7,12 L13,4.5"), Stroke = new SolidColorBrush(look.CheckboxCheck), StrokeThickness = look.CheckboxCheckStroke, StrokeLineCap = PenLineCap.Round, StrokeJoin = PenLineJoin.Round } : null,
            Cursor = Hand
        };
        box.PointerPressed += (_, e) =>
        {
            if (editor.IsReadOnly || !e.GetCurrentPoint(box).Properties.IsLeftButtonPressed) return;
            var caret = editor.CaretOffset;
            if (EditorOperations.ToggleCheckbox(doc, offset, ref caret) is null) return;
            editor.CaretOffset = caret; editor.TextArea.TextView.Redraw(); e.Handled = true;
        };
        return new InlineObjectElement(3, box);
    }
}
using System.Diagnostics;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.ApplicationLifetimes;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media;
using Avalonia.Threading;
using AvaloniaEdit;
using AntiQuickPad.Editor;
using AntiQuickPad.Notes;
using AntiQuickPad.Shell;
using AntiQuickPad.Carousel;
using Avalonia.Animation;
namespace AntiQuickPad;

public sealed class MainWindow : Window
{
    private readonly TextEditor _editor = EditorFactory.Create(Look.Default);
    private readonly NotesSession _notes;
    private readonly CarouselController _carousel;
    private readonly Dictionary<string, Vector> _scroll = new();
    private readonly DispatcherTimer _indicatorIdle = new() { Interval = TimeSpan.FromMilliseconds(1400) };
    private readonly DispatcherTimer _autosave = new() { Interval = TimeSpan.FromMilliseconds(350) };
    private readonly DispatcherTimer _cue = new() { Interval = TimeSpan.FromMilliseconds(130) };
    private readonly Border _frame = new();
    private readonly TextBlock _status = new() { FontSize = Look.Default.StatusSize, Margin = new Thickness(Look.Default.EditorPadding, Look.Default.StatusVerticalMargin) };
    private readonly StreamWriter _log;
    private TrayIcon? _tray;
    private GlobalHotkey? _hotkey;
    private bool _binding, _quitting, _initialized, _saveFailed;
    private string? _lastSaveError;
    private long _showStarted;
    private string _showSource = "startup";
    private TaskCompletionSource<double>? _focusCompletion;
    public double LastShowToFocusMs { get; private set; }

    public MainWindow()
    {
        Title = "AntiQuickPad"; Width = Look.Default.WindowWidth; Height = Look.Default.WindowHeight;
        MinWidth = Look.Default.MinWindowWidth; MinHeight = Look.Default.MinWindowHeight;
        WindowStartupLocation = WindowStartupLocation.CenterScreen;
        WindowDecorations = WindowDecorations.None; Topmost = true;
        Background = new SolidColorBrush(Look.Default.Background);
        Foreground = new SolidColorBrush(Look.Default.Foreground);
        FontFamily = new FontFamily(Look.Default.InterfaceFont);
        Directory.CreateDirectory(Path.GetDirectoryName(Program.Paths.Log)!);
        _log = new StreamWriter(new FileStream(Program.Paths.Log, FileMode.Append, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
        _notes = new NotesSession(Program.Paths.Notes);
        _carousel = new CarouselController(_editor, Look.Default, () => _notes.CurrentIndex, () => _notes.Notes.Count,
            i => _notes.Notes[i].Text, i => _scroll.GetValueOrDefault(_notes.Notes[i].Id), SelectNote, ShowIndicator);
        _status.Transitions = new Transitions { new DoubleTransition { Property = OpacityProperty, Duration = TimeSpan.FromMilliseconds(450) } };
        ToolTip.SetTip(_status, "Ctrl+N new · Ctrl+Shift+Delete delete · Shift+wheel change note · Esc hide");
        _indicatorIdle.Tick += (_, _) => { _indicatorIdle.Stop(); if (!_saveFailed) _status.Opacity = Look.Default.IndicatorIdleOpacity; };
        var content = new DockPanel();
        DockPanel.SetDock(_status, Dock.Bottom); content.Children.Add(_status); content.Children.Add(_carousel.View);
        _frame.Child = content; _frame.BorderThickness = new Thickness(Look.Default.BorderSize);
        _frame.BorderBrush = new SolidColorBrush(Look.Default.Muted); Content = _frame;
        BindCurrent();
        _editor.TextChanged += (_, _) => ScheduleSave();
        _editor.TextArea.Caret.PositionChanged += (_, _) => ScheduleSave();
        _editor.TextArea.GotFocus += (_, _) => CompleteFocus();
        _autosave.Tick += (_, _) => SaveNotes();
        _cue.Tick += (_, _) => { _cue.Stop(); _frame.BorderBrush = new SolidColorBrush(Look.Default.Muted); };
        AddHandler(KeyDownEvent, OnKeyDown, RoutingStrategies.Tunnel, true);
        Opened += (_, _) => InitializeResident();
        Activated += (_, _) => Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        Closing += (_, e) => { if (!_quitting) { e.Cancel = true; HideResident(); } };
        Deactivated += (_, _) => _carousel.Cancel();
        Closed += (_, _) => { _carousel.Cancel(); _indicatorIdle.Stop(); _autosave.Stop(); _cue.Stop(); _hotkey?.Dispose(); _tray?.Dispose(); if (_quitting) Log("quit-finish window-closed=true"); _log.Dispose(); };
    }

    private void InitializeResident()
    {
        if (_initialized) return;
        _initialized = true;
        // The selftest does not claim the real hotkey or affect an existing resident app.
        if (!Program.SelfTest)
        {
            InstallHotkey();
            SetupTray();
        }
        _showStarted = Stopwatch.GetTimestamp();
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        if (Program.SelfTest) Dispatcher.UIThread.Post(async () => await RunSelfTest(), DispatcherPriority.Background);
    }

    private void InstallHotkey()
    {
        try
        {
            _hotkey = new GlobalHotkey(this, timestamp => Toggle(timestamp));
            Log($"hotkey gesture={_hotkey.GestureLabel} registered={_hotkey.IsRegistered} error={_hotkey.RegistrationError} {_hotkey.RegistrationErrorMessage}");
        }
        catch (FormatException ex) { Log($"hotkey-configuration-error {ex.Message}"); }
    }

    public void Toggle(long started = 0)
    {
        if (IsVisible) HideResident(); else ShowResident("toggle", started);
    }

    public void ShowResident(string source, long started = 0)
    {
        _showStarted = started == 0 ? Stopwatch.GetTimestamp() : started; _showSource = source;
        WindowState = WindowState.Normal; Show(); Activate();
        _frame.BorderBrush = new SolidColorBrush(Look.Default.Accent); _cue.Stop(); _cue.Start();
        FocusEditor();
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
    }

    public void HideResident()
    {
        _carousel.Cancel();
        if (!SaveNotes()) return;
        _showStarted = 0; Hide(); Log("hidden resident=true");
    }

    private void FocusEditor()
    {
        if (!IsVisible) return;
        Activate(); _editor.TextArea.Focus(); CompleteFocus();
    }

    private void CompleteFocus()
    {
        if (_showStarted == 0 || !IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) return;
        LastShowToFocusMs = Stopwatch.GetElapsedTime(_showStarted).TotalMilliseconds;
        _showStarted = 0;
        Log($"show-to-focus source={_showSource} ms={LastShowToFocusMs:F3} focused=true");
        _focusCompletion?.TrySetResult(LastShowToFocusMs);
    }

    private void ScheduleSave()
    {
        if (_binding) return;
        _notes.UpdateCurrent(_editor.Text, _editor.CaretOffset);
        _autosave.Stop(); _autosave.Start();
    }

    private bool SaveNotes()
    {
        _autosave.Stop();
        try
        {
            _notes.UpdateCurrent(_editor.Text, _editor.CaretOffset); _notes.Save();
            _saveFailed = false; _lastSaveError = null; UpdateStatus(); return true;
        }
        catch (Exception ex)
        {
            _saveFailed = true; _lastSaveError = ex.Message; UpdateStatus(); Log($"save-error {ex}"); return false;
        }
    }

    private void BindCurrent()
    {
        _binding = true;
        try { _editor.Text = _notes.Current.Text; _editor.CaretOffset = _notes.Current.CaretOffset; _editor.Document.UndoStack.ClearAll(); }
        finally { _binding = false; }
        var scroll = _scroll.GetValueOrDefault(_notes.Current.Id);
        EditorViewport.Restore(_editor, scroll);
        UpdateStatus();
    }

    private void RememberScroll() => _scroll[_notes.Current.Id] = _editor.TextArea.TextView.ScrollOffset;
    public void CreateNote() { _carousel.Cancel(); if (!SaveNotes()) return; RememberScroll(); _notes.CreateNote(); BindCurrent(); SaveNotes(); FocusEditor(); }
    public void DeleteCurrentNote()
    {
        _carousel.Cancel(); if (!SaveNotes()) return;
        var id = _notes.Current.Id;
        try { _notes.DeleteCurrent(); _scroll.Remove(id); BindCurrent(); FocusEditor(); }
        catch (Exception ex) { _saveFailed = true; UpdateStatus(); Log($"delete-error {ex}"); }
    }
    public void SelectNote(int index)
    {
        _carousel.Cancel(); if (!SaveNotes()) return;
        RememberScroll(); _notes.Select(index); BindCurrent(); SaveNotes(); FocusEditor();
    }
    private void ShowIndicator()
    {
        _status.Opacity = 1; _indicatorIdle.Stop(); if (!_saveFailed) _indicatorIdle.Start();
    }
    private void UpdateStatus()
    {
        _status.Foreground = new SolidColorBrush(_saveFailed ? Look.Default.Accent : Look.Default.Muted);
        _status.Text = _saveFailed ? "Could not save. Your note is still open; check the log and disk access."
            : $"{_notes.CurrentIndex + 1} / {_notes.Notes.Count}";
        ShowIndicator();
    }

    public void Quit(int exitCode = 0)
    {
        Log("quit-start");
        _carousel.Cancel();
        if (!SaveNotes())
        {
            Log($"quit-aborted save-failed reason={_lastSaveError}");
            ShowResident("quit-save-failed");
            UpdateStatus();
            return;
        }
        _quitting = true; Close();
        (Application.Current!.ApplicationLifetime as IClassicDesktopStyleApplicationLifetime)!.Shutdown(exitCode);
    }

    private void OnKeyDown(object? sender, KeyEventArgs e)
    {
        if (e.Key == Key.Escape) { HideResident(); e.Handled = true; }
        else if (e.Key == Key.N && e.KeyModifiers == KeyModifiers.Control) { CreateNote(); e.Handled = true; }
        else if (e.Key == Key.Delete && e.KeyModifiers == (KeyModifiers.Control | KeyModifiers.Shift)) { DeleteCurrentNote(); e.Handled = true; }
    }

    private void SetupTray()
    {
        var menu = new NativeMenu();
        var toggle = new NativeMenuItem("Show / Hide"); toggle.Click += (_, _) => Toggle(); menu.Items.Add(toggle);
        var quit = new NativeMenuItem("Quit"); quit.Click += (_, _) => Quit(); menu.Items.Add(quit);
        var hotkeyStatus = _hotkey is { IsRegistered: true } ? _hotkey.GestureLabel : "hotkey unavailable; see log";
        _tray = new TrayIcon { ToolTipText = $"AntiQuickPad · {hotkeyStatus}", Icon = CreateTrayIcon(), Menu = menu, IsVisible = true };
        _tray.Clicked += (_, _) => ShowResident("tray");
        TrayIcon.SetIcons(Application.Current!, new TrayIcons { _tray });
    }

    private static WindowIcon CreateTrayIcon()
    {
        using var stream = new MemoryStream(); using var writer = new BinaryWriter(stream);
        writer.Write((ushort)0); writer.Write((ushort)1); writer.Write((ushort)1);
        writer.Write((byte)16); writer.Write((byte)16); writer.Write((byte)0); writer.Write((byte)0);
        writer.Write((ushort)1); writer.Write((ushort)32); writer.Write(40 + 16 * 16 * 4 + 64); writer.Write(22);
        writer.Write(40); writer.Write(16); writer.Write(32); writer.Write((ushort)1); writer.Write((ushort)32);
        writer.Write(0); writer.Write(16 * 16 * 4); writer.Write(0); writer.Write(0); writer.Write(0); writer.Write(0);
        var color = Look.Default.Accent;
        for (var i = 0; i < 256; i++) { writer.Write(color.B); writer.Write(color.G); writer.Write(color.R); writer.Write((byte)255); }
        writer.Write(new byte[64]); stream.Position = 0; return new WindowIcon(stream);
    }

    private async Task RunSelfTest()
    {
        var exitCode = 1;
        try
        {
            EditorFactory.RunSmoke();
            await Task.Delay(200);
            if (!IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) throw new Exception("Startup editor focus failed.");
            _editor.Text = "# Heading one\n## Heading two\n### Three\n#### Four\n##### Five\n###### Six\n**bold** *italic* ~~strike~~\n- [ ] todo\n- [x] done\n```python\ndef note():\n    return '# string' # comment\n```\n";
            await Task.Delay(80); // Exercise real visual-line generation, inline controls and code background.
            _editor.TextArea.TextView.EnsureVisualLines();
            if (_editor.TextArea.TextView.VisualLines.Count == 0) throw new Exception("Decorated fixture did not lay out.");
            Console.WriteLine("M3 PASS: Markdown classification; undoable checkbox text edit; Shift+Tab; decorated visual lines.");
            _editor.Text = "";
            var originalEditor = _editor;
            var timings = new List<double>();
            for (var i = 0; i < 3; i++)
            {
                Toggle(); if (IsVisible) throw new Exception("Toggle did not hide.");
                await Task.Delay(40);
                _focusCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
                Toggle(Stopwatch.GetTimestamp());
                timings.Add(await _focusCompletion.Task.WaitAsync(TimeSpan.FromSeconds(3)));
                if (!ReferenceEquals(originalEditor, _editor) || !_editor.TextArea.IsKeyboardFocusWithin)
                    throw new Exception("Resident editor was recreated or not focused.");
            }
            CreateNote(); _editor.Text = "# editor round trip\nsecond line"; _editor.CaretOffset = 7;
            await Task.Delay(550); // Let the real debounce timer persist the edit and caret.
            var reload = new NotesSession(Program.Paths.Notes);
            if (reload.Current.Text != _editor.Text || reload.Current.CaretOffset != 7 || reload.CurrentIndex != 1)
                throw new Exception("Editor round trip failed.");
            if (!NotesSession.RunPersistenceSmoke(Program.Paths.Root)) throw new Exception("Persistence smoke failed.");
            await RunChild("--selftest-reload", Program.Paths.Notes);
            await RunCarouselSmoke();
            Toggle();
            var signalId = "AntiQuickPad-selftest-" + Guid.NewGuid().ToString("N");
            var signal = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _focusCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            using (var singleton = new SingleInstanceService(() => Dispatcher.UIThread.Post(() =>
            {
                ShowResident("selftest-second-launch"); signal.TrySetResult();
            }), signalId))
            {
                if (!singleton.IsPrimary) throw new Exception("Isolated singleton was not primary.");
                await RunChild("--selftest-signal", signalId);
                await signal.Task.WaitAsync(TimeSpan.FromSeconds(3));
                await _focusCompletion.Task.WaitAsync(TimeSpan.FromSeconds(3));
            }
            if (!IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) throw new Exception("Second-launch show/focus failed.");
            foreach (var ms in timings) Console.WriteLine($"show-to-focus internal ms={ms:F3}");
            if (timings.Any(ms => ms >= 100)) throw new Exception("Internal show-to-focus exceeded 100 ms.");
            // Lock the manifest to exercise the actual SaveNotes/Quit failure path without touching user notes.
            using (var locked = new FileStream(Path.Combine(Program.Paths.Notes, "notes.json"), FileMode.Open, FileAccess.Read, FileShare.None))
            {
                Hide(); Quit();
                using var logReader = new StreamReader(new FileStream(Program.Paths.Log, FileMode.Open, FileAccess.Read, FileShare.ReadWrite));
                var log = logReader.ReadToEnd();
                if (_quitting || !IsVisible || !_saveFailed || !_status.Text!.StartsWith("Could not save") ||
                    !log.Contains("quit-start") || !log.Contains("quit-aborted save-failed reason=") || !log.Contains("save-error"))
                    throw new Exception("Quit save-failure visibility/logging failed.");
            }
            Console.WriteLine("T006 PASS: heading boundaries; list Enter/undo; quit failure restores visible status and logs reason.");
            Console.WriteLine("SELFTEST PASS: same resident editor; toggle/focus; debounced save; next-process reload; second-process signal/show; notes round trip.");
            Log("SELFTEST PASS"); exitCode = 0;
        }
        catch (Exception ex) { Console.Error.WriteLine($"SELFTEST FAIL: {ex}"); Log($"SELFTEST FAIL: {ex}"); }
        finally
        {
            Quit(exitCode);
        }
    }
    private async Task RunCarouselSmoke()
    {
        CarouselController.RunSmoke();
        CreateNote(); SelectNote(0);
        _carousel.RequestWheel(1, 0);
        for (var t = 20; t <= 180; t += 20) _carousel.RequestWheel(1, t);
        await Task.Delay(300);
        _carousel.RequestWheel(1, 250); // trailing event of the same burst, after animation
        await Task.Delay(60);
        if (_notes.CurrentIndex != 1 || _carousel.IsBusy) throw new Exception("Integrated wheel notch/burst double skip.");
        var width = _carousel.View.Bounds.Width;
        _carousel.BeginDrag(0, 1000); _carousel.MoveDrag(-width * .6, 2000);
        if (Math.Abs(((TranslateTransform)_editor.RenderTransform!).X + width * .6) > 1)
            throw new Exception("Drag was not 1:1.");
        _carousel.EndDrag(2100); await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated long drag did not snap to next note.");
        _carousel.BeginDrag(0, 3000); _carousel.MoveDrag(20, 3100); _carousel.EndDrag(3250);
        await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated short drag did not return.");
        _editor.Text = string.Join('\n', Enumerable.Range(0, 120).Select(i => $"Line {i} saved scroll"));
        _editor.CaretOffset = 7; await Task.Delay(60);
        _editor.UpdateLayout(); _editor.TextArea.TextView.EnsureVisualLines();
        EditorViewport.Restore(_editor, new Vector(0, 300));
        await Task.Delay(120);
        var saved = _editor.VerticalOffset;
        SelectNote(1); SelectNote(2); await Task.Delay(60);
        if (_editor.CaretOffset != 7 || saved < 100 || Math.Abs(_editor.VerticalOffset - saved) > 1)
            throw new Exception($"Caret/scroll restore failed: caret={_editor.CaretOffset} scroll={_editor.VerticalOffset} expected={saved} editor={_editor.Bounds} documentHeight={_editor.TextArea.TextView.DocumentHeight}.");
        _carousel.BeginDrag(0, 4000); _carousel.MoveDrag(40, 4100); _carousel.Cancel();
        if (_carousel.IsBusy || _editor.IsReadOnly || ((TranslateTransform)_editor.RenderTransform!).X != 0)
            throw new Exception("Drag cancellation failed.");
        DeleteCurrentNote(); DeleteCurrentNote(); DeleteCurrentNote();
        if (_notes.Notes.Count != 1) throw new Exception("Delete must keep one note.");
        Console.WriteLine("M4 PASS: integrated notch/burst; 1:1 drag; long/short snap; caret/scroll; cancellation; delete keeps one note.");
    }
    private static async Task RunChild(string mode, string argument)
    {
        var executable = Environment.ProcessPath!;
        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = true };
        if (string.Equals(Path.GetFileNameWithoutExtension(executable), "dotnet", StringComparison.OrdinalIgnoreCase))
            start.ArgumentList.Add(typeof(Program).Assembly.Location);
        start.ArgumentList.Add(mode); start.ArgumentList.Add(argument);
        using var process = Process.Start(start) ?? throw new Exception("Could not start selftest child.");
        try { await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(5)); }
        catch { if (!process.HasExited) process.Kill(); throw; }
        if (process.ExitCode != 0) throw new Exception($"{mode} child exit={process.ExitCode}");
    }
    private void Log(string message) => _log.WriteLine($"{DateTimeOffset.UtcNow:O} {message}");
}
using Avalonia;
using Avalonia.Threading;
using AntiQuickPad.Shell;
namespace AntiQuickPad;
internal static class Program
{
    public static bool SelfTest { get; private set; }
    public static RuntimePaths Paths { get; private set; } = null!;
    private static MainWindow? _window;
    private static int _pendingShow;
    public static void Attach(MainWindow window)
    {
        Volatile.Write(ref _window, window);
        if (Interlocked.Exchange(ref _pendingShow, 0) != 0)
            Dispatcher.UIThread.Post(() => window.ShowResident("second-launch"));
    }
    private static void RequestShow()
    {
        Interlocked.Exchange(ref _pendingShow, 1);
        var window = Volatile.Read(ref _window);
        if (window is null) return;
        Interlocked.Exchange(ref _pendingShow, 0);
        Dispatcher.UIThread.Post(() => window.ShowResident("second-launch"));
    }
    [STAThread]
    public static int Main(string[] args)
    {
        Environment.SetEnvironmentVariable("AVALONIA_TELEMETRY_OPTOUT", "1");
        if (args is ["--selftest-signal", var instanceId])
        {
            using var secondary = new SingleInstanceService(() => { }, instanceId);
            return secondary.IsPrimary ? 1 : 0;
        }
        if (args is ["--selftest-reload", var directory])
        {
            var notes = new Notes.NotesSession(directory);
            return notes.CurrentIndex == 1 && notes.Current.Text == "# editor round trip\nsecond line"
                && notes.Current.CaretOffset == 7 ? 0 : 1;
        }
        SelfTest = args.Contains("--selftest", StringComparer.OrdinalIgnoreCase);
        Paths = SelfTest ? RuntimePaths.ForSelfTest() : RuntimePaths.Default;
        try
        {
            using var instance = SelfTest ? null : new SingleInstanceService(RequestShow);
            if (instance is { IsPrimary: false }) return 0;
            var exitCode = AppBuilder.Configure<App>().UsePlatformDetect().LogToTrace().StartWithClassicDesktopLifetime(args);
            if (SelfTest && exitCode == 0)
            {
                var log = File.ReadAllText(Paths.Log);
                if (log.LastIndexOf("quit-start", StringComparison.Ordinal) <= log.LastIndexOf("quit-aborted", StringComparison.Ordinal) ||
                    log.LastIndexOf("quit-finish window-closed=true", StringComparison.Ordinal) <= log.LastIndexOf("quit-start", StringComparison.Ordinal))
                { Console.Error.WriteLine("SELFTEST FAIL: quit start/finish log missing."); return 1; }
                Console.WriteLine("T006 PASS: successful quit start/finish logs.");
            }
            return exitCode;
        }
        catch (Exception ex) { Console.Error.WriteLine(ex); return 1; }
    }
}
