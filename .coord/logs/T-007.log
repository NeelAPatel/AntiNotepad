    private void UpdateStatus()
    {
        _count.Text = "'$"{_notes.CurrentIndex + 1} / {_notes.Notes.Count}";
        _status.Foreground = new SolidColorBrush(_saveFailed ? Look.Default.Accent : Look.Default.Muted);
        _status.Text = _saveFailed ? "Could not save. Check disk access." : _saving ? "Saving" : "Saved";
    }

    private sealed record WindowSettings(double Width, double Height, int X, int Y, bool Pinned);
    private void RestoreWindowSettings()
    {
        try
        {
            if (!File.Exists(Program.Paths.Settings)) return;
            var settings = JsonSerializer.Deserialize<WindowSettings>(File.ReadAllText(Program.Paths.Settings));
            if (settings is null || !double.IsFinite(settings.Width) || !double.IsFinite(settings.Height)) return;
            Width = Math.Max(MinWidth, settings.Width); Height = Math.Max(MinHeight, settings.Height);
            Position = new PixelPoint(settings.X, settings.Y); WindowStartupLocation = WindowStartupLocation.Manual;
            Topmost = settings.Pinned;
        }
        catch (Exception ex) { System.Diagnostics.Trace.WriteLine($"window-settings-load: {ex.Message}"); }
    }
    private void SaveWindowSettings()
    {
        // Keep the normal restore bounds when maximized/minimized.
        if (WindowState != WindowState.Normal) return;
        var settings = new WindowSettings(Width, Height, Position.X, Position.Y, Topmost);
        var temp = Program.Paths.Settings + ".tmp";
        File.WriteAllText(temp, JsonSerializer.Serialize(settings)); File.Move(temp, Program.Paths.Settings, true);
    }
    private void SetPinned(bool pinned)
    {
        Topmost = pinned;
        try { SaveWindowSettings(); }
        catch (Exception ex) { Log($"window-settings-save-error {ex}"); }
    }

