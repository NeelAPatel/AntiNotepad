                { Console.Error.WriteLine("SELFTEST FAIL: quit start/finish log missing."); return 1; }
                Console.WriteLine("T006 PASS: successful quit start/finish logs.");
            }
            return exitCode;
        }
        catch (Exception ex) { Console.Error.WriteLine(ex); return 1; }
    }
