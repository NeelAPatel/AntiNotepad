using System.Runtime.InteropServices;
using Avalonia;
using Avalonia.Media.Imaging;
using AvaloniaEdit;
using AvaloniaEdit.Rendering;

namespace AntiQuickPad.Editor;

internal static class AlignmentProof
{
    public static async Task Run(TextEditor editor, string output)
    {
        var view = editor.TextArea.TextView;
        PixelSize size = default;
        byte[] Capture(string? name)
        {
            size = new PixelSize((int)Math.Ceiling(editor.Bounds.Width), (int)Math.Ceiling(editor.Bounds.Height));
            using var bitmap = new RenderTargetBitmap(size, new Vector(96, 96)); bitmap.Render(editor);
            if (name != null) bitmap.Save(Path.Combine(output, name), PngBitmapEncoderOptions.Default);
            var bytes = new byte[size.Width * size.Height * 4]; var ptr = Marshal.AllocHGlobal(bytes.Length);
            try { bitmap.CopyPixels(new PixelRect(size), ptr, bytes.Length, size.Width * 4); Marshal.Copy(ptr, bytes, 0, bytes.Length); }
            finally { Marshal.FreeHGlobal(ptr); }
            return bytes;
        }
        async Task Layout(string text)
        {
            editor.Text = text; editor.CaretOffset = 0; editor.ScrollToHome(); await Task.Delay(100);
            editor.UpdateLayout(); view.EnsureVisualLines(); editor.TextArea.Caret.Hide();
        }
        Rect Bounds(byte[] pixels, Rect region, Func<byte, byte, byte, bool> test)
        {
            var points = new List<Point>();
            for (var y = Math.Max(0, (int)Math.Floor(region.Top)); y < Math.Min(size.Height, Math.Ceiling(region.Bottom)); y++)
            for (var x = Math.Max(0, (int)Math.Floor(region.Left)); x < Math.Min(size.Width, Math.Ceiling(region.Right)); x++)
            { var i = (y * size.Width + x) * 4; if (test(pixels[i + 2], pixels[i + 1], pixels[i])) points.Add(new Point(x + .5, y + .5)); }
            if (points.Count == 0) throw new Exception("No fixture ink found.");
            return new Rect(new Point(points.Min(p => p.X) - .5, points.Min(p => p.Y) - .5), new Point(points.Max(p => p.X) + .5, points.Max(p => p.Y) + .5));
        }
        await Layout("- [ ] open\n- [x] done\n- plain\n    - [ ] nested\n        - [x] deep\n    - plain");
        var pixels = Capture("T-008-checkbox.png");
        var origin = view.TranslatePoint(default, editor)!.Value;
        var boxes = view.BackgroundRenderers.OfType<CheckboxRenderer>().Single().Boxes.ToArray();
        bool Accent(byte r, byte g, byte b) => Math.Abs(r - Look.Default.Accent.R) < 20 && Math.Abs(g - Look.Default.Accent.G) < 20 && Math.Abs(b - Look.Default.Accent.B) < 20;
        var bulletCentres = new List<double>();
        foreach (var item in boxes)
        {
            var box = item.Bounds.Translate(new Vector(origin.X, origin.Y));
            var isChecked = editor.Document.GetCharAt(item.Offset + 1) == 'x';
            var color = isChecked ? Look.Default.Accent : Look.Default.Muted;
            var ink = Bounds(pixels, box.Inflate(2), (r,g,b) => Math.Abs(r-color.R)<20 && Math.Abs(g-color.G)<20 && Math.Abs(b-color.B)<20);
            var line = editor.Document.GetLineByOffset(item.Offset);
            var visual = view.VisualLines.Single(v => v.FirstDocumentLine == line);
            var dashColumn = editor.Document.GetText(line).IndexOf('-');
            var dash = BackgroundGeometryBuilder.GetRectsForSegment(view, new AvaloniaEdit.Document.SimpleSegment(line.Offset + dashColumn, 1)).Single().Translate(new Vector(origin.X, origin.Y));
            var dashInk = Bounds(pixels, dash, Accent);
            bulletCentres.Add(dashInk.Center.Y);
            var delta = Math.Abs(ink.Center.Y - dashInk.Center.Y);
            if (delta > 1) throw new Exception($"Checkbox/bullet centre mismatch: {delta}");
            if (editor.Document.GetCharAt(item.Offset + 1) == 'x')
            {
                var check = Bounds(pixels, box.Deflate(2), (r,g,b) => r < 60 && g < 65 && b < 75);
                var dx = Math.Abs(check.Center.X - ink.Center.X); var dy = Math.Abs(check.Center.Y - ink.Center.Y);
                Console.WriteLine($"T008 checkbox line={line.LineNumber}: check centre delta=({dx:F2},{dy:F2})px box/bullet deltaY={delta:F2}px row={visual.Height:F3}");
                if (dx > 1 || dy > 1) throw new Exception("Check ink not centred.");
            }
            else Console.WriteLine($"T008 open line={line.LineNumber}: box/bullet deltaY={delta:F2}px row={visual.Height:F3}");
        }
        var heights = view.VisualLines.Select(v => v.Height).ToArray();
        if (heights.Max() - heights.Min() > .01) throw new Exception("Checkbox changed row height.");
        // Hit-test the rendered rectangle and exercise the same toggle operation used by pointer input.
        var hit = boxes[0]; var caret = editor.CaretOffset;
        EditorFactory.UpdateCursor(editor, hit.Bounds.Center);
        if (!ReferenceEquals(editor.Cursor, EditorFactory.CheckboxHand) || !EditorFactory.TryCheckboxAt(editor, hit.Bounds.Center, out var hitOffset) || hitOffset != hit.Offset)
            throw new Exception("Checkbox hover/hit failed.");
        EditorFactory.UpdateCursor(editor, new Point(view.Bounds.Width - 10, view.Bounds.Height - 10));
        if (ReferenceEquals(editor.Cursor, EditorFactory.CheckboxHand)) throw new Exception("Checkbox hover did not clear.");
        if (!hit.Bounds.Contains(hit.Bounds.Center) || EditorOperations.ToggleCheckbox(editor.Document, hit.Offset, ref caret) != "[x]") throw new Exception("Checkbox hit/toggle failed.");
        editor.Document.UndoStack.Undo();

        // A plain-row control compares actual bullet ink positions, rather than trusting layout heights.
        await Layout("- plain\n- plain\n- plain\n    - plain\n        - plain\n    - plain");
        var plainPixels = Capture(null);
        var controlDelta = 0.0;
        var iBullet = 0;
        foreach (var n in new[] {1,2,4,5})
        {
            var line = editor.Document.GetLineByNumber(n);
            var dashColumn = editor.Document.GetText(line).IndexOf('-');
            var region = BackgroundGeometryBuilder.GetRectsForSegment(view, new AvaloniaEdit.Document.SimpleSegment(line.Offset + dashColumn, 1)).Single().Translate(new Vector(origin.X,origin.Y));
            var y = Bounds(plainPixels, region, Accent).Center.Y;
            controlDelta = Math.Max(controlDelta, Math.Abs(y - bulletCentres[iBullet++]));
        }
        if (controlDelta != 0) throw new Exception("Checkbox/plain row pixel positions differ.");
        Console.WriteLine($"T008 row pixel control: max bullet-centre displacement vs all-plain rows={controlDelta:F2}px; hover/hit/undo PASS.");

        await Layout("- root\n    - child\n        - grandchild\n\n        - continued\n\n- outside\n    ```python\n    def f():\n        if True:\n            return 1\n\n        return 0\n    ```\n\n\t- tab\n\t\t- two tabs\n\nend");
        var guide = view.BackgroundRenderers.OfType<IndentGuideRenderer>().Single();
        var on = Capture("T-008-guides.png");
        view.BackgroundRenderers.Remove(guide); view.InvalidateLayer(KnownLayer.Background); await Task.Delay(80);
        var off = Capture(null);
        view.BackgroundRenderers.Add(guide); view.InvalidateLayer(KnownLayer.Background);
        origin = view.TranslatePoint(default, editor)!.Value;
        int[] depths = [0,1,2,2,2,0,0,1,1,2,3,2,2,1,0,1,2,0,0];
        foreach (var visual in view.VisualLines)
        {
            var n = visual.FirstDocumentLine.LineNumber; var expected = depths[n - 1];
            var columns = new HashSet<int>();
            var y0 = (int)Math.Ceiling(origin.Y + visual.VisualTop - view.VerticalOffset);
            for (var y = y0 + 2; y < y0 + (int)visual.Height - 2; y++)
            for (var x = (int)origin.X; x < size.Width; x++)
            { var i = (y * size.Width + x) * 4; if (Math.Abs(on[i] - off[i]) + Math.Abs(on[i+1] - off[i+1]) + Math.Abs(on[i+2] - off[i+2]) > 8) columns.Add(x); }
            var text = editor.Document.GetText(visual.FirstDocumentLine);
            // Independent font measurement for expected four-space stops, including the code face.
            var font = new Avalonia.Media.Typeface(new Avalonia.Media.FontFamily(n is >= 8 and <= 14 ? Look.Default.CodeFont : Look.Default.EditorFont));
            var spaces = new Avalonia.Media.FormattedText("    ", System.Globalization.CultureInfo.InvariantCulture, Avalonia.Media.FlowDirection.LeftToRight, font, editor.FontSize, Avalonia.Media.Brushes.White).WidthIncludingTrailingWhitespace;
            var xs = Enumerable.Range(1, expected).Select(k => (int)Math.Floor(origin.X + k * spaces)).ToArray();
            if (guide.Depth(n) != expected || columns.Count != expected || xs.Any(x => !columns.Any(c => Math.Abs(c - x) <= 1)))
                throw new Exception($"Guide pixels line {n}: expected {string.Join(',',xs)} actual {string.Join(',',columns)} depth={guide.Depth(n)}");
            Console.WriteLine($"T008 guides line={n} indentColumns={string.Join(',', Enumerable.Range(1,expected).Select(k=>k*4))} pixelX={string.Join(',',columns.Order())}");
        }
        // Off setting is exercised through the actual renderer using the same visual fixture.
        view.BackgroundRenderers.Remove(guide);
        var disabled = new IndentGuideRenderer(Look.Default with { ShowIndentGuides = false }, new MarkdownScanner(editor.Document));
        view.BackgroundRenderers.Add(disabled); view.InvalidateLayer(KnownLayer.Background); await Task.Delay(80);
        if (!Capture(null).SequenceEqual(off)) throw new Exception("Disabled guides still draw.");
        view.BackgroundRenderers.Remove(disabled); view.BackgroundRenderers.Add(guide);
        Console.WriteLine($"T008 PASS: checkbox rows all {heights[0]:F3} DIP; guide columns, blank continuation/end, tabs, code font and off setting verified; PNGs={output}");
    }
}

using System.Globalization;
using System.Text.RegularExpressions;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Input;
using Avalonia.Media;
using AvaloniaEdit;
using AvaloniaEdit.Document;
using AvaloniaEdit.Editing;
using AvaloniaEdit.Folding;
using AvaloniaEdit.Rendering;

namespace AntiQuickPad.Editor;

/// <summary>Builds the Markdown-aware editor and keeps each document's parsed line map shared by every renderer.</summary>
internal static class EditorFactory
{
    public static TextEditor Create(Look look)
    {
        var editor = new TextEditor
        {
            FontFamily = new FontFamily(look.EditorFont), FontSize = look.FontSize,
            Background = new SolidColorBrush(look.Background), Foreground = new SolidColorBrush(look.Foreground),
            LineNumbersForeground = new SolidColorBrush(look.Muted), ShowLineNumbers = look.ShowGutter,
            WordWrap = true, Padding = new Thickness(look.EditorPadding),
            HorizontalScrollBarVisibility = Avalonia.Controls.Primitives.ScrollBarVisibility.Disabled,
            VerticalScrollBarVisibility = Avalonia.Controls.Primitives.ScrollBarVisibility.Auto
        };
        editor.Options.IndentationSize = 4;
        var scan = new MarkdownScanner(editor.Document);
        editor.TextArea.TextView.LineTransformers.Add(new MarkdownColorizer(look, scan));
        editor.TextArea.TextView.BackgroundRenderers.Add(new CodePanelRenderer(look, scan));
        editor.TextArea.TextView.BackgroundRenderers.Add(new StrikeRenderer(look, scan));
        editor.TextArea.TextView.BackgroundRenderers.Add(new CheckboxRenderer(look, scan));
        editor.TextArea.TextView.BackgroundRenderers.Add(new IndentGuideRenderer(look, scan));
        editor.AddHandler(InputElement.PointerPressedEvent, (_, e) =>
        {
            if (editor.IsReadOnly || !e.GetCurrentPoint(editor).Properties.IsLeftButtonPressed ||
                !TryCheckboxAt(editor, e.GetPosition(editor.TextArea.TextView), out var offset)) return;
            var caret = editor.CaretOffset;
            EditorOperations.ToggleCheckbox(editor.Document, offset, ref caret);
            editor.CaretOffset = caret; e.Handled = true;
        }, Avalonia.Interactivity.RoutingStrategies.Tunnel, true);
        editor.Document.Changed += (_, _) => editor.TextArea.TextView.Redraw();
        editor.AddHandler(InputElement.PointerMovedEvent, (_, e) => UpdateCursor(editor, e.GetPosition(editor.TextArea.TextView)), Avalonia.Interactivity.RoutingStrategies.Tunnel, true);
        editor.PointerExited += (_, _) => SetHandCursor(editor, false);
        editor.TextArea.TextView.PointerExited += (_, _) => SetHandCursor(editor, false);
        editor.AddHandler(InputElement.KeyDownEvent, (_, e) => ApplyKey(editor, scan, e), Avalonia.Interactivity.RoutingStrategies.Tunnel, true);

        if (look.ShowFolding)
        {
            var folding = FoldingManager.Install(editor.TextArea);
            foreach (var margin in editor.TextArea.LeftMargins.OfType<FoldingMargin>())
                margin.SetValue(FoldingMargin.FoldingMarkerBrushProperty, new SolidColorBrush(look.Accent));
            void UpdateFoldings()
            {
                var folds = scan.GetFoldings().ToList();
                folding.UpdateFoldings(folds, -1);
            }
            UpdateFoldings();
            editor.Document.Changed += (_, _) => UpdateFoldings();
        }
        return editor;
    }

    /// <summary>Small deterministic M3 smoke checks, called by the app selftest.</summary>
    public static void RunSmoke()
    {
        var fixture = "# Heading\n**bold** *italic* ~~gone~~\n    - [ ] task\n```python\ndef f(): # comment\n    return 'ok'\n```\n";
        var document = new TextDocument(fixture);
        var scanner = new MarkdownScanner(document);
        var lines = scanner.Lines;
        if (lines[0].HeadingLevel != 1 || lines[1].Bold.Count != 1 || lines[1].Italic.Count != 1 || lines[1].Strike.Count != 1 ||
            lines[2].CheckboxOffset < 0 || !lines[4].IsPython || lines[4].CommentOffset < 0 || scanner.GetFoldings().Count < 2)
            throw new InvalidOperationException("Markdown scanner fixture classification failed.");
        var sections = new TextDocument("# One\nbody\n\n\noutside\n# Two\nbody\n## Child\nchild\n# Three\nend");
        var sectionFolds = new MarkdownScanner(sections).GetFoldings();
        if (sectionFolds[0].EndOffset != sections.GetLineByNumber(2).EndOffset ||
            sectionFolds[1].EndOffset != sections.GetLineByNumber(9).EndOffset ||
            sectionFolds[2].EndOffset != sections.GetLineByNumber(9).EndOffset)
            throw new InvalidOperationException("Heading blank-pair / next-heading boundary failed.");
        var nested = new TextDocument("# Section\n```\na\n\n\nb\n```\ntail\n\n\noutside");
        var nestedFolds = new MarkdownScanner(nested).GetFoldings();
        if (nestedFolds.Count != 2 || nestedFolds[0].EndOffset != nested.GetLineByNumber(8).EndOffset ||
            nestedFolds[1].EndOffset != nested.GetLineByNumber(6).EndOffset)
            throw new InvalidOperationException("Independent fence folding failed.");
        foreach (var (input, expected) in new (string, string)[]
        {
            ("- text", "- text\n- "), ("  - text", "  - text\n  - "), ("\t* text", "\t* text\n\t* "),
            ("- [ ] x", "- [ ] x\n- [ ] "), ("- [x] x", "- [x] x\n- [ ] "),
            ("1. text", "1. text\n2. "), ("9. text", "9. text\n10. "),
            ("- ", ""), ("* ", ""), ("1. ", ""), ("  - [ ] ", "  "), ("- [x] ", "")
        })
        {
            var list = new TextDocument(input);
            var newCaret = EditorOperations.ContinueList(list, list.TextLength);
            if (newCaret != list.TextLength || list.Text.Replace("\r\n", "\n") != expected)
                throw new InvalidOperationException($"List Enter failed for '{input}'.");
            list.UndoStack.Undo();
            if (list.Text != input || list.UndoStack.CanUndo) throw new InvalidOperationException("List Enter was not one undo step.");
        }
        foreach (var (input, expected, outdent) in new (string, string, bool)[]
        {
            ("- ", "    - ", false), ("* ", "    * ", false), ("- [ ] ", "    - [ ] ", false),
            ("8. ", "    1. ", false), ("3. parent\n    1. ", "3. parent\n4. ", true),
            ("    - [ ] ", "- [ ] ", true), ("\t* ", "* ", true)
        })
        {
            var item = new TextDocument(input);
            var tab = EditorOperations.ApplyTab(item, item.TextLength, null, null, outdent);
            if (item.Text != expected || tab.CaretOffset != item.TextLength) throw new Exception($"Empty list indent failed: {input}");
            item.UndoStack.Undo();
            if (item.Text != input || item.UndoStack.CanUndo) throw new Exception("Empty list indent must be one undo step.");
        }
        Console.WriteLine("T007 indent PASS: 7 empty marker indent/outdent/numbering cases and single undo.");
        var checkbox = document.GetLineByNumber(3).Offset + lines[2].CheckboxOffset;
        var caret = document.TextLength;
        if (EditorOperations.ToggleCheckbox(document, checkbox, ref caret) != "[x]" || document.GetText(checkbox, 3) != "[x]" || !document.UndoStack.CanUndo)
            throw new InvalidOperationException("Checkbox toggle was not an undoable text edit.");
        document.UndoStack.Undo();
        var taskLine = document.GetLineByNumber(3);
        var result = EditorOperations.ApplyTab(document, checkbox, null, null, outdent: true);
        if (!result.Changed || document.GetText(taskLine.Offset, 5) != "- [ ]")
            throw new InvalidOperationException("Shift+Tab outdent smoke failed.");
        var selected = new TextDocument("    one\n    two");
        EditorOperations.ApplyTab(selected, selected.TextLength, 0, selected.TextLength, true);
        if (selected.Text != "one\ntwo") throw new InvalidOperationException("Selection outdent failed.");
        var typed = new MarkdownScanner(new TextDocument("python:\nreturn '# string' # comment"));
        var fenced = new MarkdownScanner(new TextDocument("```\npython:\nreturn 1\n```"));
        if (!typed.Lines[1].IsPython || typed.Lines[1].CommentOffset != 18 || !fenced.Lines[2].IsPython)
            throw new InvalidOperationException("Python language marker classification failed.");
    }

    private static void ApplyKey(TextEditor editor, MarkdownScanner scanner, KeyEventArgs e)
    {
        if (e.Key == Key.Enter && e.KeyModifiers == KeyModifiers.None && !editor.IsReadOnly && editor.SelectionLength == 0 &&
            !scanner.GetLine(editor.Document.GetLineByOffset(editor.CaretOffset).LineNumber).IsCode &&
            EditorOperations.ContinueList(editor.Document, editor.CaretOffset) is int caret)
        {
            editor.CaretOffset = caret;
            e.Handled = true;
            return;
        }
        if (e.Key != Key.Tab || editor.IsReadOnly) return;
        var selection = editor.TextArea.Selection.SurroundingSegment;
        var result = EditorOperations.ApplyTab(editor.Document, editor.CaretOffset, selection?.Offset, selection?.EndOffset,
            e.KeyModifiers.HasFlag(KeyModifiers.Shift), !scanner.GetLine(editor.Document.GetLineByOffset(editor.CaretOffset).LineNumber).IsCode);
        if (result.SelectionStart is int start && result.SelectionEnd is int end && end != start)
            editor.TextArea.Selection = Selection.Create(editor.TextArea, start, end);
        editor.CaretOffset = result.CaretOffset;
        e.Handled = true;
    }

    internal static bool TryCheckboxAt(TextEditor editor, Point point, out int markerOffset)
    {
        markerOffset = -1;
        var view = editor.TextArea.TextView;
        var hit = view.BackgroundRenderers.OfType<CheckboxRenderer>().Single().Boxes
            .FirstOrDefault(b => b.Bounds.Contains(point));
        markerOffset = hit.Offset;
        return hit.Bounds.Width > 0;
    }

    internal static void UpdateCursor(TextEditor editor, Point point) => SetHandCursor(editor, TryCheckboxAt(editor, point, out _));
    internal static readonly Cursor CheckboxHand = new(StandardCursorType.Hand);
    private static readonly Cursor TextCursor = new(StandardCursorType.Ibeam);
    private static void SetHandCursor(TextEditor editor, bool hand)
    {
        var cursor = hand ? CheckboxHand : TextCursor;
        editor.Cursor = cursor; editor.TextArea.Cursor = cursor; editor.TextArea.TextView.Cursor = cursor;
        ToolTip.SetTip(editor.TextArea.TextView, hand ? "Toggle task checkbox" : null);
    }
}

/// <summary>Pure document operations shared by input handlers and smoke checks.</summary>
internal static class EditorOperations
{
    internal readonly record struct TabResult(int CaretOffset, int? SelectionStart, int? SelectionEnd, bool Changed);

    public static string? ToggleCheckbox(TextDocument document, int markerOffset, ref int caretOffset)
    {
        if (markerOffset < 0 || markerOffset + 3 > document.TextLength) return null;
        var token = document.GetText(markerOffset, 3);
        var replacement = token == "[ ]" ? "[x]" : token.Equals("[x]", StringComparison.OrdinalIgnoreCase) ? "[ ]" : null;
        if (replacement is null) return null;
        document.Replace(markerOffset, 3, replacement);
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        return replacement;
    }

    public static TabResult ApplyTab(TextDocument document, int caretOffset, int? selectionStart, int? selectionEnd, bool outdent, bool allowList = true)
    {
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        if (selectionStart is null || selectionEnd is null || selectionStart == selectionEnd)
        {
            var line = document.GetLineByOffset(caretOffset);
            var item = Regex.Match(document.GetText(line), @"^(?<indent>[ \t]*)(?<bullet>[-*+]|[0-9]+[.)])(?<tail>[ \t]+(?:\[[ xX]\][ \t]+)?)$");
            if (allowList && item.Success && caretOffset == line.EndOffset)
            {
                var indent = item.Groups["indent"].Value;
                var bullet = item.Groups["bullet"].Value;
                var removeIndent = indent.StartsWith('\t') ? 1 : Math.Min(4, indent.Length);
                if (outdent && removeIndent == 0) return new(caretOffset, null, null, false);
                var nextIndent = outdent ? indent[removeIndent..] : indent + "    ";
                if (char.IsDigit(bullet[0]))
                {
                    var number = 1L;
                    if (outdent)
                    {
                        for (var n = line.LineNumber - 1; n >= 1; n--)
                        {
                            var previous = Regex.Match(document.GetText(document.GetLineByNumber(n)), @"^(?<indent>[ \t]*)(?<num>[0-9]+)[.)][ \t]+");
                            var text = document.GetText(document.GetLineByNumber(n));
                            if (string.IsNullOrWhiteSpace(text)) continue;
                            var whitespace = text.TakeWhile(c => c is ' ' or '\t').Count();
                            if (whitespace < nextIndent.Length) break;
                            if (previous.Success && previous.Groups["indent"].Value == nextIndent && long.TryParse(previous.Groups["num"].Value, out var value) && value < long.MaxValue)
                            { number = value + 1; break; }
                        }
                    }
                    bullet = number.ToString(CultureInfo.InvariantCulture) + bullet[^1];
                }
                var replacement = nextIndent + bullet + item.Groups["tail"].Value;
                document.Replace(line.Offset, line.Length, replacement);
                return new(line.Offset + replacement.Length, null, null, true);
            }
            if (!outdent) { document.Insert(caretOffset, "    "); return new(caretOffset + 4, null, null, true); }
            var prefix = document.GetText(line.Offset, Math.Min(4, line.Length));
            var remove = prefix.StartsWith('\t') ? 1 : prefix.TakeWhile(c => c == ' ').Count();
            if (remove == 0) return new(caretOffset, null, null, false);
            document.Remove(line.Offset, remove);
            return new(MapRemove(caretOffset, line.Offset, remove), null, null, true);
        }

        var start = Math.Clamp(Math.Min(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var end = Math.Clamp(Math.Max(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var first = document.GetLineByOffset(start); var last = document.GetLineByOffset(Math.Max(start, end - 1));
        var lineNumbers = Enumerable.Range(first.LineNumber, last.LineNumber - first.LineNumber + 1);
        var caret = caretOffset; var a = selectionStart.Value; var b = selectionEnd.Value; var changed = false;
        document.BeginUpdate();
        try
        {
            foreach (var number in lineNumbers.Reverse())
            {
                var line = document.GetLineByNumber(number);
                if (!outdent)
                {
                    document.Insert(line.Offset, "    "); caret = MapInsert(caret, line.Offset, 4); a = MapInsert(a, line.Offset, 4); b = MapInsert(b, line.Offset, 4); changed = true;
                }
                else
                {
                    var p = document.GetText(line.Offset, Math.Min(4, line.Length));
                    var count = p.StartsWith('\t') ? 1 : p.TakeWhile(c => c == ' ').Count();
                    if (count == 0) continue;
                    document.Remove(line.Offset, count); caret = MapRemove(caret, line.Offset, count); a = MapRemove(a, line.Offset, count); b = MapRemove(b, line.Offset, count); changed = true;
                }
            }
        }
        finally { document.EndUpdate(); }
        return new(caret, a, b, changed);
    }

    // One replace operation gives continuation/exit its own single undo step.
    public static int? ContinueList(TextDocument document, int caretOffset)
    {
        var line = document.GetLineByOffset(caretOffset);
        var prefix = document.GetText(line.Offset, caretOffset - line.Offset);
        var match = Regex.Match(prefix, @"^(?<indent>[ \t]*)(?<bullet>[-*+]|[0-9]+[.)])(?:[ \t]+(?<task>\[[ xX]\])(?:[ \t]+|$)|[ \t]+)(?<text>.*)$");
        if (!match.Success) return null;
        var indent = match.Groups["indent"].Value;
        var rest = document.GetText(caretOffset, line.EndOffset - caretOffset);
        string replacement;
        int start, length;
        if (string.IsNullOrWhiteSpace(match.Groups["text"].Value + rest))
        {
            start = line.Offset; length = line.Length; replacement = indent;
        }
        else
        {
            var bullet = match.Groups["bullet"].Value;
            if (char.IsDigit(bullet[0]))
            {
                if (!long.TryParse(bullet[..^1], out var number) || number == long.MaxValue) return null;
                bullet = (number + 1).ToString(CultureInfo.InvariantCulture) + bullet[^1];
            }
            var newline = line.DelimiterLength > 0 ? document.GetText(line.EndOffset, line.DelimiterLength)
                : document.Lines.FirstOrDefault(l => l.DelimiterLength > 0) is { } other
                    ? document.GetText(other.EndOffset, other.DelimiterLength) : Environment.NewLine;
            start = caretOffset; length = 0;
            replacement = newline + indent + bullet + " " + (match.Groups["task"].Success ? "[ ] " : "");
        }
        document.BeginUpdate();
        try { document.Replace(start, length, replacement); }
        finally { document.EndUpdate(); }
        return start + replacement.Length;
    }

    private static int MapInsert(int p, int at, int length) => p >= at ? p + length : p;
    private static int MapRemove(int p, int at, int length) => p >= at + length ? p - length : p >= at ? at : p;
}

/// <summary>Cached parsed metadata. A single rebuild supplies syntax, folds, panels and checkbox hit testing.</summary>
internal sealed class MarkdownScanner
{
    private static readonly Regex Heading = new(@"^(?<indent> {0,3})(?<hash>#{1,6})(?:[ \t]+|$)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Task = new(@"^\s*[-*+]\s+\[(?<mark>[ xX])\]", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Bullet = new(@"^\s*(?:[-*+]|\d+[.)])\s+", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex FenceOpen = new(@"^\s*(`{3,}|~{3,})\s*(?<lang>[^\s`]*)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex BoldPattern = new(@"\*\*[^*\r\n].*?\*\*|__[^_\r\n].*?__", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex ItalicPattern = new(@"(?<!\*)\*(?!\*)[^*\r\n].*?\*(?!\*)|(?<!_)_(?!_)[^_\r\n].*?_(?!_)", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex StrikePattern = new(@"~~[^~\r\n].*?~~", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private readonly TextDocument _document;
    private bool _dirty = true;
    private LineInfo[] _lines = [];
    private NewFolding[] _foldings = [];
    public IReadOnlyList<LineInfo> Lines { get { Ensure(); return _lines; } }
    public MarkdownScanner(TextDocument document) { _document = document; document.Changed += (_, _) => _dirty = true; }
    public LineInfo GetLine(int number) { Ensure(); return _lines[Math.Clamp(number - 1, 0, _lines.Length - 1)]; }
    public IReadOnlyList<NewFolding> GetFoldings() { Ensure(); return _foldings; }

    private void Ensure()
    {
        if (!_dirty) return;
        var count = _document.LineCount;
        var lines = new LineInfo[count];
        for (var i = 0; i < count; i++)
        {
            var line = _document.GetLineByNumber(i + 1); var text = _document.GetText(line); var headingMatch = Heading.Match(text);
            var headingLevel = headingMatch.Success ? headingMatch.Groups["hash"].Length : 0;
            var taskMatch = Task.Match(text); var fenceMatch = FenceOpen.Match(text);
            var info = new LineInfo(text)
            {
                HeadingLevel = headingLevel,
                HeadingMarkerLength = headingMatch.Success ? headingMatch.Groups["indent"].Length + headingLevel : 0,
                CheckboxOffset = taskMatch.Success ? taskMatch.Groups["mark"].Index - 1 : -1,
                CheckboxChecked = taskMatch.Success && taskMatch.Groups["mark"].Value is "x" or "X",
                BulletLength = Bullet.Match(text) is { Success: true } bullet ? bullet.Length : 0,
                FenceMarker = fenceMatch.Success ? fenceMatch.Groups[1].Value : null,
                FenceLanguage = fenceMatch.Success ? fenceMatch.Groups["lang"].Value : string.Empty
            };
            info.Bold.AddRange(BoldPattern.Matches(text).Select(m => new Span(m.Index, m.Length, 2)));
            info.Italic.AddRange(ItalicPattern.Matches(text).Select(m => new Span(m.Index, m.Length, 1)));
            info.Strike.AddRange(StrikePattern.Matches(text).Select(m => new Span(m.Index, m.Length, 2)));
            lines[i] = info;
        }

        var folds = new List<NewFolding>();
        var openFence = -1; var fenceChar = '\0'; var fenceLen = 0; var pythonFence = false; var firstPython = lines.Length > 0 && lines[0].Text.TrimStart().StartsWith("python:", StringComparison.OrdinalIgnoreCase);
        for (var i = 0; i < lines.Length; i++)
        {
            var info = lines[i];
            if (firstPython && i == 0) { info.PythonMarker = true; info.IsCode = true; info.IsPython = true; continue; }
            if (info.FenceMarker is string marker)
            {
                if (openFence < 0)
                {
                    openFence = i; fenceChar = marker[0]; fenceLen = marker.Length;
                    pythonFence = info.FenceLanguage.Equals("python", StringComparison.OrdinalIgnoreCase) || info.FenceLanguage.Equals("py", StringComparison.OrdinalIgnoreCase);
                    info.IsFence = true; info.IsCode = true; info.IsPython = pythonFence;
                }
                else if (marker[0] == fenceChar && marker.Length >= fenceLen)
                {
                    info.IsFence = true; info.IsCode = true; info.IsPython = pythonFence;
                    if (i > openFence + 1) folds.Add(Fold(_document, openFence, i - 1));
                    openFence = -1; pythonFence = false;
                }
                else { info.IsCode = openFence >= 0; info.IsPython = pythonFence; }
                continue;
            }
            if (openFence >= 0 && i == openFence + 1 && lines[openFence].FenceLanguage.Length == 0 &&
                info.Text.Trim().Equals("python:", StringComparison.OrdinalIgnoreCase))
            {
                pythonFence = true; info.PythonMarker = true;
            }
            info.IsCode = openFence >= 0;
            info.IsPython = pythonFence;
            if (firstPython && i > 0) { info.IsCode = true; info.IsPython = true; }
        }

        for (var i = 0; i < lines.Length; i++)
            if (lines[i].IsPython && !lines[i].IsFence && !lines[i].PythonMarker)
                lines[i].CommentOffset = FindComment(lines[i].Text);
        if (openFence >= 0)
        {
            for (var i = openFence + 1; i < lines.Length; i++) { lines[i].IsCode = true; lines[i].IsPython = pythonFence; }
            if (lines.Length > openFence + 1) folds.Add(Fold(_document, openFence, lines.Length - 1));
        }

        // Blank pairs outside code also end a heading section; fence folding remains independent.
        var headings = Enumerable.Range(0, lines.Length).Where(i => lines[i].HeadingLevel > 0 && !lines[i].IsCode).ToArray();
        for (var h = 0; h < headings.Length; h++)
        {
            var start = headings[h]; var end = lines.Length - 1;
            for (var j = h + 1; j < headings.Length; j++) if (lines[headings[j]].HeadingLevel <= lines[start].HeadingLevel) { end = headings[j] - 1; break; }
            for (var j = start + 1; j < end; j++)
                if (!lines[j].IsCode && !lines[j + 1].IsCode && string.IsNullOrWhiteSpace(lines[j].Text) && string.IsNullOrWhiteSpace(lines[j + 1].Text))
                { end = j - 1; break; }
            if (end > start) folds.Add(Fold(_document, start, end));
        }

        if (firstPython)
        {
            var end = lines.Length - 1;
            if (end > 0) folds.Add(Fold(_document, 0, end));
        }
        _lines = lines; _foldings = folds.OrderBy(f => f.StartOffset).ToArray(); _dirty = false;
    }

    private static int FindComment(string text)
    {
        char quote = '\0'; var escaped = false;
        for (var i = 0; i < text.Length; i++)
        {
            var c = text[i];
            if (escaped) { escaped = false; continue; }
            if (c == '\\' && quote != '\0') { escaped = true; continue; }
            if (quote != '\0') { if (c == quote) quote = '\0'; continue; }
            if (c is '\'' or '"') { quote = c; continue; }
            if (c == '#') return i;
        }
        return -1;
    }

    private static NewFolding Fold(TextDocument doc, int startLine, int endLine) => new(doc.GetLineByNumber(startLine + 1).EndOffset, doc.GetLineByNumber(endLine + 1).EndOffset);
    internal sealed class LineInfo(string text)
    {
        public string Text { get; } = text;
        public int HeadingLevel { get; init; }
        public int HeadingMarkerLength { get; init; }
        public int CheckboxOffset { get; init; } = -1;
        public bool CheckboxChecked { get; init; }
        public int BulletLength { get; init; }
        public string? FenceMarker { get; init; }
        public string FenceLanguage { get; init; } = string.Empty;
        public bool IsFence { get; set; }
        public bool IsCode { get; set; }
        public bool IsPython { get; set; }
        public bool PythonMarker { get; set; }
        public int CommentOffset { get; set; } = -1;
        public List<Span> Bold { get; } = [];
        public List<Span> Italic { get; } = [];
        public List<Span> Strike { get; } = [];
    }
    internal readonly record struct Span(int Start, int Length, int MarkerLength);
}

internal sealed class MarkdownColorizer(Look look, MarkdownScanner scanner) : DocumentColorizingTransformer
{
    private readonly IBrush _dim = new SolidColorBrush(look.MarkdownMarker), _keyword = new SolidColorBrush(look.Keyword),
        _string = new SolidColorBrush(look.String), _comment = new SolidColorBrush(look.Comment), _accent = new SolidColorBrush(look.Accent);
    private readonly IBrush[] _heading = look.HeadingColors.Select(c => (IBrush)new SolidColorBrush(c)).ToArray();
    private readonly Typeface _codeTypeface = new(new FontFamily(look.CodeFont));
    private static readonly Regex Strings = new("""(?<q>['"])(?:\\.|(?!\k<q>).)*?\k<q>""", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));
    private static readonly Regex Keywords = new(@"\b(def|class|return|if|elif|else|for|while|in|import|from|as|try|except|with|yield|async|await|True|False|None|pass|break|continue|lambda|and|or|not|is|raise|finally|global|nonlocal|del|assert)\b", RegexOptions.Compiled, TimeSpan.FromMilliseconds(50));

    protected override void ColorizeLine(DocumentLine line)
    {
        var info = scanner.GetLine(line.LineNumber); var text = info.Text; var offset = line.Offset;
        if (info.IsCode)
        {
            ChangeLinePart(offset, line.EndOffset, e => e.TextRunProperties.SetTypeface(_codeTypeface));
            if (info.IsFence) { Paint(offset, line.EndOffset, _dim); return; }
            if (!info.IsPython) return;
            if (info.PythonMarker) { Paint(offset, line.EndOffset, _dim); return; }
            var codeEnd = info.CommentOffset < 0 ? text.Length : info.CommentOffset;
            foreach (Match m in Keywords.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _keyword);
            foreach (Match m in Strings.Matches(text)) if (m.Index < codeEnd) Paint(offset + m.Index, offset + Math.Min(codeEnd, m.Index + m.Length), _string);
            if (info.CommentOffset >= 0) Paint(offset + info.CommentOffset, line.EndOffset, _comment);
            return;
        }
        if (info.HeadingLevel > 0)
        {
            var idx = Math.Clamp(info.HeadingLevel - 1, 0, _heading.Length - 1);
            Paint(offset, line.EndOffset, _heading[idx]);
            Paint(offset, offset + info.HeadingMarkerLength, _dim);
            ChangeLinePart(offset, line.EndOffset, e =>
            {
                var old = e.TextRunProperties.Typeface;
                e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, FontStyle.Normal, info.HeadingLevel <= 2 ? FontWeight.Bold : FontWeight.SemiBold, old.Stretch));
                e.TextRunProperties.SetFontRenderingEmSize(look.HeadingSizes[Math.Clamp(info.HeadingLevel - 1, 0, look.HeadingSizes.Length - 1)]);
            });
            return;
        }
        foreach (var span in info.Bold) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Bold, FontStyle.Normal, null); }
        foreach (var span in info.Italic) { Markers(offset + span.Start, span.Length, span.MarkerLength); Format(offset + span.Start + span.MarkerLength, offset + span.Start + span.Length - span.MarkerLength, FontWeight.Normal, FontStyle.Italic, null); }
        foreach (var span in info.Strike) Markers(offset + span.Start, span.Length, span.MarkerLength);
        if (info.BulletLength > 0) Paint(offset, offset + info.BulletLength, _accent);
        if (info.CheckboxOffset >= 0) Paint(offset + info.CheckboxOffset, offset + info.CheckboxOffset + 3, Brushes.Transparent);
    }

    private void Markers(int start, int length, int count) { Paint(start, start + count, _dim); Paint(start + length - count, start + length, _dim); }
    private void Paint(int start, int end, IBrush brush) { if (end > start) ChangeLinePart(start, end, e => e.TextRunProperties.SetForegroundBrush(brush)); }
    private void Format(int start, int end, FontWeight weight, FontStyle style, TextDecorationCollection? decorations)
    {
        if (end <= start) return;
        ChangeLinePart(start, end, e => { var old = e.TextRunProperties.Typeface; e.TextRunProperties.SetTypeface(new Typeface(old.FontFamily, style, weight, old.Stretch)); if (decorations is not null) e.TextRunProperties.SetTextDecorations(decorations); });
    }
}

internal sealed class CodePanelRenderer(Look look, MarkdownScanner scanner) : IBackgroundRenderer
{
    private readonly IBrush _fill = new SolidColorBrush(look.CodePanel);
    public KnownLayer Layer => KnownLayer.Background;
    public void Draw(TextView textView, DrawingContext dc)
    {
        if (!textView.VisualLinesValid || textView.Document is null) return;
        foreach (var group in scanner.Lines.Select((line, i) => (line, i)).Where(x => x.line.IsCode).GroupAdjacent())
        {
            double top = double.NaN, bottom = 0;
            foreach (var visual in textView.VisualLines)
            {
                var n = visual.FirstDocumentLine.LineNumber - 1;
                if (n < group.Start || n > group.End) continue;
                var y = visual.VisualTop - textView.VerticalOffset;
                if (double.IsNaN(top)) top = y;
                bottom = y + visual.Height;
            }
            if (!double.IsNaN(top)) dc.DrawRectangle(_fill, null, new Rect(look.CodePanelInset, top, Math.Max(0, textView.Bounds.Width - 2 * look.CodePanelInset), bottom - top), look.CodeRadius, look.CodeRadius);
        }
    }
}

internal static class AdjacentGrouping
{
    public static IEnumerable<(int Start, int End)> GroupAdjacent(this IEnumerable<(MarkdownScanner.LineInfo line, int i)> source)
    {
        var start = -1; var end = -1;
        foreach (var item in source)
        {
            if (start < 0) start = end = item.i;
            else if (item.i == end + 1) end = item.i;
            else { yield return (start, end); start = end = item.i; }
        }
        if (start >= 0) yield return (start, end);
    }
}

