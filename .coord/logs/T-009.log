        WindowStartupLocation = WindowStartupLocation.CenterScreen;
        WindowDecorations = WindowDecorations.Full; Topmost = false;
        RestoreWindowSettings();
        _normalSettings = new WindowSettings(Width, Height, Position.X, Position.Y, Topmost);
        Background = new SolidColorBrush(Look.Default.Background);
        Foreground = new SolidColorBrush(Look.Default.Foreground);
        FontFamily = new FontFamily(Look.Default.InterfaceFont);
        Directory.CreateDirectory(Path.GetDirectoryName(Program.Paths.Log)!);
        _log = new StreamWriter(new FileStream(Program.Paths.Log, FileMode.Append, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
        _notes = new NotesSession(Program.Paths.Notes);
        _carousel = new CarouselController(_editor, Look.Default, () => _notes.CurrentIndex, () => _notes.Notes.Count,
            i => _notes.Notes[i].Text, i => _scroll.GetValueOrDefault(_notes.Notes[i].Id), SelectNote, ShowIndicator);
        var content = new DockPanel();
        var top = new WrapPanel { Orientation = Avalonia.Layout.Orientation.Horizontal, Margin = new Thickness(8, 4) };
        void AddButton(string label, Action action)
        {
            var button = new Button { Content = label, Margin = new Thickness(2), Background = new SolidColorBrush(Look.Default.CodePanel), Foreground = Foreground };
            button.Click += (_, _) => action(); top.Children.Add(button);
        }
        AddButton("New note", CreateNote); AddButton("Delete note", DeleteCurrentNote);
        AddButton("Previous", () => { if (_notes.CurrentIndex > 0) SelectNote(_notes.CurrentIndex - 1); });
        AddButton("Next", () => { if (_notes.CurrentIndex + 1 < _notes.Notes.Count) SelectNote(_notes.CurrentIndex + 1); });
        _pin.IsChecked = Topmost;
        _pin.IsCheckedChanged += (_, _) => SetPinned(_pin.IsChecked == true);
        top.Children.Add(_pin);
        var more = new Button { Content = "\u2026" };
        var quitItem = new MenuItem { Header = "Quit" }; quitItem.Click += (_, _) => Quit();
        more.Flyout = new MenuFlyout { Items = { quitItem } }; top.Children.Add(more);
        DockPanel.SetDock(top, Dock.Top); content.Children.Add(top);
        var bottom = new DockPanel { Background = new SolidColorBrush(Look.Default.CodePanel), LastChildFill = true };
        _count.Margin = new Thickness(12, 5); _count.Foreground = new SolidColorBrush(Look.Default.Muted);
        var hint = new TextBlock { Text = Environment.GetEnvironmentVariable("ANTIQUICKPAD_HOTKEY") ?? "Ctrl+Alt+Shift+A � Esc hide",
            FontSize = Look.Default.StatusSize, Foreground = new SolidColorBrush(Look.Default.Muted), Margin = new Thickness(8, 5) };
        DockPanel.SetDock(_count, Dock.Left); bottom.Children.Add(_count);
        DockPanel.SetDock(hint, Dock.Right); bottom.Children.Add(hint); bottom.Children.Add(_status);
        DockPanel.SetDock(bottom, Dock.Bottom); content.Children.Add(bottom); content.Children.Add(_carousel.View);
        _frame.Child = content; _frame.BorderThickness = new Thickness(Look.Default.BorderSize);
        _frame.BorderBrush = new SolidColorBrush(Look.Default.Muted); Content = _frame;
        BindCurrent();
        _editor.TextChanged += (_, _) => ScheduleSave();
        _editor.TextArea.Caret.PositionChanged += (_, _) => ScheduleSave();
        _editor.TextArea.GotFocus += (_, _) => CompleteFocus();
        _autosave.Tick += (_, _) => SaveNotes();
        _cue.Tick += (_, _) => { _cue.Stop(); _frame.BorderBrush = new SolidColorBrush(Look.Default.Muted); };
        AddHandler(KeyDownEvent, OnKeyDown, RoutingStrategies.Tunnel, true);
        Opened += (_, _) => InitializeResident();
        SizeChanged += (_, _) => RememberNormalBounds();
        PositionChanged += (_, _) => RememberNormalBounds();
        Activated += (_, _) => Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        Closing += (_, e) => { if (!_quitting) { e.Cancel = true; HideResident(); } };
        Deactivated += (_, _) => _carousel.Cancel();
        Closed += (_, _) => { _carousel.Cancel(); _autosave.Stop(); _cue.Stop(); _hotkey?.Dispose(); _tray?.Dispose(); if (_quitting) Log("quit-finish window-closed=true"); _log.Dispose(); };
    }

    private void InitializeResident()
    {
        if (_initialized) return;
        _initialized = true;
        // The selftest does not claim the real hotkey or affect an existing resident app.
        if (!Program.SelfTest)
        {
            InstallHotkey();
            SetupTray();
        }
        _showStarted = Stopwatch.GetTimestamp();
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
        if (Program.SelfTest) Dispatcher.UIThread.Post(async () => await RunSelfTest(), DispatcherPriority.Background);
    }

    private void InstallHotkey()
    {
        try
        {
            _hotkey = new GlobalHotkey(this, timestamp => Toggle(timestamp));
            Log($"hotkey gesture={_hotkey.GestureLabel} registered={_hotkey.IsRegistered} error={_hotkey.RegistrationError} {_hotkey.RegistrationErrorMessage}");
        }
        catch (FormatException ex) { Log($"hotkey-configuration-error {ex.Message}"); }
    }

    public void Toggle(long started = 0)
    {
        if (IsVisible) HideResident(); else ShowResident("toggle", started);
    }

    public void ShowResident(string source, long started = 0)
    {
        _showStarted = started == 0 ? Stopwatch.GetTimestamp() : started; _showSource = source;
        WindowState = WindowState.Normal; Show(); Activate();
        _frame.BorderBrush = new SolidColorBrush(Look.Default.Accent); _cue.Stop(); _cue.Start();
        FocusEditor();
        Dispatcher.UIThread.Post(FocusEditor, DispatcherPriority.Input);
    }

    public void HideResident()
    {
        _carousel.Cancel();
        if (!SaveNotes()) return;
        _showStarted = 0; Hide(); Log("hidden resident=true");
    }

    private void FocusEditor()
    {
        if (!IsVisible) return;
        Activate(); _editor.TextArea.Focus(); CompleteFocus();
    }

    private void CompleteFocus()
    {
        if (_showStarted == 0 || !IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) return;
        LastShowToFocusMs = Stopwatch.GetElapsedTime(_showStarted).TotalMilliseconds;
        _showStarted = 0;
        Log($"show-to-focus source={_showSource} ms={LastShowToFocusMs:F3} focused=true");
        _focusCompletion?.TrySetResult(LastShowToFocusMs);
    }

    private void ScheduleSave()
    {
        if (_binding) return;
        _notes.UpdateCurrent(_editor.Text, _editor.CaretOffset);
        _saving = true; UpdateStatus();
        _autosave.Stop(); _autosave.Start();
    }

    private bool SaveNotes()
    {
        _autosave.Stop();
        try
        {
            _notes.UpdateCurrent(_editor.Text, _editor.CaretOffset); _notes.Save(); SaveWindowSettings();
            _saving = false;
            _saveFailed = false; _lastSaveError = null; UpdateStatus(); return true;
        }
        catch (Exception ex)
        {
            _saveFailed = true; _lastSaveError = ex.Message; UpdateStatus(); Log($"save-error {ex}"); return false;
        }
    }

    private void BindCurrent()
    {
        _binding = true;
        try { _editor.Text = _notes.Current.Text; _editor.CaretOffset = _notes.Current.CaretOffset; _editor.Document.UndoStack.ClearAll(); }
        finally { _binding = false; }
        var scroll = _scroll.GetValueOrDefault(_notes.Current.Id);
        EditorViewport.Restore(_editor, scroll);
        UpdateStatus();
    }

    private void RememberScroll() => _scroll[_notes.Current.Id] = _editor.TextArea.TextView.ScrollOffset;
    public void CreateNote() { _carousel.Cancel(); if (!SaveNotes()) return; RememberScroll(); _notes.CreateNote(); BindCurrent(); SaveNotes(); FocusEditor(); }
    public void DeleteCurrentNote()
    {
        _carousel.Cancel(); if (!SaveNotes()) return;
        var id = _notes.Current.Id;
        try { _notes.DeleteCurrent(); _scroll.Remove(id); BindCurrent(); FocusEditor(); }
        catch (Exception ex) { _saveFailed = true; UpdateStatus(); Log($"delete-error {ex}"); }
    }
    public void SelectNote(int index)
    {
        _carousel.Cancel(); if (!SaveNotes()) return;
        RememberScroll(); _notes.Select(index); BindCurrent(); SaveNotes(); FocusEditor();
    }
    private void ShowIndicator() => _count.Opacity = 1;
    private void UpdateStatus()
    {
        _count.Text = $"{_notes.CurrentIndex + 1} / {_notes.Notes.Count}";
        _status.Foreground = new SolidColorBrush(_saveFailed ? Look.Default.Accent : Look.Default.Muted);
        _status.Text = _saveFailed ? "Could not save. Check disk access." : _saving ? "Saving" : "Saved";
    }

    private sealed record WindowSettings(double Width, double Height, int X, int Y, bool Pinned);
    private void RestoreWindowSettings()
    {
        try
        {
            if (!File.Exists(Program.Paths.Settings)) return;
            var settings = JsonSerializer.Deserialize<WindowSettings>(File.ReadAllText(Program.Paths.Settings));
            if (settings is null || !double.IsFinite(settings.Width) || !double.IsFinite(settings.Height)) return;
            Width = Math.Max(MinWidth, settings.Width); Height = Math.Max(MinHeight, settings.Height);
            Position = new PixelPoint(settings.X, settings.Y); WindowStartupLocation = WindowStartupLocation.Manual;
            Topmost = settings.Pinned;
        }
        catch (Exception ex) { System.Diagnostics.Trace.WriteLine($"window-settings-load: {ex.Message}"); }
    }
    private void RememberNormalBounds()
    {
        if (_initialized && WindowState == WindowState.Normal && IsVisible)
            _normalSettings = new WindowSettings(Width, Height, Position.X, Position.Y, Topmost);
    }
    private void SaveWindowSettings()
    {
        RememberNormalBounds();
        var settings = (_normalSettings ?? new WindowSettings(Width, Height, Position.X, Position.Y, Topmost)) with { Pinned = Topmost };
        var temp = Program.Paths.Settings + ".tmp";
        File.WriteAllText(temp, JsonSerializer.Serialize(settings)); File.Move(temp, Program.Paths.Settings, true);
    }
    private void SetPinned(bool pinned)
    {
        Topmost = pinned;
        try { SaveWindowSettings(); }
        catch (Exception ex) { Log($"window-settings-save-error {ex}"); }
    }

    public void Quit(int exitCode = 0)
    {
        Log("quit-start");
        _carousel.Cancel();
        if (!SaveNotes())
        {
            Log($"quit-aborted save-failed reason={_lastSaveError}");
            ShowResident("quit-save-failed");
            UpdateStatus();
            return;
        }
        _quitting = true; Close();
        (Application.Current!.ApplicationLifetime as IClassicDesktopStyleApplicationLifetime)!.Shutdown(exitCode);
    }

    private void OnKeyDown(object? sender, KeyEventArgs e)
    {
        if (e.Key == Key.Escape) { HideResident(); e.Handled = true; }
        else if (e.Key == Key.N && e.KeyModifiers == KeyModifiers.Control) { CreateNote(); e.Handled = true; }
        else if (e.Key == Key.Delete && e.KeyModifiers == (KeyModifiers.Control | KeyModifiers.Shift)) { DeleteCurrentNote(); e.Handled = true; }
    }

    private void SetupTray()
    {
        var menu = new NativeMenu();
        var toggle = new NativeMenuItem("Show / Hide"); toggle.Click += (_, _) => Toggle(); menu.Items.Add(toggle);
        var quit = new NativeMenuItem("Quit"); quit.Click += (_, _) => Quit(); menu.Items.Add(quit);
        var hotkeyStatus = _hotkey is { IsRegistered: true } ? _hotkey.GestureLabel : "hotkey unavailable; see log";
        _tray = new TrayIcon { ToolTipText = $"AntiQuickPad · {hotkeyStatus}", Icon = CreateTrayIcon(), Menu = menu, IsVisible = true };
        _tray.Clicked += (_, _) => ShowResident("tray");
        TrayIcon.SetIcons(Application.Current!, new TrayIcons { _tray });
    }

    private static WindowIcon CreateTrayIcon()
    {
        using var stream = new MemoryStream(); using var writer = new BinaryWriter(stream);
        writer.Write((ushort)0); writer.Write((ushort)1); writer.Write((ushort)1);
        writer.Write((byte)16); writer.Write((byte)16); writer.Write((byte)0); writer.Write((byte)0);
        writer.Write((ushort)1); writer.Write((ushort)32); writer.Write(40 + 16 * 16 * 4 + 64); writer.Write(22);
        writer.Write(40); writer.Write(16); writer.Write(32); writer.Write((ushort)1); writer.Write((ushort)32);
        writer.Write(0); writer.Write(16 * 16 * 4); writer.Write(0); writer.Write(0); writer.Write(0); writer.Write(0);
        var color = Look.Default.Accent;
        for (var i = 0; i < 256; i++) { writer.Write(color.B); writer.Write(color.G); writer.Write(color.R); writer.Write((byte)255); }
        writer.Write(new byte[64]); stream.Position = 0; return new WindowIcon(stream);
    }

    private async Task RunSelfTest()
    {
        var exitCode = 1;
        try
        {
            EditorFactory.RunSmoke();
            if (WindowDecorations != WindowDecorations.Full || Topmost) throw new Exception("Standard chrome/default pin failed.");
            _pin.IsChecked = true;
            if (!Topmost || !JsonSerializer.Deserialize<WindowSettings>(File.ReadAllText(Program.Paths.Settings))!.Pinned) throw new Exception("Pin on/persistence failed.");
            WindowState = WindowState.Maximized;
            _pin.IsChecked = false;
            if (Topmost || JsonSerializer.Deserialize<WindowSettings>(File.ReadAllText(Program.Paths.Settings))!.Pinned) throw new Exception("Pin off/persistence failed.");
            WindowState = WindowState.Normal;
            var expectedPosition = Position; var expectedWidth = Width; var expectedHeight = Height;
            SaveWindowSettings(); Width += 20; Height += 20; RestoreWindowSettings();
            if (Width != expectedWidth || Height != expectedHeight || Position != expectedPosition) throw new Exception("Window bounds round trip failed.");
            Close();
            if (IsVisible || _quitting) throw new Exception("Close must hide the resident window.");
            ShowResident("selftest-close");
            Console.WriteLine("T007 chrome PASS: Close hides; Pin toggles Topmost and persists; bounds round trip.");
            await Task.Delay(200);
            if (!IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) throw new Exception("Startup editor focus failed.");
            _editor.Text = "# Heading one\n## Heading two\n### Three\n#### Four\n##### Five\n###### Six\n**bold** *italic* ~~strike~~\n- [ ] todo\n- [x] done\n```python\ndef note():\n    return '# string' # comment\n```\n";
            await Task.Delay(80); // Exercise real visual-line generation, inline controls and code background.
            _editor.TextArea.TextView.EnsureVisualLines();
            if (_editor.TextArea.TextView.VisualLines.Count == 0) throw new Exception("Decorated fixture did not lay out.");
            Console.WriteLine("M3 PASS: Markdown classification; undoable checkbox text edit; Shift+Tab; decorated visual lines.");
            await StrikeProof.Run(_editor, Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "../../../../../.coord/reports/T-008-strike.png")));
            await AlignmentProof.Run(_editor, Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "../../../../../.coord/reports")));
            _editor.Text = "";
            var originalEditor = _editor;
            var timings = new List<double>();
            for (var i = 0; i < 3; i++)
            {
                Toggle(); if (IsVisible) throw new Exception("Toggle did not hide.");
                await Task.Delay(40);
                _focusCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
                Toggle(Stopwatch.GetTimestamp());
                timings.Add(await _focusCompletion.Task.WaitAsync(TimeSpan.FromSeconds(3)));
                if (!ReferenceEquals(originalEditor, _editor) || !_editor.TextArea.IsKeyboardFocusWithin)
                    throw new Exception("Resident editor was recreated or not focused.");
            }
            CreateNote(); _editor.Text = "# editor round trip\nsecond line"; _editor.CaretOffset = 7;
            await Task.Delay(550); // Let the real debounce timer persist the edit and caret.
            var reload = new NotesSession(Program.Paths.Notes);
            if (reload.Current.Text != _editor.Text || reload.Current.CaretOffset != 7 || reload.CurrentIndex != 1)
                throw new Exception("Editor round trip failed.");
            if (!NotesSession.RunPersistenceSmoke(Program.Paths.Root)) throw new Exception("Persistence smoke failed.");
            await RunChild("--selftest-reload", Program.Paths.Notes);
            await RunCarouselSmoke();
            Toggle();
            var signalId = "AntiQuickPad-selftest-" + Guid.NewGuid().ToString("N");
            var signal = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _focusCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            using (var singleton = new SingleInstanceService(() => Dispatcher.UIThread.Post(() =>
            {
                ShowResident("selftest-second-launch"); signal.TrySetResult();
            }), signalId))
            {
                if (!singleton.IsPrimary) throw new Exception("Isolated singleton was not primary.");
                await RunChild("--selftest-signal", signalId);
                await signal.Task.WaitAsync(TimeSpan.FromSeconds(3));
                await _focusCompletion.Task.WaitAsync(TimeSpan.FromSeconds(3));
            }
            if (!IsVisible || !_editor.TextArea.IsKeyboardFocusWithin) throw new Exception("Second-launch show/focus failed.");
            foreach (var ms in timings) Console.WriteLine($"show-to-focus internal ms={ms:F3}");
            if (timings.Any(ms => ms >= 100)) throw new Exception("Internal show-to-focus exceeded 100 ms.");
            // Lock the manifest to exercise the actual SaveNotes/Quit failure path without touching user notes.
            using (var locked = new FileStream(Path.Combine(Program.Paths.Notes, "notes.json"), FileMode.Open, FileAccess.Read, FileShare.None))
            {
                Hide(); Quit();
                using var logReader = new StreamReader(new FileStream(Program.Paths.Log, FileMode.Open, FileAccess.Read, FileShare.ReadWrite));
                var log = logReader.ReadToEnd();
                if (_quitting || !IsVisible || !_saveFailed || !_status.Text!.StartsWith("Could not save") ||
                    !log.Contains("quit-start") || !log.Contains("quit-aborted save-failed reason=") || !log.Contains("save-error"))
                    throw new Exception("Quit save-failure visibility/logging failed.");
            }
            Console.WriteLine("T006 PASS: heading boundaries; list Enter/undo; quit failure restores visible status and logs reason.");
            Console.WriteLine("SELFTEST PASS: same resident editor; toggle/focus; debounced save; next-process reload; second-process signal/show; notes round trip.");
            Log("SELFTEST PASS"); exitCode = 0;
        }
        catch (Exception ex) { Console.Error.WriteLine($"SELFTEST FAIL: {ex}"); Log($"SELFTEST FAIL: {ex}"); }
        finally
        {
            Quit(exitCode);
        }
    }
    private async Task RunCarouselSmoke()
    {
        CarouselController.RunSmoke();
        CreateNote(); SelectNote(0);
        _carousel.RequestWheel(1, 0);
        for (var t = 20; t <= 180; t += 20) _carousel.RequestWheel(1, t);
        await Task.Delay(300);
        _carousel.RequestWheel(1, 250); // trailing event of the same burst, after animation
        await Task.Delay(60);
        if (_notes.CurrentIndex != 1 || _carousel.IsBusy) throw new Exception("Integrated wheel notch/burst double skip.");
        var width = _carousel.View.Bounds.Width;
        _carousel.BeginDrag(0, 1000); _carousel.MoveDrag(-width * .6, 2000);
        if (Math.Abs(((TranslateTransform)_editor.RenderTransform!).X + width * .6) > 1)
            throw new Exception("Drag was not 1:1.");
        _carousel.EndDrag(2100); await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated long drag did not snap to next note.");
        _carousel.BeginDrag(0, 3000); _carousel.MoveDrag(20, 3100); _carousel.EndDrag(3250);
        await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated short drag did not return.");
        _editor.Text = string.Join('\n', Enumerable.Range(0, 120).Select(i => $"Line {i} saved scroll"));
        _editor.CaretOffset = 7; await Task.Delay(60);
        _editor.UpdateLayout(); _editor.TextArea.TextView.EnsureVisualLines();
        EditorViewport.Restore(_editor, new Vector(0, 300));
        await Task.Delay(120);
        var saved = _editor.VerticalOffset;
        SelectNote(1); SelectNote(2); await Task.Delay(60);
        if (_editor.CaretOffset != 7 || saved < 100 || Math.Abs(_editor.VerticalOffset - saved) > 1)
            throw new Exception($"Caret/scroll restore failed: caret={_editor.CaretOffset} scroll={_editor.VerticalOffset} expected={saved} editor={_editor.Bounds} documentHeight={_editor.TextArea.TextView.DocumentHeight}.");
        _carousel.BeginDrag(0, 4000); _carousel.MoveDrag(40, 4100); _carousel.Cancel();
        if (_carousel.IsBusy || _editor.IsReadOnly || ((TranslateTransform)_editor.RenderTransform!).X != 0)
            throw new Exception("Drag cancellation failed.");
        DeleteCurrentNote(); DeleteCurrentNote(); DeleteCurrentNote();
        if (_notes.Notes.Count != 1) throw new Exception("Delete must keep one note.");
        Console.WriteLine("M4 PASS: integrated notch/burst; 1:1 drag; long/short snap; caret/scroll; cancellation; delete keeps one note.");
    }
    private static async Task RunChild(string mode, string argument)
    {
        var executable = Environment.ProcessPath!;
        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = true };
        if (string.Equals(Path.GetFileNameWithoutExtension(executable), "dotnet", StringComparison.OrdinalIgnoreCase))
            start.ArgumentList.Add(typeof(Program).Assembly.Location);
        start.ArgumentList.Add(mode); start.ArgumentList.Add(argument);
        using var process = Process.Start(start) ?? throw new Exception("Could not start selftest child.");
        try { await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(5)); }
        catch { throw; }
        if (process.ExitCode != 0) throw new Exception($"{mode} child exit={process.ExitCode}");
    }
    private void Log(string message) => _log.WriteLine($"{DateTimeOffset.UtcNow:O} {message}");
}
