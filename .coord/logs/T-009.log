                if (raster[i]>baseline[i] && raster[i+1]>baseline[i+1] && raster[i+2]>baseline[i+2]) bright++;
            }
            if(changed==0 || bright!=changed || other!=0) throw new Exception($"Active pixels line={fixture.Line}: changed={changed}, brighter={bright}, outside={other}");
            var ySample=(int)(origin.Y+ys[0].VisualTop-view.VerticalOffset+8);
            var sample=(ySample*size.Width+xGuide)*4;
            Console.WriteLine($"T009 active line={fixture.Line} column={fixture.Level*4} block={fixture.First}-{fixture.Last} x={xGuide}: brighter={bright} pixels, other-guide/outside changes={other}; RGB {baseline[sample+2]},{baseline[sample+1]},{baseline[sample]} -> {raster[sample+2]},{raster[sample+1]},{raster[sample]}.");
