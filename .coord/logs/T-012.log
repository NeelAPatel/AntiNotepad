using System.Diagnostics;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media;
using Avalonia.Threading;
using AvaloniaEdit;
using AntiQuickPad.Editor;

namespace AntiQuickPad.Carousel;

// A burst owns one destination for its entire animation and until 140ms idle.
// No accumulated wheel delta and no queued page requests: a notch cannot skip pages.
internal sealed class WheelGate
{
    private long _last = long.MinValue / 2;
    public int Request(double delta, long now, bool busy)
    {
        if (Math.Abs(delta) < .001) return 0;
        var fresh = now - _last > 140;
        _last = now;
        return !busy && fresh ? Math.Sign(delta) : 0;
    }
}

internal sealed class CarouselController
{
    public const double SlideMs = 220;
    private readonly TextEditor _editor, _preview;
    private readonly Func<int> _index, _count;
    private readonly Func<int, string> _text;
    private readonly Func<int, Vector> _scroll;
    private readonly Action<int> _select;
    private readonly Action _activity;
    private readonly Grid _viewport = new() { ClipToBounds = true };
    private readonly TranslateTransform _currentTransform = new(), _previewTransform = new();
    private readonly DispatcherTimer _timer = new() { Interval = TimeSpan.FromMilliseconds(16) };
    private readonly WheelGate _wheel = new();
    private readonly Stopwatch _clock = Stopwatch.StartNew();
    private readonly Border _grab;
    private long _started;
    private double _from, _to, _offset, _origin, _lastX, _lastMs, _velocity;
    private int _target, _previewIndex = -1;
    private bool _animating, _dragging;
    private IPointer? _pointer;
    public Control View { get; }
    public bool IsBusy => _animating || _dragging;
    private double PageWidth => Math.Max(1, _viewport.Bounds.Width);

    public CarouselController(TextEditor editor, Look look, Func<int> index, Func<int> count,
        Func<int, string> text, Func<int, Vector> scroll, Action<int> select, Action activity)
    {
        _editor = editor; _index = index; _count = count; _text = text; _scroll = scroll;
        _select = select; _activity = activity;
        _preview = EditorFactory.Create(look); _preview.IsReadOnly = true;
        _preview.IsHitTestVisible = false; _preview.Focusable = false; _preview.IsVisible = false;
        _editor.RenderTransform = _currentTransform; _preview.RenderTransform = _previewTransform;
        _viewport.Children.Add(_editor); _viewport.Children.Add(_preview);
        _grab = new Border
        {
            Height = look.GrabHeight, Background = new SolidColorBrush(look.Background),
            Cursor = new Cursor(StandardCursorType.SizeAll),
            Child = new TextBlock { Text = "···", Foreground = new SolidColorBrush(look.Muted),
                FontSize = look.StatusSize, FontFamily = new FontFamily(look.InterfaceFont),
                HorizontalAlignment = Avalonia.Layout.HorizontalAlignment.Center }
        };
        ToolTip.SetTip(_grab, "Drag sideways to change notes");
        var host = new DockPanel(); DockPanel.SetDock(_grab, Dock.Top);
        host.Children.Add(_grab); host.Children.Add(_viewport); View = host;
        host.AddHandler(InputElement.PointerWheelChangedEvent, Wheel, RoutingStrategies.Tunnel, true);
        _grab.PointerPressed += (_, e) =>
        {
            if (!e.GetCurrentPoint(_grab).Properties.IsLeftButtonPressed || _animating) return;
            BeginDrag(e.GetPosition(_grab).X, _clock.Elapsed.TotalMilliseconds);
            _pointer = e.Pointer; e.Pointer.Capture(_grab); e.Handled = true;
        };
        _grab.PointerMoved += (_, e) =>
        {
            if (!_dragging) return;
            MoveDrag(e.GetPosition(_grab).X, _clock.Elapsed.TotalMilliseconds); e.Handled = true;
        };
        _grab.PointerReleased += (_, e) =>
        {
            if (!_dragging) return;
            MoveDrag(e.GetPosition(_grab).X, _clock.Elapsed.TotalMilliseconds);
            EndDrag(_clock.Elapsed.TotalMilliseconds); ReleasePointer(); e.Handled = true;
        };
        _grab.PointerCaptureLost += (_, _) => { if (_dragging) Cancel(); };
        _viewport.SizeChanged += (_, _) => { if (IsBusy) Cancel(); };
        _timer.Tick += (_, _) => Animate();
    }

    private void Wheel(object? sender, PointerWheelEventArgs e)
    {
        var delta = Math.Abs(e.Delta.X) > .001 ? e.Delta.X :
            e.KeyModifiers.HasFlag(KeyModifiers.Shift) ? -e.Delta.Y : 0;
        if (Math.Abs(delta) < .001) return; // ordinary vertical editor scrolling
        RequestWheel(delta, (long)_clock.Elapsed.TotalMilliseconds); e.Handled = true;
    }

    public void RequestWheel(double delta, long now)
    {
        var step = _wheel.Request(delta, now, IsBusy);
        _activity();
        if (step == 0) return;
        var target = Math.Clamp(_index() + step, 0, _count() - 1);
        if (target == _index()) return;
        Prepare(target); StartAnimation(target);
    }

    public void BeginDrag(double x, double now)
    {
        if (_animating) return;
        _dragging = true; _origin = _lastX = x; _lastMs = now; _velocity = 0;
        _editor.IsReadOnly = true; _activity();
    }

    public void MoveDrag(double x, double now)
    {
        if (!_dragging) return;
        var elapsed = now - _lastMs;
        // Preserve the last movement sample on pointer release at the same position.
        if (Math.Abs(x - _lastX) > .01)
        {
            _velocity = (x - _lastX) / Math.Max(1, elapsed); _lastX = x; _lastMs = now;
        }
        var distance = Math.Clamp(x - _origin, -PageWidth, PageWidth);
        var direction = distance < 0 ? 1 : -1;
        var target = Math.Clamp(_index() + direction, 0, _count() - 1);
        if (target != _index()) Prepare(target);
        else { _preview.IsVisible = false; _previewIndex = -1; }
        SetOffset(target == _index() ? distance * .25 : distance);
    }

    public void EndDrag(double now)
    {
        if (!_dragging) return;
        _dragging = false;
        var velocity = now - _lastMs > 80 ? 0 : _velocity;
        var target = SnapIndex(_index(), _offset, velocity, PageWidth, _count());
        if (target != _index()) Prepare(target);
        StartAnimation(target);
    }

    public static int SnapIndex(int index, double offset, double velocity, double width, int count)
    {
        var direction = Math.Abs(velocity) >= .55 ? -Math.Sign(velocity) :
            Math.Abs(offset) >= width / 2 ? -Math.Sign(offset) : 0;
        return Math.Clamp(index + direction, 0, count - 1);
    }

    private void Prepare(int target)
    {
        if (_previewIndex == target && _preview.IsVisible) return;
        _previewIndex = target; _preview.Text = _text(target); _preview.CaretOffset = 0;
        _preview.Document.UndoStack.ClearAll();
        _preview.IsVisible = true;
        _preview.UpdateLayout();
        var scroll = _scroll(target);
        EditorViewport.Restore(_preview, scroll);
        SetOffset(_offset);
    }

    private void SetOffset(double offset)
    {
        _offset = offset; _currentTransform.X = offset;
        var direction = _previewIndex > _index() ? 1 : -1;
        _previewTransform.X = offset + direction * PageWidth;
    }

    private void StartAnimation(int target)
    {
        _target = target; _from = _offset;
        _to = target == _index() ? 0 : -Math.Sign(target - _index()) * PageWidth;
        _editor.IsReadOnly = true; _animating = true; _started = Stopwatch.GetTimestamp(); _timer.Start();
    }

    private void Animate()
    {
        var progress = Math.Clamp(Stopwatch.GetElapsedTime(_started).TotalMilliseconds / SlideMs, 0, 1);
        SetOffset(_from + (_to - _from) * (1 - Math.Pow(1 - progress, 3)));
        if (progress < 1) return;
        var target = _target; Cancel();
        if (target != _index()) _select(target);
        _activity();
    }

    private void ReleasePointer() { var pointer = _pointer; _pointer = null; pointer?.Capture(null); }
    public void Cancel()
    {
        _timer.Stop(); _animating = _dragging = false; ReleasePointer();
        _offset = 0; _currentTransform.X = _previewTransform.X = 0;
        _preview.IsVisible = false; _previewIndex = -1; _editor.IsReadOnly = false;
    }

    public static void RunSmoke()
    {
        var gate = new WheelGate(); var index = 1;
        index += gate.Request(1, 0, false);
        for (var t = 10; t <= 260; t += 10) index += gate.Request(1, t, t < 220);
        if (index != 2) throw new Exception("Wheel notch/burst skipped more than one note.");
        if (gate.Request(1, 450, false) != 1) throw new Exception("Next separate wheel burst lost.");
        if (SnapIndex(1, -450, 0, 800, 4) != 2 || SnapIndex(1, -30, 0, 800, 4) != 1 ||
            SnapIndex(1, -30, -.8, 800, 4) != 2 || SnapIndex(0, 450, 0, 800, 4) != 0)
            throw new Exception("Drag distance/velocity snap failed.");
    }
}

