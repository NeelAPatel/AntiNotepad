using Avalonia;
using Avalonia.Controls;
using Avalonia.Input;
using Avalonia.Media;
using AvaloniaEdit;
using AvaloniaEdit.Editing;
using AvaloniaEdit.Folding;

namespace AntiQuickPad.Design;

/// <summary>Compact fold controls drawn as chevrons in place of AvaloniaEdit's boxed markers.</summary>
internal sealed class ChevronMargin : AbstractMargin
{
    private const double MarginWidth = 16;
    private const double ChevronSize = 5;
    private const double HitRadius = 9;

    private readonly FoldingManager _foldingManager;
    private readonly Pen _pen;

    private ChevronMargin(FoldingManager foldingManager, IBrush brush)
    {
        _foldingManager = foldingManager;
        _pen = new Pen(brush, 1.5, lineCap: PenLineCap.Round, lineJoin: PenLineJoin.Round);
        Width = MarginWidth;
        Cursor = new Cursor(StandardCursorType.Hand);
        PointerPressed += OnPointerPressed;
    }

    /// <summary>Replaces the stock folding margin while preserving its installed folding manager.</summary>
    public static void Install(TextEditor editor, IBrush brush)
    {
        ArgumentNullException.ThrowIfNull(editor);
        ArgumentNullException.ThrowIfNull(brush);

        var margins = editor.TextArea.LeftMargins;
        var existingChevron = margins.OfType<ChevronMargin>().FirstOrDefault();
        if (existingChevron is not null)
        {
            var index = margins.IndexOf(existingChevron);
            margins[index] = new ChevronMargin(existingChevron._foldingManager, brush);
            return;
        }

        var firstStockIndex = -1;
        FoldingManager? foldingManager = null;
        for (var i = 0; i < margins.Count; i++)
        {
            if (margins[i] is not FoldingMargin stock) continue;
            if (firstStockIndex < 0) firstStockIndex = i;
            foldingManager ??= stock.FoldingManager;
        }

        // Install is idempotent only through the stock margin. If the caller has not
        // installed folding yet, create it here and then replace the generated margin.
        if (foldingManager is null)
        {
            foldingManager = FoldingManager.Install(editor.TextArea);
            firstStockIndex = margins.IndexOf(margins.OfType<FoldingMargin>().First());
        }

        for (var i = margins.Count - 1; i >= 0; i--)
            if (margins[i] is FoldingMargin) margins.RemoveAt(i);

        margins.Insert(Math.Clamp(firstStockIndex, 0, margins.Count), new ChevronMargin(foldingManager, brush));
    }

    protected override Size MeasureOverride(Size availableSize) => new(MarginWidth, 0);

    public override void Render(DrawingContext context)
    {
        base.Render(context);
        if (TextView is not { VisualLinesValid: true } view || view.Document is null) return;

        foreach (var folding in _foldingManager.AllFoldings)
        {
            var lineNumber = view.Document.GetLineByOffset(folding.StartOffset).LineNumber;
            var line = GetVisibleLine(view, lineNumber);
            if (line is null) continue;

            var center = new Point(Bounds.Width / 2, line.VisualTop - view.VerticalOffset + line.Height / 2);
            if (center.Y < 0 || center.Y > Bounds.Height) continue;
            DrawChevron(context, center, folding.IsFolded);
        }
    }

    private void DrawChevron(DrawingContext context, Point center, bool folded)
    {
        if (folded)
        {
            context.DrawLine(_pen, new Point(center.X - ChevronSize / 2, center.Y - ChevronSize),
                new Point(center.X + ChevronSize / 2, center.Y));
            context.DrawLine(_pen, new Point(center.X + ChevronSize / 2, center.Y),
                new Point(center.X - ChevronSize / 2, center.Y + ChevronSize));
        }
        else
        {
            context.DrawLine(_pen, new Point(center.X - ChevronSize, center.Y - ChevronSize / 2),
                new Point(center.X, center.Y + ChevronSize / 2));
            context.DrawLine(_pen, new Point(center.X, center.Y + ChevronSize / 2),
                new Point(center.X + ChevronSize, center.Y - ChevronSize / 2));
        }
    }

    private void OnPointerPressed(object? sender, PointerPressedEventArgs e)
    {
        if (!e.GetCurrentPoint(this).Properties.IsLeftButtonPressed || TextView is not { VisualLinesValid: true } view || view.Document is null)
            return;

        var y = e.GetPosition(this).Y;
        FoldingSection? target = null;
        var closestDistance = HitRadius;
        foreach (var folding in _foldingManager.AllFoldings)
        {
            var lineNumber = view.Document.GetLineByOffset(folding.StartOffset).LineNumber;
            var line = GetVisibleLine(view, lineNumber);
            if (line is null) continue;
            var centerY = line.VisualTop - view.VerticalOffset + line.Height / 2;
            var distance = Math.Abs(centerY - y);
            if (distance >= closestDistance) continue;
            closestDistance = distance;
            target = folding;
        }

        if (target is null) return;
        target.IsFolded = !target.IsFolded;
        e.Handled = true;
    }

    private static AvaloniaEdit.Rendering.VisualLine? GetVisibleLine(AvaloniaEdit.Rendering.TextView view, int lineNumber) =>
        view.VisualLines.FirstOrDefault(line => line.FirstDocumentLine.LineNumber <= lineNumber && line.LastDocumentLine.LineNumber >= lineNumber);
}
using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.ApplicationLifetimes;
using Avalonia.Media;
using Avalonia.Threading;

namespace AntiQuickPad.Design;

// Isolated from resident notes, hotkey, tray and single-instance ownership.
internal static class DesignEntry
{
    public static string[]? Arguments { get; private set; }
    public static int Run(string[] args)
    {
        Arguments = args;
        if (args[0] == "--render-design" && (args.Length != 3 || !new[] { "quiet", "card", "pro" }.Contains(args[1].ToLowerInvariant())))
        { Console.Error.WriteLine("Usage: --render-design <quiet|card|pro> <outdir>"); return 2; }
        if (args[0] == "--probe-backdrop" && (args.Length < 2 || !new[] { "none", "mica", "acrylic", "blur" }.Contains(args[1])))
        { Console.Error.WriteLine("Usage: --probe-backdrop <none|mica|acrylic|blur> [--report path] [--close-after-ms milliseconds]"); return 2; }
        return AppBuilder.Configure<App>().UsePlatformDetect().LogToTrace().StartWithClassicDesktopLifetime(args);
    }

    public static void Start(IClassicDesktopStyleApplicationLifetime desktop)
    {
        var args = Arguments!;
        if (args[0] == "--render-design")
        {
            var window = new DesignWindow(args[1].ToLowerInvariant());
            desktop.MainWindow = window;
            window.Opened += async (_, _) =>
            {
                try { await window.RenderStates(Path.GetFullPath(args[2])); window.Close(); desktop.Shutdown(0); }
                catch (Exception ex) { Console.Error.WriteLine(ex); desktop.Shutdown(1); }
            };
        }
        else
        {
            var mode = args[1];
            var level = mode switch { "mica" => WindowTransparencyLevel.Mica, "acrylic" => WindowTransparencyLevel.AcrylicBlur,
                "blur" => WindowTransparencyLevel.Blur, _ => WindowTransparencyLevel.None };
            var window = new Window
            {
                Title = $"AntiQuickPad · {mode} backdrop probe", Width = 800, Height = 600,
                WindowDecorations = WindowDecorations.Full,
                TransparencyLevelHint = new[] { level },
                Background = new SolidColorBrush(Color.Parse("#99171D25")),
                TransparencyBackgroundFallback = new SolidColorBrush(Color.Parse("#171D25")),
                Content = new StackPanel { Margin = new Thickness(48), Spacing = 18, Children = {
                    new TextBlock { Text = "Backdrop / " + mode, FontSize = 28, Foreground = Brushes.White },
                    new TextBlock { Text = "Move this window across a bright and dark desktop.\nCheck the background, text edges, resize and focus changes.\nClose this probe when finished.", FontSize = 17, Foreground = Brushes.White, LineHeight = 28 }
                }}
            };
            desktop.MainWindow = window;
            window.Opened += async (_, _) =>
            {
                await Task.Delay(800);
                var report = $"mode={mode}; requested={level}; actual={window.ActualTransparencyLevel}; OS={System.Runtime.InteropServices.RuntimeInformation.OSDescription}; Avalonia={typeof(Window).Assembly.GetName().Version}";
                ((StackPanel)window.Content!).Children.Add(new TextBlock { Text = report, TextWrapping = TextWrapping.Wrap, Foreground = Brushes.White });
                Console.WriteLine(report);
                var ri = Array.IndexOf(args, "--report");
                if (ri >= 0 && ri + 1 < args.Length) File.WriteAllText(Path.GetFullPath(args[ri + 1]), report + Environment.NewLine);
                var ci = Array.IndexOf(args, "--close-after-ms");
                if (ci >= 0 && ci + 1 < args.Length) { await Task.Delay(int.Parse(args[ci + 1])); window.Close(); }
            };
            window.Closed += (_, _) => desktop.Shutdown();
        }
    }
}
using Avalonia.Media;
namespace AntiQuickPad.Design;
internal sealed record DesignSpec(string Id, string Title, string Subtitle, string Surface, string Canvas, string Rule, Look Look)
{
    public static DesignSpec Get(string id)
    {
        static Color C(string hex) => Color.Parse(hex);
        return id switch
        {
            "quiet" => new(id, "Quiet", "A little room to think", "#FAFAF7", "#FAFAF7", "#E2E4DF",
                new Look("Quiet", C("#FAFAF7"), C("#29332F"), C("#758079"), C("#537864"), "Segoe UI Variable Text", "Segoe UI Variable Text", 17, false)
                { EditorPadding = 0, HeadingColors = [C("#29332F"), C("#3F5146"), C("#3F5146")], HeadingSizes = [30, 22, 19], MarkdownMarker = C("#9DA69F"),
                    CodeFont = "Cascadia Mono", CodePanel = C("#EEF0EB"), Keyword = C("#70578C"), String = C("#52765B"), Comment = C("#7E8880"),
                    CheckboxSize = 14, CheckboxRadius = 4, CheckboxStroke = 1.25, CheckboxCheck = C("#FFFFFF"), IndentGuide = C("#DDE2DC"), IndentGuideActive = C("#A1B5A5"), StrikeThicknessEm = .10 }),
            "card" => new(id, "Card", "Your thoughts, one at a time", "#F8FAFF", "#DEE5F0", "#D5DDEB",
                new Look("Card", C("#F8FAFF"), C("#283852"), C("#76849C"), C("#556CD2"), "Segoe UI Variable Text", "Segoe UI Variable Text", 16, false)
                { EditorPadding = 0, HeadingColors = [C("#283852"), C("#475B8B"), C("#475B8B")], HeadingSizes = [30, 22, 19], MarkdownMarker = C("#A0ABC0"),
                    CodeFont = "Cascadia Mono", CodePanel = C("#ECF0F9"), Keyword = C("#7955A2"), String = C("#47745A"), Comment = C("#79889D"),
                    CheckboxSize = 15, CheckboxRadius = 5, CheckboxStroke = 1.4, CheckboxCheck = C("#FFFFFF"), IndentGuide = C("#D6DEEF"), IndentGuideActive = C("#9BAADE"), StrikeThicknessEm = .10 }),
            _ => new("pro", "Pro", "Everything within reach", "#20252C", "#1A1E24", "#343B45",
                Look.Default with { Name = "Pro", EditorFont = "Consolas", CodeFont = "Consolas", Background = C("#20252C"), Foreground = C("#DCE2EA"), Muted = C("#8896A8"), Accent = C("#9BB8DB"),
                    FontSize = 15, EditorPadding = 0, ShowGutter = true, HeadingColors = [C("#E4EBF5"), C("#A9BCD6"), C("#A9BCD6")], HeadingSizes = [25, 20, 18],
                    CodePanel = C("#272F39"), CheckboxSize = 13, CheckboxRadius = 3, CheckboxStroke = 1.2, IndentGuide = C("#37414F"), IndentGuideActive = C("#758BA9"), StrikeThicknessEm = .10 })
        };
    }
}



using Avalonia;
