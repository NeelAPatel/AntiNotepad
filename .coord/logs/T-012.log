using System.Diagnostics;
using System.Runtime.InteropServices;
using System.Text.Json;
using Avalonia.Controls;
using Avalonia.Threading;

namespace AntiQuickPad;

// The event stream is deliberately separate from the ordinary diagnostic log.
internal static class Measurement
{
    public static string? ChildRoot { get; private set; }
    public static string? InstanceId { get; private set; }
    public static bool IsChild => ChildRoot != null;
    private static StreamWriter? _events;
    private static DispatcherTimer? _commands;
    private static int _frameGeneration;
    public static long Now { get { QueryPerformanceCounter(out var value); return value; } }
    private static long Frequency { get { QueryPerformanceFrequency(out var value); return value; } }
    private static readonly JsonSerializerOptions Json = new() { WriteIndented = true };
    private sealed record Stamp(string Kind, long Qpc, string? Detail);

    public static void InitializeChild(string[] args)
    {
        if (!args.Contains("--measure-child")) return;
        ChildRoot = Path.GetFullPath(Value(args, "--data") ?? throw new ArgumentException("--data required"));
        InstanceId = Value(args, "--instance") ?? throw new ArgumentException("--instance required");
        Directory.CreateDirectory(ChildRoot);
        _events = new StreamWriter(new FileStream(Path.Combine(ChildRoot, "events.jsonl"), FileMode.Create, FileAccess.Write, FileShare.ReadWrite)) { AutoFlush = true };
        Event("child-main");
    }

    public static void Event(string kind, long qpc = 0, string? detail = null)
    {
        if (_events == null) return;
        var stamp = new Stamp(kind, qpc == 0 ? Now : qpc, detail);
        _events.WriteLine(JsonSerializer.Serialize(stamp));
    }

    public static bool IsForeground(Window window) => GetForegroundWindow() == window.TryGetPlatformHandle()?.Handle;

    public static void Frame(Window window)
    {
        if (!IsChild) return;
        var generation = ++_frameGeneration;
        window.RequestAnimationFrame(_ =>
        {
            if (generation == _frameGeneration && window.IsVisible) Event("frame");
        });
    }

    public static void Attach(MainWindow window, bool registered, double scale)
    {
        Event("ready", detail: $"hotkey={registered};scale={scale}");
        Frame(window);
        _commands = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(50) };
        _commands.Tick += (_, _) =>
        {
            var path = Path.Combine(ChildRoot!, "command");
            if (!File.Exists(path)) return;
            var command = File.ReadAllText(path); File.Delete(path);
            switch (command)
            {
                case "hide": window.HideResident(); break;
                case "show": window.ShowResident("measure-control"); break;
                case "heavy": window.MeasurementHeavy(); break;
                case "quit": window.Quit(source: "command"); return;
            }
            Event("ack", detail: command);
        };
        _commands.Start();
        // Graceful safety exit if the harness disappears; never terminate a process.
        var watchdog = new DispatcherTimer { Interval = TimeSpan.FromMinutes(10) };
        watchdog.Tick += (_, _) => { watchdog.Stop(); window.Quit(source: "command"); };
        watchdog.Start();
    }

    private static string? Value(string[] args, string flag)
    {
        var i = Array.IndexOf(args, flag);
        if (i < 0) return null;
        if (i + 1 == args.Length) throw new ArgumentException($"{flag} needs a value");
        return args[i + 1];
    }
    private static ProcessStartInfo StartInfo(params string[] args)
    {
        // Always use the Release apphost, even when the harness was invoked via dotnet.
        var start = new ProcessStartInfo(Path.Combine(AppContext.BaseDirectory, "AntiQuickPad.exe"))
        { UseShellExecute = false, CreateNoWindow = true };
        foreach (var arg in args) start.ArgumentList.Add(arg);
        start.Environment["ANTIQUICKPAD_HOTKEY"] = "Ctrl+Alt+F9";
        return start;
    }
    private static List<Stamp> Read(string root)
    {
        var result = new List<Stamp>();
        var file = Path.Combine(root, "events.jsonl");
        if (!File.Exists(file)) return result;
        using var reader = new StreamReader(new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite));
        while (reader.ReadLine() is { } line)
        {
            try { if (JsonSerializer.Deserialize<Stamp>(line) is { } stamp) result.Add(stamp); }
            catch (JsonException) { /* Writer may be completing the final line. */ }
        }
        return result;
    }
    private static async Task<Stamp?> Wait(string root, Process child, string kind, long after, int timeout = 3000, string? detail = null)
    {
        var timer = Stopwatch.StartNew();
        while (!child.HasExited && timer.ElapsedMilliseconds < timeout)
        {
            var found = Read(root).FirstOrDefault(e => e.Kind == kind && e.Qpc > after && (detail == null || e.Detail == detail));
            if (found != null) return found;
            await Task.Delay(10);
        }
        return null;
    }
    private static async Task Command(string root, Process child, string command)
    {
        var before = Now;
        var path = Path.Combine(root, "command");
        File.WriteAllText(path + ".tmp", command); File.Move(path + ".tmp", path, true);
        if (command != "quit" && await Wait(root, child, "ack", before, detail: command) == null)
            throw new IOException($"Child control '{command}' timed out (exited={child.HasExited}).");
    }

    private sealed record Sample(int Index, bool Warmup, long InputQpc, uint Sent, int SendError,
        double? HotkeyMs, double? FocusMs, double? FrameCallbackMs, long? EscapeQpc, uint EscapeSent, int EscapeError, double? HideMs);
    private static double Ms(long start, long end) => (end - start) * 1000.0 / Frequency;
    private static double? Delta(long start, Stamp? end) => end == null ? null : Ms(start, end.Qpc);

    private static async Task<List<Sample>> Samples(string root, Process child, int count, List<string> gaps)
    {
        var samples = new List<Sample>();
        await Command(root, child, "hide");
        for (var i = 0; i < count; i++)
        {
            await Task.Delay(300);
            var chord = Inputs(0x11, 0x12, 0x78);
            var input = Now;
            var sent = SendInput((uint)chord.Length, chord, Marshal.SizeOf<Input>());
            var error = sent == chord.Length ? 0 : Marshal.GetLastWin32Error();
            var hotkey = await Wait(root, child, "hotkey", input);
            var focused = hotkey == null ? null : await Wait(root, child, "focused", input);
            var frame = hotkey == null ? null : await Wait(root, child, "frame", input);
            long? escape = null; uint escapeSent = 0; int escapeError = 0; Stamp? hidden = null;
            if (focused != null)
            {
                var keys = Inputs(0x1B); escape = Now;
                escapeSent = SendInput((uint)keys.Length, keys, Marshal.SizeOf<Input>());
                escapeError = escapeSent == keys.Length ? 0 : Marshal.GetLastWin32Error();
                hidden = await Wait(root, child, "hidden", escape.Value);
            }
            samples.Add(new(i, i < 3, input, sent, error, Delta(input, hotkey), Delta(input, focused), Delta(input, frame),
                escape, escapeSent, escapeError, escape == null ? null : Delta(escape.Value, hidden)));
            if (hotkey == null || focused == null || frame == null || hidden == null)
            {
                gaps.Add($"Sample {i}: SendInput={sent}/{chord.Length}, error={error}; WM_HOTKEY={hotkey != null}, foreground editor focus={focused != null}, frame callback={frame != null}, Esc hidden={hidden != null}. Missing endpoints are unavailable, not zero. UIPI can block input without a diagnostic last-error.");
                await Command(root, child, "hide");
                if (hotkey == null || focused == null) break; // Repeating blocked desktop input yields no useful baseline.
            }
        }
        return samples;
    }

    private static object? Summary(IEnumerable<double?> values)
    {
        var sorted = values.Where(v => v.HasValue).Select(v => v!.Value).Order().ToArray();
        if (sorted.Length == 0) return null;
        return new { count = sorted.Length, min = sorted[0], median = (sorted[(sorted.Length - 1) / 2] + sorted[sorted.Length / 2]) / 2,
            p95 = sorted[(int)Math.Ceiling(sorted.Length * .95) - 1], max = sorted[^1] };
    }
    private static object Summaries(List<Sample> samples)
    {
        var kept = samples.Where(s => !s.Warmup).ToArray();
        return new { hotkeyMs = Summary(kept.Select(s => s.HotkeyMs)), focusMs = Summary(kept.Select(s => s.FocusMs)),
            frameCallbackMs = Summary(kept.Select(s => s.FrameCallbackMs)), hideMs = Summary(kept.Select(s => s.HideMs)),
            visibleAndFocusedMs = Summary(kept.Select(s => s.FocusMs.HasValue && s.FrameCallbackMs.HasValue ? Math.Max(s.FocusMs.Value, s.FrameCallbackMs.Value) : (double?)null)) };
    }

    private static async Task<object> Idle(string root, Process child, bool shown)
    {
        await Command(root, child, shown ? "show" : "hide");
        await Task.Delay(1000); // settle autosave/cue; excluded from CPU window
        child.Refresh(); var cpu = child.TotalProcessorTime; var start = Now;
        await Task.Delay(30000);
        child.Refresh(); var elapsed = Ms(start, Now);
        return new { shown, elapsedMs = elapsed, cpuPercentOneCore = (child.TotalProcessorTime - cpu).TotalMilliseconds / elapsed * 100,
            workingSetBytes = child.WorkingSet64, privateBytes = child.PrivateMemorySize64 };
    }

    public static async Task<int> Run(string[] args)
    {
        var gaps = new List<string>();
        var requestedSamples = 30;
        var output = Path.GetFullPath(Value(args, "--out") ?? Path.Combine(AppContext.BaseDirectory, "measure.json"));
        var root = Path.Combine(AppContext.BaseDirectory, "measure", Guid.NewGuid().ToString("N"));
        var id = "AntiQuickPad-measure-" + Guid.NewGuid().ToString("N");
        Process? child = null; object? baseline = null, heavy = null; double? cold = null; string? ready = null;
        var success = true;
        try
        {
            var count = int.Parse(Value(args, "--samples") ?? "30");
            requestedSamples = count;
            if (count is < 1 or > 10000) throw new ArgumentException("--samples must be 1..10000 (first 3 are warmups per state).");
            Directory.CreateDirectory(root);
            var start = Now;
            child = Process.Start(StartInfo("--measure-child", "--instance", id, "--data", root)) ?? throw new IOException("Child launch failed");
            ready = (await Wait(root, child, "ready", start, 15000))?.Detail;
            cold = Delta(start, await Wait(root, child, "frame", start));
            if (ready == null) throw new IOException($"Child never became ready; exited={child.HasExited}.");
            if (!ready.Contains("hotkey=True")) gaps.Add("Alternate Ctrl+Alt+F9 registration failed; inspect child shell.log for Win32 error.");
            var first = await Samples(root, child, count, gaps);
            baseline = new { samples = first, summary = Summaries(first), hiddenIdle = await Idle(root, child, false), shownIdle = await Idle(root, child, true) };
            await Command(root, child, "heavy");
            var second = await Samples(root, child, count, gaps);
            heavy = new { notes = 20, linesPerNote = 200, samples = second, summary = Summaries(second), hiddenIdle = await Idle(root, child, false), shownIdle = await Idle(root, child, true) };
        }
        catch (Exception ex) { gaps.Add(ex.ToString()); success = false; }
        finally
        {
            if (child != null)
            {
                if (!child.HasExited)
                {
                    try { await Command(root, child, "quit"); await child.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(6)); }
                    catch (Exception ex) { gaps.Add("Graceful cleanup failed; child has 10-minute graceful watchdog: " + ex.Message); success = false; }
                }
                if (child.HasExited && child.ExitCode != 0) { gaps.Add($"Child exit={child.ExitCode}"); success = false; }
                child.Dispose();
            }
            Directory.CreateDirectory(Path.GetDirectoryName(output)!);
            File.WriteAllText(output, JsonSerializer.Serialize(new { schema = 1, utc = DateTimeOffset.UtcNow, qpcFrequency = Frequency,
                os = RuntimeInformation.OSDescription, processors = Environment.ProcessorCount, framework = RuntimeInformation.FrameworkDescription,
                release = !IsDebug, requestedSamples, warmupsPerState = 3, minimumSpacingMs = 300, idleWindowSeconds = 30,
                childRoot = root, instance = id, ready, coldStartFrameCallbackMs = cold, baseline, heavy, gaps }, Json));
            Console.WriteLine($"MEASURE {(success ? "COMPLETE" : "INCOMPLETE")}: {output}; gaps={gaps.Count}");
        }
        return success ? 0 : 1;
    }
    private static bool IsDebug
    {
        get
        {
#if DEBUG
            return true;
#else
            return false;
#endif
        }
    }
    public static async Task Smoke(string parent)
    {
        var output = Path.Combine(parent, "measure-smoke.json");
        using var child = Process.Start(StartInfo("--measure", "--samples", "3", "--out", output)) ?? throw new IOException("Measure smoke launch failed");
        await child.WaitForExitAsync().WaitAsync(TimeSpan.FromMinutes(4));
        using var json = JsonDocument.Parse(File.ReadAllText(output));
        if (child.ExitCode != 0 || json.RootElement.GetProperty("baseline").ValueKind != JsonValueKind.Object ||
            json.RootElement.GetProperty("heavy").ValueKind != JsonValueKind.Object) throw new Exception("Measure smoke failed; inspect " + output);
        Console.WriteLine("T010 PASS: --measure --samples 3 wrote baseline/heavy JSON (unavailable desktop endpoints remain explicit gaps).");
    }

    // INPUT's union must include MOUSEINPUT size/alignment (40 bytes total on x64).
    [StructLayout(LayoutKind.Sequential)] private struct Input { public uint Type; public InputUnion Data; }
    [StructLayout(LayoutKind.Explicit)] private struct InputUnion
    {
        [FieldOffset(0)] public Keyboard Keyboard;
        [FieldOffset(0)] public Mouse Mouse;
    }
    [StructLayout(LayoutKind.Sequential)] private struct Keyboard { public ushort Key, Scan; public uint Flags, Time; public UIntPtr Extra; }
    [StructLayout(LayoutKind.Sequential)] private struct Mouse { public int X, Y; public uint Data, Flags, Time; public UIntPtr Extra; }
    private static Input[] Inputs(params ushort[] keys) => keys.Select(k => new Input { Type = 1, Data = new InputUnion { Keyboard = new Keyboard { Key = k } } })
        .Concat(keys.Reverse().Select(k => new Input { Type = 1, Data = new InputUnion { Keyboard = new Keyboard { Key = k, Flags = 2 } } })).ToArray();
    [DllImport("user32.dll", SetLastError = true)] private static extern uint SendInput(uint count, Input[] inputs, int size);
    [DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
    [DllImport("kernel32.dll")] private static extern bool QueryPerformanceCounter(out long value);
    [DllImport("kernel32.dll")] private static extern bool QueryPerformanceFrequency(out long value);
}
using System.Runtime.InteropServices;
using Avalonia;
using Avalonia.Media;
using Avalonia.Media.Imaging;
using Avalonia.Platform;
using AvaloniaEdit;
namespace AntiQuickPad.Editor;
internal static class ActiveGuideProof
{
    public static async Task Run(TextEditor editor, string output)
    {
        editor.Text = "- root\n    - child\n        - nested caret\n            - deeper\n        - sibling\n    - outside\n\n```python\ndef f():\n    if True:\n        return 1\n        return 2\n    return 0\n```\nend";
        editor.CaretOffset = 0; editor.ScrollToHome(); await Task.Delay(100); editor.UpdateLayout();
        var view = editor.TextArea.TextView; view.EnsureVisualLines();
        var guide = view.BackgroundRenderers.OfType<IndentGuideRenderer>().Single();
        var size = new PixelSize((int)Math.Ceiling(editor.Bounds.Width), (int)Math.Ceiling(editor.Bounds.Height));
        byte[] Capture()
        {
            using var bitmap = new RenderTargetBitmap(size, new Vector(96,96)); bitmap.Render(editor);
            var bytes = new byte[size.Width * size.Height * 4]; var ptr = Marshal.AllocHGlobal(bytes.Length);
            try { bitmap.CopyPixels(new PixelRect(size), ptr, bytes.Length, size.Width * 4); Marshal.Copy(ptr,bytes,0,bytes.Length); }
            finally { Marshal.FreeHGlobal(ptr); }
            return bytes;
        }
        editor.TextArea.Caret.Hide(); var baseline = Capture();
        var origin = view.TranslatePoint(default, editor)!.Value; var shots = new List<byte[]>();
        foreach (var f in new[] { (Line:3, First:3, Last:5), (Line:11, First:11, Last:12) })
        {
            editor.CaretOffset = editor.Document.GetLineByNumber(f.Line).EndOffset;
            await Task.Delay(80); editor.TextArea.Caret.Hide();
            var active = guide.ActiveBlock(editor.TextArea.Caret.Line);
            if (active != (2, f.First, f.Last)) throw new Exception($"Active block incorrect: {active}");
            var raster = Capture();
            var font = f.Line == 3 ? Look.Default.EditorFont : Look.Default.CodeFont;
            var spaces = new FormattedText("        ", System.Globalization.CultureInfo.InvariantCulture,
                FlowDirection.LeftToRight, new Typeface(new FontFamily(font)), editor.FontSize, Brushes.White).WidthIncludingTrailingWhitespace;
            var xGuide = (int)Math.Floor(origin.X + spaces);
            var ys = view.VisualLines.Where(v => v.FirstDocumentLine.LineNumber >= f.First && v.FirstDocumentLine.LineNumber <= f.Last).ToArray();
            var y0 = (int)Math.Floor(origin.Y + ys[0].VisualTop - view.VerticalOffset);
            var y1 = (int)Math.Ceiling(origin.Y + ys[^1].VisualTop + ys[^1].Height - view.VerticalOffset);
            int changed = 0, other = 0, bright = 0;
            for (var y=0;y<size.Height;y++) for(var x=0;x<size.Width;x++)
            {
                var i=(y*size.Width+x)*4;
                if (raster.AsSpan(i,4).SequenceEqual(baseline.AsSpan(i,4))) continue;
                if (Math.Abs(x-xGuide)>1 || y<y0 || y>=y1) { other++; continue; }
                changed++;
                if (raster[i]>baseline[i] && raster[i+1]>baseline[i+1] && raster[i+2]>baseline[i+2]) bright++;
            }
            if(changed==0 || bright!=changed || other!=0) throw new Exception($"Active pixels line={f.Line}: changed={changed}, brighter={bright}, outside={other}");
            var sample=((int)(origin.Y+ys[0].VisualTop-view.VerticalOffset+8)*size.Width+xGuide)*4;
            Console.WriteLine($"T009 active line={f.Line} column=8 block={f.First}-{f.Last} x={xGuide}: brighter={bright} pixels, other-guide/outside changes={other}; RGB {baseline[sample+2]},{baseline[sample+1]},{baseline[sample]} -> {raster[sample+2]},{raster[sample+1]},{raster[sample]}.");
            editor.TextArea.Caret.Show(); await Task.Delay(40); shots.Add(Capture()); editor.TextArea.Caret.Hide();
        }
        editor.CaretOffset=editor.Document.GetLineByNumber(15).Offset; await Task.Delay(80); editor.TextArea.Caret.Hide();
        if (guide.ActiveBlock(15).Level!=0 || !Capture().SequenceEqual(baseline)) throw new Exception("Unindented caret left active pixels.");
        using var combined = new WriteableBitmap(new PixelSize(size.Width*2,size.Height),new Vector(96,96),PixelFormat.Bgra8888,AlphaFormat.Premul);
        using (var buffer=combined.Lock())
            for (var y=0;y<size.Height;y++) for(var shot=0;shot<2;shot++)
                Marshal.Copy(shots[shot],y*size.Width*4,buffer.Address+y*buffer.RowBytes+shot*size.Width*4,size.Width*4);
        combined.Save(output, PngBitmapEncoderOptions.Default);
        Console.WriteLine($"T009 active PASS: unindented reset, exact block extent, unchanged other pixels; proof={output} size={size.Width*2}x{size.Height}.");
    }
}
using System.Runtime.InteropServices;
using Avalonia;
using Avalonia.Media.Imaging;
using AvaloniaEdit;
using AvaloniaEdit.Rendering;

namespace AntiQuickPad.Editor;

internal static class AlignmentProof
{
    public static async Task Run(TextEditor editor, string output)
    {
        var view = editor.TextArea.TextView;
        PixelSize size = default;
        byte[] Capture(string? name)
        {
            size = new PixelSize((int)Math.Ceiling(editor.Bounds.Width), (int)Math.Ceiling(editor.Bounds.Height));
            using var bitmap = new RenderTargetBitmap(size, new Vector(96, 96)); bitmap.Render(editor);
            if (name != null) bitmap.Save(Path.Combine(output, name), PngBitmapEncoderOptions.Default);
            var bytes = new byte[size.Width * size.Height * 4]; var ptr = Marshal.AllocHGlobal(bytes.Length);
            try { bitmap.CopyPixels(new PixelRect(size), ptr, bytes.Length, size.Width * 4); Marshal.Copy(ptr, bytes, 0, bytes.Length); }
            finally { Marshal.FreeHGlobal(ptr); }
            return bytes;
        }
        async Task Layout(string text)
        {
            editor.Text = text; editor.CaretOffset = 0; editor.ScrollToHome(); await Task.Delay(100);
            editor.UpdateLayout(); view.EnsureVisualLines(); editor.TextArea.Caret.Hide();
        }
        Rect Bounds(byte[] pixels, Rect region, Func<byte, byte, byte, bool> test)
        {
            var points = new List<Point>();
            for (var y = Math.Max(0, (int)Math.Floor(region.Top)); y < Math.Min(size.Height, Math.Ceiling(region.Bottom)); y++)
            for (var x = Math.Max(0, (int)Math.Floor(region.Left)); x < Math.Min(size.Width, Math.Ceiling(region.Right)); x++)
            { var i = (y * size.Width + x) * 4; if (test(pixels[i + 2], pixels[i + 1], pixels[i])) points.Add(new Point(x + .5, y + .5)); }
            if (points.Count == 0) throw new Exception("No fixture ink found.");
            return new Rect(new Point(points.Min(p => p.X) - .5, points.Min(p => p.Y) - .5), new Point(points.Max(p => p.X) + .5, points.Max(p => p.Y) + .5));
        }
        await Layout("- [ ] open\n- [x] done\n- plain\n    - [ ] nested\n        - [x] deep\n    - plain");
        var pixels = Capture("T-009-checkbox.png");
        var origin = view.TranslatePoint(default, editor)!.Value;
        var boxes = view.BackgroundRenderers.OfType<CheckboxRenderer>().Single().Boxes.ToArray();
        bool Accent(byte r, byte g, byte b) => Math.Abs(r - Look.Default.Accent.R) < 20 && Math.Abs(g - Look.Default.Accent.G) < 20 && Math.Abs(b - Look.Default.Accent.B) < 20;
        var bulletCentres = new List<double>();
        foreach (var item in boxes)
        {
            var box = item.Bounds.Translate(new Vector(origin.X, origin.Y));
            var isChecked = editor.Document.GetCharAt(item.Offset + 1) == 'x';
            var color = isChecked ? Look.Default.Accent : Look.Default.Muted;
            var ink = Bounds(pixels, box.Inflate(2), (r,g,b) => Math.Abs(r-color.R)<20 && Math.Abs(g-color.G)<20 && Math.Abs(b-color.B)<20);
            var line = editor.Document.GetLineByOffset(item.Offset);
            var visual = view.VisualLines.Single(v => v.FirstDocumentLine == line);
            var dashColumn = editor.Document.GetText(line).IndexOf('-');
            var dash = BackgroundGeometryBuilder.GetRectsForSegment(view, new AvaloniaEdit.Document.SimpleSegment(line.Offset + dashColumn, 1)).Single().Translate(new Vector(origin.X, origin.Y));
            var dashInk = Bounds(pixels, dash, Accent);
            bulletCentres.Add(dashInk.Center.Y);
            var delta = Math.Abs(ink.Center.Y - dashInk.Center.Y);
            if (delta > 1) throw new Exception($"Checkbox/bullet centre mismatch: {delta}");
            if (editor.Document.GetCharAt(item.Offset + 1) == 'x')
            {
                var check = Bounds(pixels, box.Deflate(2), (r,g,b) => r < 60 && g < 65 && b < 75);
                var dx = Math.Abs(check.Center.X - ink.Center.X); var dy = Math.Abs(check.Center.Y - ink.Center.Y);
                Console.WriteLine($"T008 checkbox line={line.LineNumber}: check centre delta=({dx:F2},{dy:F2})px box/bullet deltaY={delta:F2}px row={visual.Height:F3}");
                if (dx > 1 || dy > 1) throw new Exception("Check ink not centred.");
            }
            else Console.WriteLine($"T008 open line={line.LineNumber}: box/bullet deltaY={delta:F2}px row={visual.Height:F3}");
        }
        var heights = view.VisualLines.Select(v => v.Height).ToArray();
        if (heights.Max() - heights.Min() > .01) throw new Exception("Checkbox changed row height.");
        // Hit-test the rendered rectangle and exercise the same toggle operation used by pointer input.
        var hit = boxes[0]; var caret = editor.CaretOffset;
        EditorFactory.UpdateCursor(editor, hit.Bounds.Center);
        if (!ReferenceEquals(editor.Cursor, EditorFactory.CheckboxHand) || !EditorFactory.TryCheckboxAt(editor, hit.Bounds.Center, out var hitOffset) || hitOffset != hit.Offset)
            throw new Exception("Checkbox hover/hit failed.");
        EditorFactory.UpdateCursor(editor, new Point(view.Bounds.Width - 10, view.Bounds.Height - 10));
        if (ReferenceEquals(editor.Cursor, EditorFactory.CheckboxHand)) throw new Exception("Checkbox hover did not clear.");
        if (!hit.Bounds.Contains(hit.Bounds.Center) || EditorOperations.ToggleCheckbox(editor.Document, hit.Offset, ref caret) != "[x]") throw new Exception("Checkbox hit/toggle failed.");
        editor.Document.UndoStack.Undo();

        // A plain-row control compares actual bullet ink positions, rather than trusting layout heights.
        await Layout("- plain\n- plain\n- plain\n    - plain\n        - plain\n    - plain");
        var plainPixels = Capture(null);
        var controlDelta = 0.0;
        var iBullet = 0;
        foreach (var n in new[] {1,2,4,5})
        {
            var line = editor.Document.GetLineByNumber(n);
            var dashColumn = editor.Document.GetText(line).IndexOf('-');
            var region = BackgroundGeometryBuilder.GetRectsForSegment(view, new AvaloniaEdit.Document.SimpleSegment(line.Offset + dashColumn, 1)).Single().Translate(new Vector(origin.X,origin.Y));
            var y = Bounds(plainPixels, region, Accent).Center.Y;
            controlDelta = Math.Max(controlDelta, Math.Abs(y - bulletCentres[iBullet++]));
        }
        if (controlDelta != 0) throw new Exception("Checkbox/plain row pixel positions differ.");
        Console.WriteLine($"T008 row pixel control: max bullet-centre displacement vs all-plain rows={controlDelta:F2}px; hover/hit/undo PASS.");

        await Layout("- root\n    - child\n        - grandchild\n\n        - continued\n\n- outside\n    ```python\n    def f():\n        if True:\n            return 1\n\n        return 0\n    ```\n\n\t- tab\n\t\t- two tabs\n\nend");
        var guide = view.BackgroundRenderers.OfType<IndentGuideRenderer>().Single();
        var on = Capture("T-009-guides.png");
        view.BackgroundRenderers.Remove(guide); view.InvalidateLayer(KnownLayer.Background); await Task.Delay(80);
        var off = Capture(null);
        view.BackgroundRenderers.Add(guide); view.InvalidateLayer(KnownLayer.Background);
        origin = view.TranslatePoint(default, editor)!.Value;
        int[] depths = [0,1,2,2,2,0,0,1,1,2,3,2,2,1,0,1,2,0,0];
        foreach (var visual in view.VisualLines)
        {
            var n = visual.FirstDocumentLine.LineNumber; var expected = depths[n - 1];
            var columns = new HashSet<int>();
            var y0 = (int)Math.Ceiling(origin.Y + visual.VisualTop - view.VerticalOffset);
            for (var y = y0 + 2; y < y0 + (int)visual.Height - 2; y++)
            for (var x = (int)origin.X; x < size.Width; x++)
            { var i = (y * size.Width + x) * 4; if (Math.Abs(on[i] - off[i]) + Math.Abs(on[i+1] - off[i+1]) + Math.Abs(on[i+2] - off[i+2]) > 8) columns.Add(x); }
            var text = editor.Document.GetText(visual.FirstDocumentLine);
            // Independent font measurement for expected four-space stops, including the code face.
            var font = new Avalonia.Media.Typeface(new Avalonia.Media.FontFamily(n is >= 8 and <= 14 ? Look.Default.CodeFont : Look.Default.EditorFont));
            var spaces = new Avalonia.Media.FormattedText("    ", System.Globalization.CultureInfo.InvariantCulture, Avalonia.Media.FlowDirection.LeftToRight, font, editor.FontSize, Avalonia.Media.Brushes.White).WidthIncludingTrailingWhitespace;
            var xs = Enumerable.Range(1, expected).Select(k => (int)Math.Floor(origin.X + k * spaces)).ToArray();
            if (guide.Depth(n) != expected || columns.Count != expected || xs.Any(x => !columns.Any(c => Math.Abs(c - x) <= 1)))
                throw new Exception($"Guide pixels line {n}: expected {string.Join(',',xs)} actual {string.Join(',',columns)} depth={guide.Depth(n)}");
            Console.WriteLine($"T008 guides line={n} indentColumns={string.Join(',', Enumerable.Range(1,expected).Select(k=>k*4))} pixelX={string.Join(',',columns.Order())}");
        }
        // Off setting is exercised through the actual renderer using the same visual fixture.
        view.BackgroundRenderers.Remove(guide);
        var disabled = new IndentGuideRenderer(Look.Default with { ShowIndentGuides = false }, new MarkdownScanner(editor.Document));
        view.BackgroundRenderers.Add(disabled); view.InvalidateLayer(KnownLayer.Background); await Task.Delay(80);
        if (!Capture(null).SequenceEqual(off)) throw new Exception("Disabled guides still draw.");
        view.BackgroundRenderers.Remove(disabled); view.BackgroundRenderers.Add(guide);
        Console.WriteLine($"T008 PASS: checkbox rows all {heights[0]:F3} DIP; guide columns, blank continuation/end, tabs, code font and off setting verified; PNGs={output}");
    }
}

using System.Runtime.InteropServices;
using Avalonia;
using Avalonia.Media.Imaging;
using Avalonia.Media;
using AvaloniaEdit;
using AvaloniaEdit.Document;
using AvaloniaEdit.Rendering;

namespace AntiQuickPad.Editor;

internal static class StrikeProof
{
    public static async Task Run(TextEditor editor, string output)
    {
        editor.Text = "plain ~~strike~~ **~~bold strike~~** *~~italic strike~~*";
        editor.CaretOffset = 0;
        await Task.Delay(100);
        editor.UpdateLayout();
        var view = editor.TextArea.TextView;
        view.EnsureVisualLines();
        var size = new PixelSize((int)Math.Ceiling(editor.Bounds.Width), (int)Math.Ceiling(editor.Bounds.Height));
        byte[] Capture(string? path)
        {
            using var bitmap = new RenderTargetBitmap(size, new Vector(96, 96));
            bitmap.Render(editor);
            if (path is not null) bitmap.Save(path, PngBitmapEncoderOptions.Default);
            var bytes = new byte[size.Width * size.Height * 4];
            var ptr = Marshal.AllocHGlobal(bytes.Length);
            try { bitmap.CopyPixels(new PixelRect(size), ptr, bytes.Length, size.Width * 4); Marshal.Copy(ptr, bytes, 0, bytes.Length); }
            finally { Marshal.FreeHGlobal(ptr); }
            return bytes;
        }
        var visual = view.VisualLines.Single();
        foreach (var (offset, weight, style) in new[] {
            (0, FontWeight.Normal, FontStyle.Normal), (8, FontWeight.Normal, FontStyle.Normal),
            (20, FontWeight.Bold, FontStyle.Normal), (39, FontWeight.Normal, FontStyle.Italic) })
        {
            var props = visual.Elements.Single(e => e.RelativeTextOffset <= offset && e.RelativeTextOffset + e.DocumentLength > offset).TextRunProperties;
            if (props.Typeface.Weight != weight || props.Typeface.Style != style)
                throw new Exception($"Strike typeface mismatch at {offset}: {props.Typeface}");
        }
        editor.TextArea.Caret.Hide();
        Console.WriteLine("T007 typefaces PASS: plain/strike Regular; bold strike Bold; italic strike Italic.");
        var overlay = Capture(output);
        var strike = view.BackgroundRenderers.OfType<StrikeRenderer>().Single();
        var origin = view.TranslatePoint(default, editor)!.Value;
        var expectedBands = strike.StrokeBounds.Select(r => r.Translate(new Vector(origin.X, origin.Y))).ToArray();
        byte[] control;
        view.BackgroundRenderers.Remove(strike); view.InvalidateLayer(KnownLayer.Selection);
        try { await Task.Delay(80); control = Capture(null); }
        finally { view.BackgroundRenderers.Add(strike); view.InvalidateLayer(KnownLayer.Selection); }
        Rect Region(int start, int length) => BackgroundGeometryBuilder.GetRectsForSegment(view, new SimpleSegment(start, length)).Single().Translate(new Vector(origin.X, origin.Y));
        var plain = Region(0, 5); var struck = Region(8, 6);
        bool Different(int x, int y)
        {
            var i = (y * size.Width + x) * 4;
            return Math.Abs(overlay[i] - control[i]) + Math.Abs(overlay[i + 1] - control[i + 1]) + Math.Abs(overlay[i + 2] - control[i + 2]) > 8;
        }
        var rows = new HashSet<int>(); var maxHeight = 0;
        for (var x = (int)Math.Ceiling(struck.Left); x < (int)struck.Right; x++)
        {
            var count = 0;
            for (var y = (int)struck.Top; y < (int)Math.Ceiling(struck.Bottom); y++)
                if (Different(x, y)) { count++; rows.Add(y); }
            maxHeight = Math.Max(maxHeight, count);
        }
        // Compare mean glyph ink coverage above 10%, excluding the strike rows.
        // Allow 0.10 difference for the distinct letter shapes in plain versus strike.
        double Ink(Rect rect)
        {
            var values = new List<double>();
            for (var y = (int)Math.Ceiling(rect.Top); y < (int)rect.Bottom; y++)
            for (var x = (int)Math.Ceiling(rect.Left); x < (int)rect.Right; x++)
            {
                if (rows.Contains(y)) continue;
                var i = (y * size.Width + x) * 4;
                var coverage = Math.Abs(overlay[i + 1] - Look.Default.Background.G) / (double)(Look.Default.Foreground.G - Look.Default.Background.G);
                if (coverage > .1) values.Add(coverage);
            }
            return values.Average();
        }
        var plainInk = Ink(plain); var strikeInk = Ink(struck);
        var difference = Math.Abs(plainInk - strikeInk);
        var outside = 0;
        // Compare all glyphs (including bold/italic) against the identical renderer-off control.
        // Bounds are predicted by the renderer geometry, not inferred from changed pixels.
        for (var y = 0; y < size.Height; y++)
        for (var x = 0; x < size.Width; x++)
            if (!expectedBands.Any(r => x + 1 > r.Left && x < r.Right && y + 1 > r.Top && y < r.Bottom) && Different(x, y)) outside++;
        Console.WriteLine($"T007 pixels: scale=1 size={size.Width}x{size.Height} strikeHeight={maxHeight}px affectedRows={string.Join(',', rows.Order())} plainInk={plainInk:F4} strikeInk={strikeInk:F4} delta={difference:F4} tolerance=0.10 glyphDifferenceOutsideStrike={outside}; PNG={output}");
        if (maxHeight < 2 || rows.Count > 4 || difference > .10 || outside != 0)
            throw new Exception("Strike bitmap thickness/glyph coverage check failed.");
    }
}

