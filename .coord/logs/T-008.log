            ("- [ ] x", "- [ ] x\n- [ ] "), ("- [x] x", "- [x] x\n- [ ] "),
            ("1. text", "1. text\n2. "), ("9. text", "9. text\n10. "),
            ("- ", ""), ("* ", ""), ("1. ", ""), ("  - [ ] ", "  "), ("- [x] ", "")
        })
        {
