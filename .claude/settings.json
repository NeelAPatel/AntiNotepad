{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "AntiNotepad",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "ask": [
      "Edit(.coord/STATUS.md)",
      "Edit(.coord/lessons.md)",
      "Edit(docs/loop.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"$env:CLAUDE_PROJECT_DIR/tools/guard-bash.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/loop-card.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"$env:CLAUDE_PROJECT_DIR/tools/worktree-check.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/director-notes.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "timeout": 15,
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/session-where.ps1\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/tools/status-line.ps1\""
  }
}
