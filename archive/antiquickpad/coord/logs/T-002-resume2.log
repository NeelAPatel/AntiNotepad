    }

    private static void AddButton(Panel panel, string text, Action action)
    { var b = new Button { Content = text, Padding = new Thickness(9, 5) }; b.Click += (_, _) => action(); panel.Children.Add(b); }

    private void ApplyMaterial()
    {
        var name = _material.SelectedItem?.ToString() ?? "AcrylicBlur";
        var level = name switch { "Mica" => WindowTransparencyLevel.Mica, "Transparent" => WindowTransparencyLevel.Transparent, _ => WindowTransparencyLevel.AcrylicBlur };
        TransparencyLevelHint = [level, WindowTransparencyLevel.AcrylicBlur, WindowTransparencyLevel.Mica, WindowTransparencyLevel.Transparent];
        Background = name == "Transparent" ? Brushes.Transparent : new SolidColorBrush(Color.Parse("#D9141D26"));
        Dispatcher.UIThread.Post(() => { _status.Text = $"{name}; actual={ActualTransparencyLevel}; focus={_editors[_currentIndex].IsKeyboardFocusWithin}"; Log($"material requested={name} actual={ActualTransparencyLevel}"); });
    }

    private void Wheel(object? sender, PointerWheelEventArgs e)
    {
        if (Math.Abs(e.Delta.X) < .001) return;
        _dragOffset -= e.Delta.X * WheelNotchPixels;
        _lastVelocity = -e.Delta.X * WheelNotchPixels / 20;
        _gestureAt = Stopwatch.GetTimestamp();
        UpdateStrip(_dragOffset);
        _idleSnap.Stop(); _idleSnap.Start();
        Log($"wheel dx={e.Delta.X:F3} normalizedPx={-e.Delta.X * WheelNotchPixels:F1}");
        e.Handled = true;
    }

    private void StartDrag(object? sender, PointerPressedEventArgs e)
    {
        if (!e.GetCurrentPoint(_grabStrip).Properties.IsLeftButtonPressed) return;
        _captured = e.Pointer; _captured.Capture(_grabStrip); _isDragging = true;
        _dragStart = _lastPointer = e.GetPosition(_grabStrip); _dragOffset = 0; _gestureAt = Stopwatch.GetTimestamp();
        _idleSnap.Stop(); e.Handled = true; Log("drag-start capture=true");
    }

    private void MoveDrag(object? sender, PointerEventArgs e)
    {
        if (!_isDragging) return;
        var p = e.GetPosition(_grabStrip); var now = Stopwatch.GetTimestamp();
        var delta = p.X - _lastPointer.X; _dragOffset = p.X - _dragStart.X;
        var ms = Math.Max(.1, Stopwatch.GetElapsedTime(_gestureAt, now).TotalMilliseconds);
        _lastVelocity = delta / ms; _lastPointer = p; _gestureAt = now;
        UpdateStrip(_dragOffset); e.Handled = true;
    }

    private void EndDrag(object? sender, PointerReleasedEventArgs e)
    {
        if (!_isDragging) return;
        _isDragging = false; _captured?.Capture(null); _captured = null;
        Log($"drag-release distance={_dragOffset:F1} velocity={_lastVelocity:F3}px/ms"); FinishGesture(); e.Handled = true;
    }

    private void CancelDrag(string reason)
    {
        if (!_isDragging) return;
        _isDragging = false; _captured = null; Log($"drag-cancel {reason}");
        _dragOffset = 0; SnapTo(_currentIndex);
    }

    private void FinishGesture()
    {
        var displacement = _dragOffset;
        var wheel = !_isDragging;
        var edge = _currentIndex == _notes.Count - 1 && displacement < -170;
        if (edge) { CreateNote(); Log($"rubber-band create displacement={displacement:F1}"); }
        else GoTo(CarouselMath.SnapIndex(_currentIndex, displacement, _lastVelocity, _notes.Count, wheel));
        _dragOffset = 0;
    }

    private void UpdateStrip(double offset)
    {
        var min = -_currentIndex * (CardWidth + CardGap);
        var max = -Math.Max(0, _notes.Count - 1) * (CardWidth + CardGap);
        var global = min + offset;
        if (global > 0) global = CarouselMath.RubberBand(global);
        if (global < max) global = max + CarouselMath.RubberBand(global - max);
        SetCanvasPosition(global);
    }
    private void SetCanvasPosition(double x) => _canvas.RenderTransform = new TranslateTransform(x, 0);

    private void GoTo(int index)
    {
        var clamped = Math.Clamp(index, 0, _notes.Count - 1);
        if (_currentIndex == _notes.Count - 1 && index > _currentIndex && Math.Abs(_dragOffset) > 170) { CreateNote(); return; }
        _currentIndex = clamped; _targetOffset = -_currentIndex * (CardWidth + CardGap); _animation.Start(); UpdateStrip(_dragOffset); UpdateStrip(_dragOffset);
    }
    private void SnapTo(int index) { _dragOffset = 0; _currentIndex = Math.Clamp(index, 0, _notes.Count - 1); _targetOffset = -_currentIndex * (CardWidth + CardGap); _animation.Start(); }
    private void AnimateSnap()
    {
        var transform = _canvas.RenderTransform as TranslateTransform;
        var x = transform?.X ?? 0; var next = x + (_targetOffset - x) * .27;
        if (Math.Abs(next - _targetOffset) < .75) { next = _targetOffset; _animation.Stop(); }
        SetCanvasPosition(next); UpdateStrip(0); UpdateFocusStatus();
    }
    private void CreateNote()
    {
        var added = new Note();
        _notes.Add(added); _currentIndex = _notes.Count - 1; BuildEditors();
        _targetOffset = -_currentIndex * (CardWidth + CardGap); SetCanvasPosition(_targetOffset); SaveNotes(); FocusCurrent(); Log("note-created");
    }

    private void TryToggleCheckbox(TextEditor editor, PointerPressedEventArgs e)
    {
        if (e.Handled || !e.GetCurrentPoint(editor).Properties.IsLeftButtonPressed) return;
        var p = e.GetPosition(editor.TextArea.TextView);
        var pos = editor.TextArea.TextView.GetPosition(p);
        if (pos is null) return;
        var offset = editor.Document.GetOffset(pos.Value.Location);
        var line = editor.Document.GetLineByOffset(offset);
        var text = editor.Document.GetText(line);
        var marker = text.IndexOf("[ ]", StringComparison.Ordinal);
        var checkedMarker = false;
        if (marker < 0) { marker = text.IndexOf("[x]", StringComparison.OrdinalIgnoreCase); checkedMarker = true; }
        if (marker < 0 || offset < line.Offset + marker || offset > line.Offset + marker + 2) return;
        var caret = editor.TextArea.Caret.Offset;
        var replacement = EditorOperations.ToggleCheckbox(editor.Document, line.Offset + marker, ref caret);
        if (replacement is null) return;
        editor.TextArea.Caret.Offset = caret;
        editor.TextArea.TextView.Redraw();
        Log($"checkbox-toggle line={line.LineNumber} checked={!checkedMarker} undo={editor.Document.UndoStack.CanUndo} caret={editor.TextArea.Caret.Offset}");
        e.Handled = true;
    }

    private void HandleEditorKey(TextEditor editor, KeyEventArgs e)
    {
        if (e.Key != Key.Tab) return;
        var shift = e.KeyModifiers.HasFlag(KeyModifiers.Shift);
        var segment = editor.Selection.SurroundingSegment;
        if (segment is null) { editor.Document.Insert(editor.TextArea.Caret.Offset, "    "); }
        else
        {
            var first = editor.Document.GetLineByOffset(segment.Offset);
            var last = editor.Document.GetLineByOffset(Math.Max(segment.Offset, segment.EndOffset - 1));
            var lines = new List<DocumentLine>();
            for (var line = first; line.LineNumber <= last.LineNumber; line = line.NextLine!) { lines.Add(line); if (line == last || line.NextLine is null) break; }
            EditorOperations.Indent(editor.Document, lines.Select(x => x.LineNumber).ToArray(), shift);
        }
        Log($"selection-indent shift={shift} selection={editor.Selection.Length} undo={editor.Document.UndoStack.CanUndo}"); e.Handled = true;
    }

    private void ToggleCodeFold()
    {
        var editor = _editors[_currentIndex];
        try
        {
            if (_folding is not null) { FoldingManager.Uninstall(_folding); _folding = null; _status.Text = "Folding off"; return; }
            _folding = FoldingManager.Install(editor.TextArea);
            var lines = editor.Document.Lines.ToArray(); var ranges = new List<NewFolding>(); var start = -1;
            foreach (var line in lines)
            {
                var t = editor.Document.GetText(line);
                if (t.TrimStart().StartsWith("```")) { if (start < 0) start = line.Offset; else { ranges.Add(new NewFolding(start, line.EndOffset)); start = -1; } }
            }
            _folding.UpdateFoldings(ranges, -1); _status.Text = $"Python fence folding: {ranges.Count > 0}"; Log($"folding available=true ranges={ranges.Count}");
        }
        catch (Exception ex) { _status.Text = "Folding probe failed"; Log($"folding error={ex.GetType().Name}:{ex.Message}"); }
    }

    private void UpdateFocusStatus()
    {
        if (_editors.Count == 0) return;
        _status.Text = $"Note {_currentIndex + 1}/{_notes.Count} · focus={_editors[_currentIndex].IsKeyboardFocusWithin} · {_material.SelectedItem} -> {ActualTransparencyLevel}";
    }
    private void FocusCurrent()
    {
        if (!IsVisible || _editors.Count == 0) return;
        Activate(); _editors[_currentIndex].Focus();
        Dispatcher.UIThread.Post(() => { var focused = _editors[_currentIndex].IsKeyboardFocusWithin; UpdateFocusStatus(); Log($"focus-check actual={focused} focusManager={FocusManager.GetFocusedElement(this)?.GetType().Name ?? "none"}"); }, DispatcherPriority.Background);
    }
    private void HideResident() { SaveNotes(); Hide(); Log("window-hidden resident=true"); }
    private void ShowToggle()
    {
        if (IsVisible && IsActive) HideResident();
        else { Show(); Activate(); WindowState = WindowState.Normal; Dispatcher.UIThread.Post(FocusCurrent, DispatcherPriority.Input); Log("hotkey-show"); }
    }
    private void ExitApp() { _closing = true; SaveNotes(); Close(); }
    private void SaveNotes()
    {
        if (_closing) return;
        try { _notes = CarouselMath.PruneInteriorBlanks(_notes); _store.Save(_notes); Log($"autosave notes={_notes.Count} path={_store.Path}"); }
        catch (Exception ex) { Log($"autosave-error {ex.GetType().Name}:{ex.Message}"); }
    }
    private void InstallNativeHooks()
    {
        if (!OperatingSystem.IsWindows()) { _status.Text = "Windows hotkey unavailable"; return; }
        Win32Properties.AddWndProcHookCallback(this, WndProc);
        SetupTray();
    }
    private void SetupTray()
    {
        var menu = new NativeMenu();
        var show = new NativeMenuItem("Show / hide · Ctrl+Alt+Space"); show.Click += (_, _) => ShowToggle();
        var exit = new NativeMenuItem("Exit"); exit.Click += (_, _) => { _closing = true; Close(); };
        menu.Items.Add(show); menu.Items.Add(exit);
        _tray = new TrayIcon { ToolTipText = "AntiQuickPad spike", IsVisible = true, Menu = menu };
        _tray.Clicked += (_, _) => ShowToggle();
        TrayIcon.SetIcons(this, new TrayIcons { _tray });
        _status.Text = "Registering Ctrl+Alt+Space…";
    }
    private IntPtr WndProc(IntPtr hwnd, uint msg, IntPtr wParam, IntPtr lParam, ref bool handled)
    {
        if (msg == WmHotkey && wParam.ToInt32() == HotkeyId) { handled = true; ShowToggle(); return IntPtr.Zero; }
        _hwnd = hwnd;
        if (msg == 0x0001 && !_hotkeyRegistered)
        {
            _hotkeyRegistered = RegisterHotKey(hwnd, HotkeyId, ModControl | ModAlt, VkSpace);
            Log($"hotkey-register result={_hotkeyRegistered} error={(Marshal.GetLastWin32Error())}");
            _status.Text = _hotkeyRegistered ? "Ctrl+Alt+Space registered" : "Hotkey registration failed (occupied?)";
        }
        return IntPtr.Zero;
    }
    private void Cleanup()
    {
        SaveNotes();
        if (OperatingSystem.IsWindows())
        {
            Win32Properties.RemoveWndProcHookCallback(this, WndProc);
            if (_hotkeyRegistered) UnregisterHotKey(_hwnd, HotkeyId);
        }
        if (_tray is not null) { _tray.IsVisible = false; _tray.Dispose(); }
        _log?.Dispose(); _log = null;
    }
    private void Log(string message) => _log?.WriteLine($"{DateTimeOffset.UtcNow:O} +{_clock.Elapsed.TotalMilliseconds:F1}ms visible={IsVisible} focused={(_editors.Count > 0 && _editors[_currentIndex].IsKeyboardFocusWithin)} {message}");
    private void KeyPressed(object? sender, KeyEventArgs e)
    {
        if (e.Key == Key.Escape) { HideResident(); e.Handled = true; }
        else if (e.Key == Key.N && e.KeyModifiers.HasFlag(KeyModifiers.Control)) { CreateNote(); e.Handled = true; }
    }
    private static void ToggleWindow(Window w) { if (w.IsVisible) w.Hide(); else { w.Show(); w.Activate(); } }

    [DllImport("user32.dll", SetLastError = true)] private static extern bool RegisterHotKey(IntPtr hWnd, int id, uint modifiers, int key);
    [DllImport("user32.dll", SetLastError = true)] private static extern bool UnregisterHotKey(IntPtr hWnd, int id);
}

