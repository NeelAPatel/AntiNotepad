using Avalonia.Media;
using AvaloniaEdit.Document;
using AvaloniaEdit.Rendering;

namespace InputProbe;

// Stateless per line: virtualized/partial redraw order cannot corrupt fence state.
internal sealed class MarkdownColorizer : DocumentColorizingTransformer
{
    private static readonly IBrush[] Headings = [
        new SolidColorBrush(Color.Parse("#FFD6A5")), new SolidColorBrush(Color.Parse("#9FD8FF")),
        new SolidColorBrush(Color.Parse("#C4B5FD")), new SolidColorBrush(Color.Parse("#A7F3D0")),
        new SolidColorBrush(Color.Parse("#F9A8D4")), new SolidColorBrush(Color.Parse("#FCA5A5"))];
    private static readonly IBrush Marker = new SolidColorBrush(Color.Parse("#F2C879"));
    private static readonly IBrush Keyword = new SolidColorBrush(Color.Parse("#C4A7FF"));
    private static readonly IBrush String = new SolidColorBrush(Color.Parse("#A9E6B5"));
    private static readonly Regex PythonKeywords = new(@"\b(def|class|return|if|elif|else|for|while|in|import|from|as|try|except|with|yield|async|await|True|False|None|pass|break|continue|lambda)\b", RegexOptions.Compiled);
    private static readonly Regex PythonStrings = new("(['\\\"])(?:\\\\.|(?!\\1).)*?\\1", RegexOptions.Compiled);

    protected override void ColorizeLine(DocumentLine line)
    {
        var document = CurrentContext.Document;
        var text = document.GetText(line);
        var inPython = false;
        foreach (var prior in document.Lines)
        {
            if (prior.Offset >= line.Offset) break;
            if (document.GetText(prior).TrimStart().StartsWith("```")) inPython = !inPython;
        }
        if (text.TrimStart().StartsWith("```")) { Paint(line.Offset, line.EndOffset, Marker); return; }
        if (inPython)
        {
            foreach (Match match in PythonStrings.Matches(text)) Paint(line.Offset + match.Index, line.Offset + match.Index + match.Length, String);
            foreach (Match match in PythonKeywords.Matches(text)) Paint(line.Offset + match.Index, line.Offset + match.Index + match.Length, Keyword);
            return;
        }
        var prefix = text.TakeWhile(c => c == ' ').Count();
        var hashes = text.Skip(prefix).TakeWhile(c => c == '#').Count();
        if (hashes > 0 && hashes <= 6 && text.Skip(prefix + hashes).FirstOrDefault() is ' ' or '\0') Paint(line.Offset, line.EndOffset, Headings[hashes - 1]);
        for (var i = 0; i < text.Length; i++)
        {
            if ((text[i] == '*' && i + 1 < text.Length && text[i + 1] == '*') ||
                (text[i] == '~' && i + 1 < text.Length && text[i + 1] == '~') ||
                (text[i] == '`') || (text[i] == '*' && (i == 0 || text[i - 1] != '*')) ||
                (text[i] == '_' && (i == 0 || text[i - 1] != '_')) ||
                (text[i] == '[' && i + 2 < text.Length && text[i + 2] == ']'))
                Paint(line.Offset + i, line.Offset + Math.Min(text.Length, i + ((i + 1 < text.Length && (text[i + 1] == text[i] || (text[i] == '[' && text[i + 2] == ']'))) ? 2 : 1)), Marker);
        }
    }

    private void Paint(int start, int end, IBrush brush)
    {
        if (end <= start) return;
        ChangeLinePart(start, end, element => element.TextRunProperties.SetForegroundBrush(brush));
    }
}
using System.Text.Json;

namespace InputProbe;

internal sealed class Note
{
    public string Id { get; set; } = Guid.NewGuid().ToString("N");
    public string Text { get; set; } = "";
}

internal sealed class NoteStore(string path)
{
    public string Path { get; } = path;
    public List<Note> Load()
    {
        try
        {
            if (!File.Exists(Path)) return [new Note { Text = Fixture }];
            var notes = JsonSerializer.Deserialize<List<Note>>(File.ReadAllText(Path));
            return notes is { Count: > 0 } ? notes : [new Note { Text = Fixture }];
        }
        catch { return [new Note { Text = Fixture }]; }
    }

    public void Save(IReadOnlyList<Note> notes)
    {
        Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Path)!);
        var clean = notes.Select(n => new Note { Id = n.Id, Text = n.Text }).ToList();
        var temp = Path + ".tmp";
        File.WriteAllText(temp, JsonSerializer.Serialize(clean, new JsonSerializerOptions { WriteIndented = true }));
        File.Move(temp, Path, true);
    }

    public static string Fixture => "# AntiQuickPad spike\n\n## A focused scratchpad\n\nVisible **bold**, *italic*, and ~~strike~~ markers remain editable.\n\n- [ ] Click the checkbox marker to toggle it (undo with Ctrl+Z)\n- [x] Keep notes local\n\n```python\ndef quick_note():\n    return 'wrapped and highlighted'\n```\n\nDrag the grab strip to move notes. Mouse wheel tilts by about 120 px per notch.";
}

internal static class CarouselMath
{
    public static double WheelDeltaToPixels(double delta) => -delta * 120d;
    public static double DragDelta(double origin, double current) => current - origin;
    public static bool ShouldCreateNote(int index, int count, double displacement) => count > 0 && index == count - 1 && displacement < -170;
    public static double RubberBand(double offset, double limit = 180) => Math.Sign(offset) * limit * (1 - Math.Exp(-Math.Abs(offset) / limit));
    public static int SnapIndex(int current, double displacement, double velocityPxPerMs, int count, bool wheel = false)
    {
        if (count < 1) return 0;
        var threshold = wheel ? 60d : 170d;
        var direction = displacement < -threshold || velocityPxPerMs < -.55 ? 1 : displacement > threshold || velocityPxPerMs > .55 ? -1 : 0;
        return Math.Clamp(current + direction, 0, count - 1);
    }
    public static List<Note> PruneInteriorBlanks(IReadOnlyList<Note> notes)
    {
        var result = notes.Where((n, i) => !string.IsNullOrWhiteSpace(n.Text) || i == notes.Count - 1).ToList();
        return result.Count == 0 ? [new Note()] : result;
    }
}

