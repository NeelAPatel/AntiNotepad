        row.Children.Add(new TextBlock { Text = "AntiQuickPad", FontSize = 18, FontWeight = FontWeight.Bold, VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(0, 0, 10, 0) });
        AddButton(row, "＋ Note", CreateNote);
