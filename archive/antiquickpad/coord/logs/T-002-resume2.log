        }, DispatcherPriority.Background);
    }
    private void Log(string message) => _log?.WriteLine($"{DateTimeOffset.UtcNow:O} +{_clock.Elapsed.TotalMilliseconds:F1}ms visible={IsVisible} focused={(_editors.Count > 0 && _editors[_currentIndex].IsKeyboardFocusWithin)} {message}");
    private void KeyPressed(object? sender, KeyEventArgs e)
    {
        if (e.Key == Key.Escape) { HideResident(); e.Handled = true; }
        else if (e.Key == Key.N && e.KeyModifiers.HasFlag(KeyModifiers.Control)) { CreateNote(); e.Handled = true; }
    }
    private static void ToggleWindow(Window w) { if (w.IsVisible) w.Hide(); else { w.Show(); w.Activate(); } }

    [DllImport("user32.dll", SetLastError = true)] private static extern bool RegisterHotKey(IntPtr hWnd, int id, uint modifiers, int key);
    [DllImport("user32.dll", SetLastError = true)] private static extern bool UnregisterHotKey(IntPtr hWnd, int id);
}
using System.Diagnostics;
using AvaloniaEdit.Document;

namespace InputProbe;

internal static class SmokeChecks
{
    public static int Run()
    {
        var timer = Stopwatch.StartNew(); var passed = 0; var failed = 0;
        void Check(string name, Func<bool> action)
        {
            var one = Stopwatch.StartNew();
            try
            {
                if (action()) { passed++; Console.WriteLine($"PASS {name} {one.Elapsed.TotalMilliseconds:F2}ms"); }
                else { failed++; Console.WriteLine($"FAIL {name} {one.Elapsed.TotalMilliseconds:F2}ms"); }
            }
            catch (Exception ex) { failed++; Console.WriteLine($"FAIL {name}: {ex.GetType().Name} {ex.Message}"); }
        }

        Check("horizontal wheel delta maps to 120 logical px per notch", () => CarouselMath.WheelDeltaToPixels(1) == -120 && CarouselMath.WheelDeltaToPixels(-1) == 120 && CarouselMath.WheelDeltaToPixels(.5) == -60);
        Check("grab-strip drag delta preserves pointer distance", () => CarouselMath.DragDelta(24.5, 107.75) == 83.25 && CarouselMath.DragDelta(107.75, 24.5) == -83.25);
        Check("rubber band is bounded", () => CarouselMath.RubberBand(-900) > -180 && CarouselMath.RubberBand(-900) < 0);
        Check("wheel idle snap advances by distance", () => CarouselMath.SnapIndex(0, -120, 0, 4, true) == 1);
        Check("mouse release uses distance threshold", () => CarouselMath.SnapIndex(1, -200, 0, 4) == 2);
        Check("mouse release uses velocity threshold", () => CarouselMath.SnapIndex(1, 0, -.8, 4) == 2);
        Check("slow short drag springs back", () => CarouselMath.SnapIndex(1, -40, 0, 4) == 1);
        Check("overscroll creates only past newest note", () => CarouselMath.ShouldCreateNote(2, 3, -180) && !CarouselMath.ShouldCreateNote(1, 3, -180) && !CarouselMath.ShouldCreateNote(2, 3, 100));
        Check("interior blank notes prune and trailing blank remains", () =>
        {
            var notes = new List<Note> { new() { Text = "a" }, new(), new() { Text = "c" }, new() };
            var retainedId = notes[2].Id;
            var result = CarouselMath.PruneInteriorBlanks(notes);
            return result.Count == 3 && result[^1].Text == "" && result[1].Id == retainedId;
        });

        var doc = new TextDocument("- [ ] task\nsecond\n"); var caret = 8;
        Check("checkbox toggles source in one undo unit", () => EditorOperations.ToggleCheckbox(doc, 2, ref caret) == "[x]" && doc.Text.StartsWith("- [x]", StringComparison.Ordinal) && doc.UndoStack.CanUndo);
        Check("checkbox preserves caret", () => caret == 8);
        Check("checkbox toggle is undoable", () => { doc.UndoStack.Undo(); return doc.Text.StartsWith("- [ ]", StringComparison.Ordinal); });
        Check("selection indent applies to multiple lines", () => { EditorOperations.Indent(doc, [1, 2], false); return doc.Text.StartsWith("    - [ ] task\n    second", StringComparison.Ordinal); });
        Check("selection indent is one undo group", () => { doc.UndoStack.Undo(); return doc.Text.StartsWith("- [ ] task\nsecond", StringComparison.Ordinal); });
        var outdentDoc = new TextDocument("    first\n  second\n");
        Check("selection outdent removes up to four leading spaces", () => { EditorOperations.Indent(outdentDoc, [1, 2], true); return outdentDoc.Text.StartsWith("first\nsecond", StringComparison.Ordinal); });

        var temp = Path.Combine(Path.GetTempPath(), $"aqp-smoke-{Guid.NewGuid():N}.json");
        Check("JSON persistence restores notes", () =>
        {
            try { var store = new NoteStore(temp); var notes = new List<Note> { new() { Text = NoteStore.Fixture }, new() { Text = "survives relaunch" } }; store.Save(notes); return store.Load().Select(n => n.Text).SequenceEqual(notes.Select(n => n.Text)); }
            finally { if (File.Exists(temp)) File.Delete(temp); }
        });
        Check("fixture carries visible Markdown and Python fences", () => NoteStore.Fixture.Contains("**bold**") && NoteStore.Fixture.Contains("*italic*") && NoteStore.Fixture.Contains("~~strike~~") && NoteStore.Fixture.Contains("```python"));

        Console.WriteLine($"SMOKE {(failed == 0 ? "PASS" : "FAIL")} checks={passed + failed} passed={passed} failed={failed} elapsed={timer.Elapsed.TotalMilliseconds:F1}ms (model-level; does not measure visible focus/hardware/materials)");
        return failed == 0 ? 0 : 1;
    }
}

