    private void ToggleCodeFold()
    {
        var editor = _editors[_currentIndex];
        try
        {
            if (_folding is not null) { FoldingManager.Uninstall(_folding); _folding = null; _status.Text = "Folding off"; return; }
            _folding = FoldingManager.Install(editor.TextArea);
            var lines = editor.Document.Lines.ToArray(); var ranges = new List<NewFolding>(); var start = -1;
            foreach (var line in lines)
            {
                var t = editor.Document.GetText(line);
                if (t.TrimStart().StartsWith("```")) { if (start < 0) start = line.Offset; else { ranges.Add(new NewFolding(start, line.EndOffset)); start = -1; } }
            }
            _folding.UpdateFoldings(ranges, -1); _status.Text = $"Python fence folding: {ranges.Count > 0}"; Log($"folding available=true ranges={ranges.Count}");
        }
        catch (Exception ex) { _status.Text = "Folding probe failed"; Log($"folding error={ex.GetType().Name}:{ex.Message}"); }
    }

    private void UpdateFocusStatus()
    {
        if (_editors.Count == 0) return;
        _status.Text = $"Note {_currentIndex + 1}/{_notes.Count} · focus={_editors[_currentIndex].IsKeyboardFocusWithin} · {_material.SelectedItem} -> {ActualTransparencyLevel}";
    }
    private void FocusCurrent()
    {
        if (!IsVisible || _editors.Count == 0) return;
        Activate(); _editors[_currentIndex].TextArea.Focus();
        Dispatcher.UIThread.Post(() => { var focused = _editors[_currentIndex].TextArea.IsKeyboardFocusWithin; UpdateFocusStatus(); Log($"focus-check actual={focused} editorWithin={_editors[_currentIndex].IsKeyboardFocusWithin} processToFocus={Program.ElapsedMs:F1}ms"); }, DispatcherPriority.Background);
    }
    private void HideResident() { SaveNotes(); var started = Stopwatch.GetTimestamp(); Hide(); Log($"window-hidden resident=true hideDispatch={Stopwatch.GetElapsedTime(started).TotalMilliseconds:F2}ms"); }
    private void ShowToggle()
    {
        if (IsVisible && IsActive) HideResident();
        else { WindowState = WindowState.Normal; Show(); Activate(); Dispatcher.UIThread.Post(FocusCurrent, DispatcherPriority.Input); Log("hotkey-show"); }
    }
    private void ExitApp() { SaveNotes(); _closing = true; Close(); }
    private void SaveNotes()
    {
        if (_closing) return;
        try { _store.Save(_notes); Log($"autosave notes={_notes.Count} path={_store.Path}"); }
        catch (Exception ex) { Log($"autosave-error {ex.GetType().Name}:{ex.Message}"); }
    }
    private void InstallNativeHooks()
    {
        if (!OperatingSystem.IsWindows()) { _status.Text = "Windows hotkey unavailable"; return; }
        Win32Properties.AddWndProcHookCallback(this, WndProc);
        _hwnd = TryGetPlatformHandle()?.Handle ?? IntPtr.Zero;
        if (_hwnd != IntPtr.Zero)
        {
            _hotkeyRegistered = RegisterHotKey(_hwnd, HotkeyId, ModControl | ModAlt, VkSpace);
            Log($"hotkey-register result={_hotkeyRegistered} error={Marshal.GetLastWin32Error()}");
        }
        SetupTray();
    }
    private void SetupTray()
    {
        var menu = new NativeMenu();
        var show = new NativeMenuItem("Show / hide · Ctrl+Alt+Space"); show.Click += (_, _) => ShowToggle();
        var exit = new NativeMenuItem("Exit"); exit.Click += (_, _) => ExitApp();
        menu.Items.Add(show); menu.Items.Add(exit);
        _tray = new TrayIcon { ToolTipText = "AntiQuickPad spike", IsVisible = true, Menu = menu, Icon = CreateTrayIcon() };
        _tray.Clicked += (_, _) => ShowToggle();
        TrayIcon.SetIcons(Application.Current!, new TrayIcons { _tray });
        _status.Text = _hotkeyRegistered ? "Ctrl+Alt+Space registered" : "Hotkey registration failed (occupied?)";
    }

