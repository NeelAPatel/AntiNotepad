+// Read the same Windows scaling settings used by the pinned wheel backend.
+// These are normalized wheel steps, not an assertion about physical detents.
+fn wheel_steps(dx: f32, dy: f32, units: &str) -> String {
+    if units != "lines" {
+        return "notch_steps_x=NA\tnotch_steps_y=NA".into();
+    }
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn SystemParametersInfoW(action: u32, param: u32, value: *mut u32, flags: u32) -> i32;
+    }
+    let read = |action| {
+        let mut value = 0u32;
+        // GETWHEELSCROLLCHARS / GETWHEELSCROLLLINES write one UINT; no settings mutation.
+        if unsafe { SystemParametersInfoW(action, 0, &mut value, 0) } != 0
+            && value > 0 && value != u32::MAX {
+            Some(value as f32)
+        } else { None }
+    };
+    let step = |delta: f32, amount: Option<f32>| {
+        amount.map(|scale| format!("{:.4}", delta / scale)).unwrap_or_else(|| "NA".into())
+    };
+    format!("notch_steps_x={}\tnotch_steps_y={}", step(dx, read(108)), step(dy, read(104)))
+}
+
+fn show_event(recent: &Rc<RefCell<VecDeque<String>>>, detail: String) {
+    let mut rows = recent.borrow_mut();
+    rows.push_back(detail);
+    while rows.len() > 7 { rows.pop_front(); }
+}
