+// # spike: raw detent evidence alongside public, Windows-scaled line deltas.
+fn probe_wheel_trace(message: &str, raw_delta: i16) {
+    use std::io::Write as _;
+    let path = std::env::var_os("ANTIQUICKPAD_PROBE_LOG").map(std::path::PathBuf::from)
+        .unwrap_or_else(|| std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../../../docs/spikes/B/input-probe.tsv"));
+    let micros = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default().as_micros();
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(file, "{micros}\tNATIVE_WHEEL\tmessage={message}\traw_delta={raw_delta}\tnotch_delta={:.4}", raw_delta as f32 / WHEEL_DELTA as f32);
+    }
+}
+
 pub(crate) const WM_GPUI_CURSOR_STYLE_CHANGED: u32 = WM_USER + 1;
 pub(crate) const WM_GPUI_CLOSE_ONE_WINDOW: u32 = WM_USER + 2;
