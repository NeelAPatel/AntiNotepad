report=['# T-015-alignment-fixes', '', 'Status: implementation and raster checks complete; final full-suite confirmation pending below.', '', 'Manager owns git. No Core/ViewModel, network, git, process-kill, STATUS.md or docs-ui-audit changes. Source stays in Views.', '', '## F26-quiet-footer-count-alignment', '', 'Count and Fluent icon text use OpticalText: a cached 6x alpha-ink probe centres the visible glyph bounds inside the footer slot. A 0.25 DIP coverage correction is validated against the actual 1x/1.5x production raster. Ordinary show/hide reuses the measured controls. This also centres Card pager arrows.', '', '## F35-card-footer-vertical-centre', '', 'Count, save text and pager share one 42 DIP footer grid, 12 DIP above the window bottom. Count/save ink is centred within that grid; the capsule border centre is independently isolated in the raster (shadow and child ink excluded).', '', 'All coordinates below are DIPs relative to the 960x800 production root. Pixel edge bounds are divided by scale; centre = (top + bottom)/2. Footer snapshots show actual saved status and note 3 of 8.', '', '| Shell/theme | Scale | Count ink centre Y | Previous / next ink Y | Saved ink Y | Reference Y | Count delta | Saved delta |', '|---|---:|---:|---:|---:|---:|---:|---:|']
for shell in ['quiet','card']:
 for theme in ['light','dark']:
  data=json.loads((base/f'{shell}-{theme}'/'measurements.json').read_text())
  for r in data:
   if 'countY' not in r: continue
   ref=r['pagerY']
   report.append(f\"| {shell}/{theme} | {r['scale']} | {r['countY']:.3f} | {r['previousY']:.3f} / {r['nextY']:.3f} | {r['saveY']:.3f} | {ref:.3f} | {r['delta']:.3f} | {abs(r['saveY']-ref):.3f}\" + (' (separate Quiet status)' if shell=='quiet' else '') + ' |')
report+=['', 'F26-quiet-footer-count-alignment compares Quiet count with both arrows. F35-card-footer-vertical-centre compares Card count/save with the capsule border. All requested differences are <=0.5 DIP. Quiet central save status retains its separate existing position; it is outside F26-quiet-footer-count-alignment.', '', '## F31-menu-grid-alignment', '', 'One rule, relative to the 250 DIP menu border: highlight spans x=6..244 (equal 6 DIP outer margins); check column anchor x=16; text anchor x=40. Section labels and divider also start at x=40. A real 24 DIP Grid column replaces whitespace alignment. A ContentPresenter template makes these insets explicit. Every item row is 32 DIP high, with 2 DIP inter-row spacing. Both labels use 8 DIP top / 3 DIP bottom margins.', '', 'The selected background and pointer/keyboard-focus background use the same rectangle. The proof switches each real row background on/off and scans the pixel difference at its vertical middle, then separately isolates check/text/label/divider ink. Checks are temporarily painted in every row to measure the reserved column; final snapshots restore the actual selection. Glyph bearings explain ink x differing slightly from its fixed column origin. Ink-bearing assertions require check ink in x=16..17.5 and item ink in x=40..41.5; no string padding determines alignment.', '', '| Shell/theme | Scale | Row | Highlight left/right | Check anchor / ink X | Text anchor / ink X | Height |', '|---|---:|---|---|---|---|---:|']
for shell in ['quiet','card']:
 for theme in ['light','dark']:
  data=json.loads((base/f'{shell}-{theme}'/'measurements.json').read_text())
