    }
    private void ToggleMenu()
    {
        _menu.IsVisible = !_menu.IsVisible;
        if (_menu.IsVisible) ((StackPanel)_menu.Child!).Children.OfType<Button>().First().Focus(); else FocusEditor();
    }
    private void RefreshHint()
    {
        // The bound document is authoritative across navigation and editor-tree transfers.
        // The overlay belongs to the selected page, so never cover a moving preview.
        if (_layout is not null) _layout.Hint.IsVisible = _editor.Document.TextLength == 0 && !_carousel.IsBusy;
    }
    private void UpdateShellStatus()
