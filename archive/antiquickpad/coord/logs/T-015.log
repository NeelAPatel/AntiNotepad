                Check(right >= left, "T-015-alignment-fixes: no raster difference");
                return new Rect(left / scale, top / scale, (right - left + 1) / scale, (bottom - top + 1) / scale);
            }
            Rect Ink(Control c)
            {
                var on = Capture(); var opacity = c.Opacity; c.Opacity = 0; var off = Capture(); c.Opacity = opacity;
                return Difference(on, off, Region(c).Inflate(20));
            }
            void Crop(byte[] bytes, Rect rect, string name)
            {
                var x = Math.Max(0, (int)Math.Floor(rect.X * scale)); var y = Math.Max(0, (int)Math.Floor(rect.Y * scale));
                var w = Math.Min(width - x, (int)Math.Ceiling(rect.Width * scale)); var h = Math.Min(height - y, (int)Math.Ceiling(rect.Height * scale));
                using var bitmap = new WriteableBitmap(new PixelSize(w,h), new Vector(96 * scale,96 * scale), Avalonia.Platform.PixelFormat.Bgra8888, Avalonia.Platform.AlphaFormat.Premul);
                using (var buffer = bitmap.Lock()) for (var row = 0; row < h; row++) Marshal.Copy(bytes, ((y + row) * width + x) * 4, buffer.Address + row * buffer.RowBytes, w * 4);
                bitmap.Save(Path.Combine(output, name + (scale == 1 ? "@1x.png" : "@1.5x.png")));
            }
            var count = Ink(_layout.Count);
            var previous = Ink((Control)_layout.Buttons["Previous"].Content!);
            var next = Ink((Control)_layout.Buttons["Next"].Content!);
            var save = Ink(_layout.Save);
            var reference = previous.Center.Y;
            if (_shellId == "card")
            {
                var pager = _layout.Dots.GetVisualAncestors().OfType<Border>().First();
                // Isolate capsule border pixels from child ink and the drop shadow.
                var shadow = pager.BoxShadow; var background = pager.Background; var brush = pager.BorderBrush;
                pager.BoxShadow = default; pager.Background = Brushes.Transparent; pager.BorderBrush = Brushes.White;
                var children = pager.Child!; children.Opacity = 0;
                var on = Capture(); pager.BorderBrush = Brushes.Transparent; var off = Capture();
                var border = Difference(on, off, Region(pager).Inflate(1)); reference = border.Center.Y;
                pager.BoxShadow = shadow; pager.Background = background; pager.BorderBrush = brush; children.Opacity = 1;
            }
            var delta = Math.Abs(count.Center.Y - reference);
            Check(delta <= .5, $"T-015-alignment-fixes {_shellId} @{scale}: count centre {count.Center.Y} vs reference {reference} delta {delta}");
            Check(Math.Abs(next.Center.Y - previous.Center.Y) <= .5, "Footer arrow ink mismatch");
            if (_shellId == "card") Check(Math.Abs(save.Center.Y - reference) <= .5, $"Card save centre {save.Center.Y} vs pager {reference}");
            results.Add(new { scale, countY = count.Center.Y, previousY = previous.Center.Y, nextY = next.Center.Y, saveY = save.Center.Y, pagerY = reference, delta });
            var menuOrigin = Region(_menu).X;
            var list = (StackPanel)_menu.Child!;
            foreach (var button in list.Children.OfType<Button>())
            {
                var grid = (Grid)button.Content!; var check = (TextBlock)grid.Children[0]; var text = (TextBlock)grid.Children[1];
                var old = button.Background; button.Background = new SolidColorBrush(CurrentLook.CodePanel); var on = Capture();
                button.Background = Brushes.Transparent; var off = Capture();
                // The middle band avoids rounded corners; subtracting captures isolates the highlight.
                var r = Region(button); var highlight = Difference(on, off, new Rect(r.X, r.Center.Y - 1, r.Width, 2));
                button.Background = old;
                var textInk = Ink(text);
                var oldText = check.Text; check.Text = "'"\\u2713\"; UpdateLayout(); var checkInk = Ink(check); check.Text = oldText; UpdateLayout();
                var checkX = Region(check).X - menuOrigin; var textX = Region(text).X - menuOrigin;
                Check(Math.Abs(highlight.X - menuOrigin - 6) <= 1 / scale && Math.Abs(highlight.Right - menuOrigin - 244) <= 1 / scale, \"Menu highlight inset\");
                Check(Math.Abs(checkX - 16) < .01 && Math.Abs(textX - 40) < .01 && Math.Abs(r.Height - 32) < .01, \"Menu column/row geometry\");
                results.Add(new { scale, row = text.Text, highlightX = highlight.X - menuOrigin, highlightRight = highlight.Right - menuOrigin, checkX, checkInkX = checkInk.X - menuOrigin, textX, textInkX = textInk.X - menuOrigin, height = r.Height });
            }
            foreach (var label in list.Children.OfType<TextBlock>())
            {
                var ink = Ink(label); var x = Region(label).X - menuOrigin;
                Check(Math.Abs(x - 40) < .01 && Math.Abs(ink.X - menuOrigin - 40) <= 2, \"Menu section edge\");
                results.Add(new { scale, label = label.Text, x, inkX = ink.X - menuOrigin, topSpacing = label.Margin.Top, bottomSpacing = label.Margin.Bottom });
            }
            var divider = list.Children.OfType<Border>().Single(); var dividerInk = Ink(divider);
            Check(Math.Abs(dividerInk.X - menuOrigin - 40) <= 1 / scale, \"Menu divider edge\");
            results.Add(new { scale, dividerX = dividerInk.X - menuOrigin });
            Crop(Capture(), new Rect(0, _root.Bounds.Height - 78, _root.Bounds.Width, 78), \"footer\");
            Crop(Capture(), Region(_menu).Inflate(3), \"menu\");
        }
        File.WriteAllText(Path.Combine(output, \"measurements.json\"), JsonSerializer.Serialize(results, new JsonSerializerOptions { WriteIndented = true }));
        Console.WriteLine("'$"T-015-alignment-fixes {_shellId}/{(_theme.IsDark ? "dark" : "light")} raster PASS: {output}");
        _menu.IsVisible = false;
    }
}
