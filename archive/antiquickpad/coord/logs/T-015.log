        if (args is ["--quit"]) return SingleInstanceService.RequestQuit();
        if (args is ["--selftest-quit", var quitId]) return SingleInstanceService.RequestQuit(quitId);
        if (args is ["--selftest-quit-stalled", var stalledId, var ready])
