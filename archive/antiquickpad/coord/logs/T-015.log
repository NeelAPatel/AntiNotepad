using Avalonia;
using Avalonia.Controls;
using Avalonia.Layout;
using Avalonia.Media;
using AntiQuickPad.Views.Common;

namespace AntiQuickPad.Views.Quiet;

internal static class QuietLayout
{
    public static Control Build(ShellLayoutContext c)
    {
        var root = new Grid { Background = c.Canvas, ClipToBounds = true };

        c.Place(root, c.Page, HorizontalAlignment.Stretch, VerticalAlignment.Stretch,
            new Thickness(90, 90, 90, 60));

        c.Hint.Margin = new Thickness(112, 145, 80, 0);
        c.Hint.HorizontalAlignment = HorizontalAlignment.Left;
        c.Hint.VerticalAlignment = VerticalAlignment.Top;
        c.Hint.IsHitTestVisible = false;
        root.Children.Add(c.Hint);

        // Keep the blank header strip draggable while leaving the editor and buttons unobstructed.
        var dragRegion = c.DragRegion(new Border { Height = 58, Background = Brushes.Transparent });
        c.Place(root, dragRegion, HorizontalAlignment.Stretch, VerticalAlignment.Top,
            new Thickness(0));

        var title = c.Text("AntiQuickPad", 13, c.Ink, FontWeight.SemiBold);
        c.Place(root, c.Bar(c.Row(title)), HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(28, 20, 0, 0));

        var actions = c.Row(
            c.Button("\uE710", "New note"),
            c.Button("\uE712", "More"),
            new Border
            {
                Width = 1,
                Height = 16,
                Margin = new Thickness(7, 0),
                Background = c.Rule,
                VerticalAlignment = VerticalAlignment.Center
            },
            c.Button("\uE718", "Pin"),
            c.Button("\uE921", "Minimize"),
            c.Button("\uE8BB", "Hide"));
        c.Place(root, c.Bar(actions), HorizontalAlignment.Right, VerticalAlignment.Top,
            new Thickness(0, 14, 20, 0));

        var collection = c.Text("PERSONAL  /  TODAY", 10, c.Muted);
        c.Place(root, c.Bar(collection), HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(112, 72, 0, 0));

        var navigation = c.Row(
            c.Button("\uE76B", "Previous"),
            c.Count,
            c.Button("\uE76C", "Next"));
        c.Place(root, c.Bar(navigation), HorizontalAlignment.Left, VerticalAlignment.Bottom,
            new Thickness(28, 0, 0, 17));

        var savedGlyph = c.Text("\uE73E", 11, new SolidColorBrush(c.Look.Accent));
        savedGlyph.FontFamily = new FontFamily("Segoe Fluent Icons");
        var save = c.Row(savedGlyph, c.Save);
        c.Place(root, c.Bar(save), HorizontalAlignment.Center, VerticalAlignment.Bottom,
            new Thickness(0, 0, 0, 23));

        var trailing = c.Row(c.Text("Esc to hide", 11, c.Muted), c.Button("\uE74D", "Delete note"));
        c.Place(root, c.Bar(trailing), HorizontalAlignment.Right, VerticalAlignment.Bottom,
            new Thickness(0, 0, 24, 17));

        return root;
    }
}
using Avalonia;
using Avalonia.Controls;
using Avalonia.Layout;
using Avalonia.Media;
using AntiQuickPad.Views.Common;

namespace AntiQuickPad.Views.Card;

internal static class CardLayout
{
    private const double CardMaxWidth = 816;
    private const double PreviousPeekOffset = -862;
    private const double NextPeekOffset = 818;

    public static Control Build(ShellLayoutContext c)
    {
        var root = new Grid
        {
            Background = c.Canvas,
            ClipToBounds = true
        };

        var deck = new Grid
        {
            ClipToBounds = true,
            Margin = new Thickness(0, 82, 0, 62)
        };
        root.Children.Add(deck);

        c.PreviousPeek = CreatePeek(c, "Previous note", PreviousPeekOffset, HorizontalAlignment.Center);
        c.NextPeek = CreatePeek(c, "Next note", NextPeekOffset, HorizontalAlignment.Center);
        deck.Children.Add(c.PreviousPeek); deck.Children.Add(c.NextPeek);

        deck.Children.Add(c.Page);

        c.Place(root, c.Hint, HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(146, 150, 80, 0));

        // Keep the native drag surface below the toolbar controls in z order.
        var drag = new Border
        {
            Background = Brushes.Transparent,
            Height = 58,
            HorizontalAlignment = HorizontalAlignment.Stretch,
            VerticalAlignment = VerticalAlignment.Top
        };
        c.Place(root, c.DragRegion(drag), HorizontalAlignment.Stretch,
            VerticalAlignment.Top, new Thickness(190, 0, 280, 0));

        var title = c.Row(
            c.Text("AntiQuickPad", 14, c.Ink, FontWeight.SemiBold),
            c.Text("  /  Notes", 13, c.Muted));
        c.Place(root, c.Bar(title), HorizontalAlignment.Left, VerticalAlignment.Top,
            new Thickness(30, 28, 0, 0));

        var actions = Capsule(c,
            c.Button("\uE710", "New note"),
            c.Button("\uE74D", "Delete note"),
            c.Button("\uE712", "More"),
            Rule(c),
            c.Button("\uE718", "Pin"),
            c.Button("\uE921", "Minimize"),
            c.Button("\uE8BB", "Hide"));
        c.Place(root, c.Bar(actions), HorizontalAlignment.Right, VerticalAlignment.Top,
            new Thickness(0, 17, 27, 0));

        var pager = Capsule(c,
            c.Button("\uE76B", "Previous"),
            c.Dots,
            c.Button("\uE76C", "Next"));
        c.Place(root, c.Bar(pager), HorizontalAlignment.Center, VerticalAlignment.Bottom,
            new Thickness(0, 0, 0, 12));

        c.Place(root, c.Bar(c.Count), HorizontalAlignment.Left, VerticalAlignment.Bottom,
            new Thickness(33, 0, 0, 28));
        c.Place(root, c.Bar(c.Save), HorizontalAlignment.Right, VerticalAlignment.Bottom,
            new Thickness(0, 0, 31, 28));

        return root;
    }

    private static Control CreatePeek(ShellLayoutContext c, string label, double offset,
        HorizontalAlignment alignment)
    {
        var peek = new Border
        {
            Width = CardMaxWidth,
            MaxWidth = CardMaxWidth,
            Margin = new Thickness(0, 18, 0, 18),
            CornerRadius = new CornerRadius(18),
            Background = c.Surface,
            BorderBrush = c.Rule,
            BorderThickness = new Thickness(1),
            HorizontalAlignment = alignment,
            VerticalAlignment = VerticalAlignment.Stretch,
            IsHitTestVisible = false,
            Child = new Border
            {
                Margin = new Thickness(42, 28, 0, 0),
                VerticalAlignment = VerticalAlignment.Top,
                Child = c.Text(label, 20, c.Muted)
            }
        };

        peek.RenderTransform = new TranslateTransform(offset, 0);
        return peek;
    }

    private static Control Capsule(ShellLayoutContext c, params Control[] children) => new Border
    {
        Padding = new Thickness(9, 5),
        CornerRadius = new CornerRadius(12),
        Background = c.Surface,
        BorderBrush = c.Rule,
        BorderThickness = new Thickness(1),
        BoxShadow = new BoxShadows(new BoxShadow
        {
            OffsetY = 3,
            Blur = 12,
            Color = Color.Parse("#1233486C")
        }),
        Child = c.Row(children)
    };

    private static Control Rule(ShellLayoutContext c) => new Border
    {
        Width = 1,
        Height = 16,
        Background = c.Rule,
        Margin = new Thickness(7, 0)
    };
}


using Avalonia;
using Avalonia.Controls;
using Avalonia.Input;
using Avalonia.Layout;
using Avalonia.Media;
using Avalonia.Controls.Chrome;
using Avalonia.Automation;

namespace AntiQuickPad.Views.Common;

internal sealed class ShellLayoutContext(ResidentShellWindow owner, ShellPalette palette, Control page)
{
    public Look Look => palette.Look;
    public Control Page => page;
    public IBrush Ink => new SolidColorBrush(Look.Foreground);
    public IBrush Muted => new SolidColorBrush(Look.Muted);
    public IBrush Surface => new SolidColorBrush(Look.Background);
    public IBrush Canvas => new SolidColorBrush(palette.Canvas);
    public IBrush Rule => new SolidColorBrush(palette.Rule);
    public TextBlock Count { get; } = new();
    public TextBlock Save { get; } = new();
    public StackPanel Dots { get; } = new() { Orientation = Orientation.Horizontal, Spacing = 7, VerticalAlignment = VerticalAlignment.Center };
    public Control Hint { get; } = new Border { IsVisible = false, IsHitTestVisible = false, VerticalAlignment = VerticalAlignment.Top, Child = new StackPanel { Spacing = 16, Children = {
        new TextBlock { Text = "A fresh thought.", FontSize = 34, FontWeight = FontWeight.SemiBold, Foreground = new SolidColorBrush(palette.Look.Foreground) },
        new TextBlock { Text = "Start typing. This space is yours.", FontSize = 17, Foreground = new SolidColorBrush(palette.Look.Muted) },
        new TextBlock { Text = "Markdown welcome. Everything saves as you go.", FontSize = 13, Foreground = new SolidColorBrush(palette.Look.Muted) }
    } } };
    public bool HasPrevious => owner.ViewModel.CurrentIndex > 0;
    public bool HasNext => owner.ViewModel.CurrentIndex + 1 < owner.ViewModel.Notes.Count;
    public List<Control> Bars { get; } = [];
    public Control? PreviousPeek { get; set; }
    public Control? NextPeek { get; set; }
    public Dictionary<string, Button> Buttons { get; } = [];
    public TextBlock Text(string value, double size, IBrush? brush = null, FontWeight? weight = null) => new()
    { Text = value, FontSize = size, Foreground = brush ?? Ink, FontWeight = weight ?? FontWeight.Normal, VerticalAlignment = VerticalAlignment.Center };
    public Button Button(string glyph, string label)
    {
        var b = new Button { Content = new TextBlock { Text = glyph, FontFamily = new FontFamily("Segoe Fluent Icons"), FontSize = 15, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center },
            Width = 32, Height = 30, Padding = new Thickness(0), CornerRadius = new CornerRadius(6), BorderThickness = new Thickness(0),
            Background = Brushes.Transparent, Foreground = Ink, VerticalAlignment = VerticalAlignment.Center };
        ToolTip.SetTip(b, label); AutomationProperties.SetName(b, label);
        b.Command = owner.CommandFor(label);
        Buttons[label] = b;
        return b;
    }
    public StackPanel Row(params Control[] controls)
    { var row = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 4, VerticalAlignment = VerticalAlignment.Center }; foreach (var c in controls) row.Children.Add(c); return row; }
    public Control Bar(Control control)
    {
        Bars.Add(control);
        void Refresh() => control.Opacity = control.IsPointerOver || control.IsKeyboardFocusWithin ? 1 : .65;
        control.PointerEntered += (_, _) => Refresh(); control.PointerExited += (_, _) => Refresh();
        control.GotFocus += (_, _) => Refresh(); control.LostFocus += (_, _) => Refresh(); Refresh(); return control;
    }
    public Control DragRegion(Control control)
    {
        // Native non-client hit testing preserves Windows drag, double-click maximize and snap docking.
        WindowDecorationProperties.SetElementRole(control, WindowDecorationsElementRole.TitleBar);
        return control;
    }
    public void Place(Grid root, Control control, HorizontalAlignment horizontal, VerticalAlignment vertical, Thickness margin)
    { control.HorizontalAlignment = horizontal; control.VerticalAlignment = vertical; control.Margin = margin; root.Children.Add(control); }
}
using System.Windows.Input;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Input;
using Avalonia.Layout;
using Avalonia.Media;
using Avalonia.Styling;
using Avalonia.Controls.Primitives;
using AntiQuickPad.Carousel;
using AntiQuickPad.Editor;
using AntiQuickPad.ViewModels;

namespace AntiQuickPad.Views.Common;

public sealed partial class ResidentShellWindow
{
    private string _shellId = "quiet";
    private readonly ThemeService _theme;
    private ShellPalette _palette = null!;
    private ShellLayoutContext _layout = null!;
    private Border _menu = null!;
    private Grid _root = null!;
    private readonly Dictionary<string, ICommand> _menuCommands = [];
    private Look CurrentLook => _palette?.Look ?? Look.Default;
    internal string ShellId => _shellId;
    internal ThemeService ThemeService => _theme;

    internal ICommand CommandFor(string label) => label switch
    {
        "New note" => _vm.CreateCommand, "Delete note" => _vm.DeleteCommand,
        "Previous" => _vm.PreviousCommand, "Next" => _vm.NextCommand, "Pin" => _vm.PinCommand,
        "Hide" => new RelayCommand(HideResident), "Minimize" => new RelayCommand(() => WindowState = WindowState.Minimized),
        "More" => new RelayCommand(ToggleMenu), _ => throw new ArgumentException(label)
    };
    internal void SwitchShell(string id)
    {
        if (id is not ("quiet" or "card") || id == _shellId) return;
        if (!SaveNotes()) return;
        _shellId = id; RebuildAppearance(); SaveWindowSnapshot();
    }
    private void SetTheme(string preference)
    {
        _theme.Set(preference); SaveWindowSnapshot();
    }
    private void RebuildAppearance()
    {
        var hadEditor = _editor is not null;
        var caret = hadEditor ? _editor!.CaretOffset : _vm.Current.CaretOffset;
        var text = hadEditor ? _editor!.Text : _vm.Current.Text;
        var scroll = hadEditor ? _editor!.TextArea.TextView.ScrollOffset : default;
        var document = hadEditor ? _editor!.Document : null;
        _carousel?.Cancel();
        _binding = true;
        if (hadEditor) EditorFactory.Release(_editor!);
        _palette = ShellPalette.Get(_shellId, _theme.IsDark);
        var look = _palette.Look with { ModernEditor = true, ActiveLine = _palette.ActiveLine };
        _palette = _palette with { Look = look };
        _binding = true;
        _editor = EditorFactory.Create(look, _vm, document);
        if (!hadEditor) _editor.Text = text;
        _editor.CaretOffset = Math.Clamp(caret, 0, text.Length);
        _binding = false;
        _editor.TextChanged += (_, _) => { RefreshHint(); ScheduleSave(); };
        _editor.TextArea.Caret.PositionChanged += (_, _) => ScheduleSave();
        _editor.TextArea.GotFocus += (_, _) => CompleteFocus();
        _editor.PointerPressed += (_, _) => { if (_menu is not null) _menu.IsVisible = false; };
        _carousel = new CarouselController(_editor, look, _vm, i => _scroll.GetValueOrDefault(_vm.Notes[i].Id), ShowIndicator,
            _shellId == "card" ? DecorateCard : null,
            _shellId == "card" ? width => Math.Min(816, Math.Max(1, width - 144)) + 24 : null);
        _carousel.MotionChanged += RefreshHint;
        _layout = new ShellLayoutContext(this, _palette, _carousel.View);
        Background = _layout.Canvas; Foreground = _layout.Ink; FontFamily = new FontFamily(look.InterfaceFont);
        _root = (Grid)(_shellId == "card" ? Card.CardLayout.Build(_layout) : Quiet.QuietLayout.Build(_layout));
        _menu = BuildMenu(); _root.Children.Add(_menu);
        _frame.Child = _root; Content = _frame;
        _pin.IsChecked = _vm.Pinned;
        if (!hadEditor) _pin.IsCheckedChanged += (_, _) => _vm.Pinned = _pin.IsChecked == true;
        ApplyScrollbarStyle(); UpdateStatus();
        if (hadEditor)
        {
            UpdateLayout(); EditorViewport.Restore(_editor, scroll); FocusEditor();
        }
    }
    private Control DecorateCard(Control editor) => new Border
    {
        MaxWidth = 816, Margin = new Thickness(72, 0), Padding = new Thickness(44, 28, 38, 16),
        CornerRadius = new CornerRadius(16), Background = new SolidColorBrush(CurrentLook.Background),
        BorderBrush = new SolidColorBrush(_palette.Rule), BorderThickness = new Thickness(1),
        BoxShadow = new BoxShadows(new BoxShadow { OffsetY = 8, Blur = 22, Spread = -5, Color = Color.Parse("#2533486C") }),
        Child = editor
    };
    private void ApplyScrollbarStyle()
    {
        Styles.Clear();
        var bar = new Style(x => x.OfType<ScrollBar>());
        bar.Setters.Add(new Setter(ScrollBar.WidthProperty, 6d)); bar.Setters.Add(new Setter(ScrollBar.OpacityProperty, .55));
        bar.Setters.Add(new Setter(ScrollBar.BackgroundProperty, Brushes.Transparent)); Styles.Add(bar);
        var thumb = new Style(x => x.OfType<ScrollBar>().Descendant().OfType<Thumb>());
        thumb.Setters.Add(new Setter(Thumb.BackgroundProperty, _layout.Muted)); thumb.Setters.Add(new Setter(Thumb.MinHeightProperty, 28d)); Styles.Add(thumb);
    }
    private Border BuildMenu()
    {
        _menuCommands.Clear();
        var list = new StackPanel { Spacing = 2 };
        void Item(string label, ICommand command, bool selected = false)
        {
            _menuCommands[label] = command;
            list.Children.Add(new Button { Content = (selected ? "✓  " : "    ") + label, Command = command,
                HorizontalAlignment = HorizontalAlignment.Stretch, HorizontalContentAlignment = HorizontalAlignment.Stretch,
                Height = 32, Padding = new Thickness(10, 0), Background = Brushes.Transparent, Foreground = _layout.Ink,
                BorderThickness = new Thickness(0), CornerRadius = new CornerRadius(5) });
        }
        void Heading(string title) => list.Children.Add(new TextBlock { Text = title, FontSize = 11, Foreground = _layout.Muted, Margin = new Thickness(26, 8, 10, 3) });
        Item("New note", _vm.CreateCommand); Item("Delete note", _vm.DeleteCommand);
        Heading("THEME");
        foreach (var p in new[] { "System", "Light", "Dark" }) Item(p, new RelayCommand(() => SetTheme(p.ToLowerInvariant())), _theme.Preference == p.ToLowerInvariant());
        Heading("SHELL");
        foreach (var p in new[] { "Quiet", "Card" }) Item(p, new RelayCommand(() => SwitchShell(p.ToLowerInvariant())), _shellId == p.ToLowerInvariant());
        list.Children.Add(new Border { Height = 1, Background = _layout.Rule, Margin = new Thickness(26, 6, 10, 6) });
        Item("Quit AntiQuickPad", new RelayCommand(() => Quit()));
        var menu = new Border { Width = 250, HorizontalAlignment = HorizontalAlignment.Right, VerticalAlignment = VerticalAlignment.Top,
            Margin = new Thickness(0, _shellId == "card" ? 66 : 52, 24, 0), Padding = new Thickness(5),
            CornerRadius = new CornerRadius(10), BorderBrush = _layout.Rule, BorderThickness = new Thickness(1),
            Background = _layout.Surface, BoxShadow = new BoxShadows(new BoxShadow { OffsetY = 10, Blur = 30, Color = Color.Parse("#30000000") }), Child = list, IsVisible = false };
        KeyboardNavigation.SetTabNavigation(menu, KeyboardNavigationMode.Cycle);
        menu.KeyDown += (_, e) =>
        {
            if (e.Key is not (Key.Up or Key.Down or Key.Home or Key.End)) return;
            var buttons = list.Children.OfType<Button>().ToList();
            var current = buttons.FindIndex(b => b.IsKeyboardFocusWithin);
            var index = e.Key == Key.Home ? 0 : e.Key == Key.End ? buttons.Count - 1 : (current + (e.Key == Key.Up ? -1 : 1) + buttons.Count) % buttons.Count;
            buttons[index].Focus(); e.Handled = true;
        };
