   if 'row' in r:
    report.append(f\"| {shell}/{theme} | {r['scale']} | {r['row']} | {r['highlightX']:.3f} / {r['highlightRight']:.3f} | {r['checkX']:.3f} / {r['checkInkX']:.3f} | {r['textX']:.3f} / {r['textInkX']:.3f} | {r['height']:.0f} |\")
report+=['', '| Shell/theme | Scale | THEME anchor / ink X | SHELL anchor / ink X | Divider ink X |', '|---|---:|---|---|---:|']
for shell in ['quiet','card']:
 for theme in ['light','dark']:
  data=json.loads((base/f'{shell}-{theme}'/'measurements.json').read_text())
  for scale in [1,1.5]:
   labels=[r for r in data if r['scale']==scale and 'label' in r]; div=next(r for r in data if r['scale']==scale and 'dividerX' in r)
   report.append(f\"| {shell}/{theme} | {scale} | {labels[0]['x']:.3f} / {labels[0]['inkX']:.3f} | {labels[1]['x']:.3f} / {labels[1]['inkX']:.3f} | {div['dividerX']:.3f} |\")
report+=['', '## Render evidence', '', 'All 16 close-ups were opened and visually inspected individually (final source re-render confirmation below). Direct Avalonia production-tree rasters, with a Viewbox at 1x/1.5x; cropping only copies captured pixels. No illustrative reconstruction. Measurements use separate on/off captures to isolate ink from the backdrop. Coverage cutoffs: RGB channel difference sum 80 for text, 8 for divider/capsule, 1 for row-background extent. This bounds antialiased coverage consistently; the quarter-DIP correction is tested on the resulting real pixels.', '', '| Palette | Footer 1x / 1.5x | Menu 1x / 1.5x | Raw measurements |', '|---|---|---|---|']
for shell in ['quiet','card']:
 for theme in ['light','dark']:
