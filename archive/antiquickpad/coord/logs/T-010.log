+            _notes.UpdateCurrent(string.Join('\n', Enumerable.Range(1, 200).Select(n => $"- [ ] Note {i + 1}, line {n}: baseline editor content **bold** and `code`.")), 0);
+        }
+        _notes.Select(19); BindCurrent(); SaveNotes();
+    }
 }
