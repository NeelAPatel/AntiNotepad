using System.Diagnostics;
using System.Runtime.InteropServices;
using Avalonia.Controls;

namespace AntiQuickPad.Shell;

/// <summary>A system-wide hotkey registered against an Avalonia window handle.</summary>
public sealed class GlobalHotkey : IDisposable
{
    private const int HotkeyId = 0x5141;
    private const uint WmHotkey = 0x0312;
    private const uint ModAlt = 0x0001, ModControl = 0x0002, ModShift = 0x0004, ModWin = 0x0008, ModNoRepeat = 0x4000;

    // The default is defined here once. Override with ANTIQUICKPAD_HOTKEY, e.g. Ctrl+Alt+Shift+A.
    public static HotkeyGesture DefaultGesture { get; } = new("Ctrl+Alt+Shift+A", ModControl | ModAlt | ModShift, 0x41);

    private readonly Window _window;
    private readonly HotkeyGesture _gesture;
    private readonly Action<long> _onPressed;
    private IntPtr _hwnd;
    private bool _hookAdded;
    private bool _disposed;

    public bool IsRegistered { get; private set; }
    public int RegistrationError { get; private set; }
    public string? RegistrationErrorMessage => !OperatingSystem.IsWindows()
        ? "Global hotkeys are supported only on Windows."
        : RegistrationError == 0 ? null : new System.ComponentModel.Win32Exception(RegistrationError).Message;
    public string GestureLabel => _gesture.Label;

    public GlobalHotkey(Window window, Action<long> onPressed, string? gesture = null)
    {
        _window = window ?? throw new ArgumentNullException(nameof(window));
        _onPressed = onPressed ?? throw new ArgumentNullException(nameof(onPressed));
        var configured = gesture ?? Environment.GetEnvironmentVariable("ANTIQUICKPAD_HOTKEY");
        _gesture = string.IsNullOrWhiteSpace(configured) ? DefaultGesture : HotkeyGesture.Parse(configured);
        _window.Opened += OnOpened;
        _window.Closed += OnClosed;
        if (_window.IsVisible) Register();
    }

    private void OnOpened(object? sender, EventArgs e) => Register();

    private void Register()
    {
        if (_disposed || !OperatingSystem.IsWindows() || IsRegistered) return;
        _hwnd = _window.TryGetPlatformHandle()?.Handle ?? IntPtr.Zero;
        if (_hwnd == IntPtr.Zero)
        {
            RegistrationError = 1400; // ERROR_INVALID_WINDOW_HANDLE
            return;
        }

        Win32Properties.AddWndProcHookCallback(_window, WndProc);
        _hookAdded = true;
        IsRegistered = RegisterHotKey(_hwnd, HotkeyId, _gesture.Modifiers | ModNoRepeat, _gesture.VirtualKey);
        RegistrationError = IsRegistered ? 0 : Marshal.GetLastWin32Error();
        if (!IsRegistered)
        {
            Win32Properties.RemoveWndProcHookCallback(_window, WndProc);
            _hookAdded = false;
        }
    }

    private IntPtr WndProc(IntPtr hwnd, uint message, IntPtr wParam, IntPtr lParam, ref bool handled)
    {
        if (message == WmHotkey && wParam.ToInt32() == HotkeyId)
        {
            handled = true;
            _onPressed(Stopwatch.GetTimestamp());
        }
        return IntPtr.Zero;
    }

    private void OnClosed(object? sender, EventArgs e) => Dispose();

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _window.Opened -= OnOpened;
        _window.Closed -= OnClosed;
        if (OperatingSystem.IsWindows())
        {
            if (IsRegistered) UnregisterHotKey(_hwnd, HotkeyId);
            if (_hookAdded) Win32Properties.RemoveWndProcHookCallback(_window, WndProc);
        }
        IsRegistered = false;
    }

    public readonly record struct HotkeyGesture(string Label, uint Modifiers, int VirtualKey)
    {
        public static HotkeyGesture Parse(string value)
        {
            var parts = value.Split('+', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length < 2) throw new FormatException("Hotkey must include a modifier and a key, for example Ctrl+Alt+Shift+A.");
            uint modifiers = 0;
            int key = 0;
            foreach (var part in parts)
            {
                switch (part.ToLowerInvariant())
                {
                    case "ctrl": case "control": modifiers |= ModControl; break;
                    case "alt": modifiers |= ModAlt; break;
                    case "shift": modifiers |= ModShift; break;
                    case "win": case "windows": modifiers |= ModWin; break;
                    default:
                        if (key != 0) throw new FormatException("Hotkey must contain exactly one key.");
                        key = ParseVirtualKey(part);
                        break;
                }
            }
            if (modifiers == 0 || key == 0) throw new FormatException("Hotkey must include modifiers and one supported key.");
            return new HotkeyGesture(string.Join('+', parts), modifiers, key);
        }

        private static int ParseVirtualKey(string key)
        {
            if (key.Length == 1 && char.IsAsciiLetterOrDigit(key[0])) return char.ToUpperInvariant(key[0]);
            if (key.Length >= 2 && (key[0] is 'F' or 'f') && int.TryParse(key.AsSpan(1), out var function) && function is >= 1 and <= 24)
                return 0x70 + function - 1;
            return key.ToLowerInvariant() switch
            {
                "space" => 0x20, "escape" or "esc" => 0x1B, "tab" => 0x09,
                "enter" => 0x0D, "insert" => 0x2D, "delete" => 0x2E,
                _ => throw new FormatException($"Unsupported hotkey key '{key}'. Use A-Z, 0-9, F1-F24, Space, Escape, Tab, Enter, Insert, or Delete.")
            };
        }
    }

    [DllImport("user32.dll", SetLastError = true)] private static extern bool RegisterHotKey(IntPtr hWnd, int id, uint modifiers, int key);
    [DllImport("user32.dll", SetLastError = true)] private static extern bool UnregisterHotKey(IntPtr hWnd, int id);
}
using System.Diagnostics;
using System.IO.MemoryMappedFiles;
using System.Security.Cryptography;
using System.Text;

namespace AntiQuickPad.Shell;

/// <summary>Per-Windows-user process singleton with a signal for an already-running instance.</summary>
public sealed class SingleInstanceService : IDisposable
{
    private readonly Mutex _mutex;
    private readonly EventWaitHandle _showSignal;
    private readonly EventWaitHandle _quitSignal;
    private readonly MemoryMappedFile? _owner;
    private readonly Action? _onQuit;
    private readonly Action _onSecondLaunch;
    private readonly CancellationTokenSource _stop = new();
    private readonly Thread? _listener;
    private readonly int _ownerThreadId;
    private bool _disposed;

    public bool IsPrimary { get; }
    public bool WasAbandoned { get; }

    public SingleInstanceService(Action onSecondLaunch, string applicationId = "AntiQuickPad", Action? onQuit = null)
    {
        _onSecondLaunch = onSecondLaunch ?? throw new ArgumentNullException(nameof(onSecondLaunch));
        ArgumentException.ThrowIfNullOrWhiteSpace(applicationId);
        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException("Single-instance coordination is currently supported on Windows only.");

        _onQuit = onQuit;
        var stem = ObjectStem(applicationId);
        _mutex = new Mutex(false, $"{stem}-Mutex");
        _showSignal = new EventWaitHandle(false, EventResetMode.AutoReset, $"{stem}-Show");
        _quitSignal = new EventWaitHandle(false, EventResetMode.AutoReset, $"{stem}-Quit");
        _ownerThreadId = Environment.CurrentManagedThreadId;

        try
        {
            try { IsPrimary = _mutex.WaitOne(0); }
            catch (AbandonedMutexException) { IsPrimary = true; WasAbandoned = true; }

            if (IsPrimary)
            {
                _owner = MemoryMappedFile.CreateOrOpen($"{stem}-Owner", 4);
                using (var data = _owner.CreateViewAccessor()) data.Write(0, Environment.ProcessId);
                _listener = new Thread(Listen) { IsBackground = true, Name = $"{applicationId} lifetime listener" };
                _listener.Start();
            }
            else _showSignal.Set();
        }
        catch
        {
            _owner?.Dispose(); _quitSignal.Dispose(); _showSignal.Dispose();
            if (IsPrimary) _mutex.ReleaseMutex();
            _mutex.Dispose();
            throw;
        }
    }

    private static string ObjectStem(string applicationId)
    {
        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException();
        // Local\ keeps objects within the current logon session; the SID-derived suffix separates users.
        var sid = System.Security.Principal.WindowsIdentity.GetCurrent().User?.Value
                  ?? $"{Environment.UserDomainName}\\{Environment.UserName}";
        var suffix = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(sid)))[..20];
        return $"Local\\{applicationId}-{suffix}";
    }

    // This client opens only existing objects: it never claims residency or sends Show.
    public static int RequestQuit(string applicationId = "AntiQuickPad")
    {
        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException();
        var timer = Stopwatch.StartNew();
        var stem = ObjectStem(applicationId);
        try
        {
            if (!Mutex.TryOpenExisting($"{stem}-Mutex", out var mutex)) return 0;
            using (mutex)
            {
                bool idle;
                try { idle = mutex.WaitOne(0); }
                catch (AbandonedMutexException) { idle = true; }
                if (idle) { mutex.ReleaseMutex(); return 0; }
                // A primary may still be publishing its PID during startup.
                while (timer.ElapsedMilliseconds < 5000)
                {
                    try
                    {
                        using var owner = MemoryMappedFile.OpenExisting($"{stem}-Owner", MemoryMappedFileRights.Read);
                        using var data = owner.CreateViewAccessor(0, 4, MemoryMappedFileAccess.Read);
                        var pid = data.ReadInt32(0);
                        if (pid <= 0) { Thread.Sleep(10); continue; }
                        Process process;
                        try { process = Process.GetProcessById(pid); }
                        catch (ArgumentException) { return 0; }
                        using (process)
                        using (var quit = EventWaitHandle.OpenExisting($"{stem}-Quit"))
                        {
                            quit.Set();
                            if (process.WaitForExit(Math.Max(0, 5000 - (int)timer.ElapsedMilliseconds))) return 0;
                            break;
                        }
                    }
                    catch (FileNotFoundException) { Thread.Sleep(10); }
                    catch (WaitHandleCannotBeOpenedException) { Thread.Sleep(10); }
                }
            }
            Console.Error.WriteLine("AntiQuickPad --quit: resident did not exit within 5 seconds.");
            return 1;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"AntiQuickPad --quit: {ex.Message}"); return 1;
        }
    }

    private void Listen()
    {
        var handles = new WaitHandle[] { _showSignal, _quitSignal, _stop.Token.WaitHandle };
        while (true)
        {
            var signal = WaitHandle.WaitAny(handles);
            if (signal == 2 || _stop.IsCancellationRequested) break;
            try { if (signal == 1) _onQuit?.Invoke(); else _onSecondLaunch(); }
            catch { /* Owner callbacks cannot kill the lifetime listener. */ }
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        if (IsPrimary && Environment.CurrentManagedThreadId != _ownerThreadId)
            throw new InvalidOperationException("Dispose the primary SingleInstanceService on the thread that created it, because that thread owns the named mutex.");

        _disposed = true;
        _stop.Cancel();
        _listener?.Join();
        _showSignal.Dispose();
        _quitSignal.Dispose();
        _owner?.Dispose();
        _stop.Dispose();
        if (IsPrimary) _mutex.ReleaseMutex();
        _mutex.Dispose();
    }
}

