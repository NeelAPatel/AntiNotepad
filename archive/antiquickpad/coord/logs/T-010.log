    private async Task RunCarouselSmoke()
    {
        CarouselController.RunSmoke();
        CreateNote(); SelectNote(0);
        _carousel.RequestWheel(1, 0);
        for (var t = 20; t <= 180; t += 20) _carousel.RequestWheel(1, t);
        await Task.Delay(300);
        _carousel.RequestWheel(1, 250); // trailing event of the same burst, after animation
        await Task.Delay(60);
        if (_notes.CurrentIndex != 1 || _carousel.IsBusy) throw new Exception("Integrated wheel notch/burst double skip.");
        var width = _carousel.View.Bounds.Width;
        _carousel.BeginDrag(0, 1000); _carousel.MoveDrag(-width * .6, 2000);
        if (Math.Abs(((TranslateTransform)_editor.RenderTransform!).X + width * .6) > 1)
            throw new Exception("Drag was not 1:1.");
        _carousel.EndDrag(2100); await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated long drag did not snap to next note.");
        _carousel.BeginDrag(0, 3000); _carousel.MoveDrag(20, 3100); _carousel.EndDrag(3250);
        await Task.Delay(300);
        if (_notes.CurrentIndex != 2) throw new Exception("Integrated short drag did not return.");
        _editor.Text = string.Join('\n', Enumerable.Range(0, 120).Select(i => $"Line {i} saved scroll"));
        _editor.CaretOffset = 7; await Task.Delay(60);
        _editor.UpdateLayout(); _editor.TextArea.TextView.EnsureVisualLines();
        EditorViewport.Restore(_editor, new Vector(0, 300));
        await Task.Delay(120);
        var saved = _editor.VerticalOffset;
        SelectNote(1); SelectNote(2); await Task.Delay(60);
        if (_editor.CaretOffset != 7 || saved < 100 || Math.Abs(_editor.VerticalOffset - saved) > 1)
            throw new Exception($"Caret/scroll restore failed: caret={_editor.CaretOffset} scroll={_editor.VerticalOffset} expected={saved} editor={_editor.Bounds} documentHeight={_editor.TextArea.TextView.DocumentHeight}.");
        _carousel.BeginDrag(0, 4000); _carousel.MoveDrag(40, 4100); _carousel.Cancel();
        if (_carousel.IsBusy || _editor.IsReadOnly || ((TranslateTransform)_editor.RenderTransform!).X != 0)
            throw new Exception("Drag cancellation failed.");
        DeleteCurrentNote(); DeleteCurrentNote(); DeleteCurrentNote();
        if (_notes.Notes.Count != 1) throw new Exception("Delete must keep one note.");
        Console.WriteLine("M4 PASS: integrated notch/burst; 1:1 drag; long/short snap; caret/scroll; cancellation; delete keeps one note.");
    }
    private static Process StartChild(params string[] args) => StartChild(false, args);
    private static Process StartChild(bool captureError, params string[] args)
    {
        var executable = Environment.ProcessPath!;
        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardError = captureError };
        if (string.Equals(Path.GetFileNameWithoutExtension(executable), "dotnet", StringComparison.OrdinalIgnoreCase))
            start.ArgumentList.Add(typeof(Program).Assembly.Location);
        foreach (var arg in args) start.ArgumentList.Add(arg);
        return Process.Start(start) ?? throw new Exception("Could not start child.");
    }
    private static async Task RunCommandQuitSmoke()
    {
        var id = "AntiQuickPad-quit-" + Guid.NewGuid().ToString("N");
        var root = Path.Combine(Program.Paths.Root, "command-resident");
        Directory.CreateDirectory(root);
        using (var resident = StartChild("--selftest-quit-resident", id, root))
        {
            var ready = Path.Combine(root, "ready");
            var timer = Stopwatch.StartNew();
            while (!File.Exists(ready) && !resident.HasExited && timer.Elapsed < TimeSpan.FromSeconds(5)) await Task.Delay(20);
            if (!File.Exists(ready)) throw new Exception("Quit resident not ready.");
            using var command = StartChild("--selftest-quit", id);
            await command.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(6));
            if (command.ExitCode != 0 || !resident.HasExited || resident.ExitCode != 0) throw new Exception("Command did not await clean resident exit.");
            var paths = new RuntimePaths(root);
            var log = File.ReadAllText(paths.Log);
            if (!log.Contains("quit-start source=command") || !log.Contains("quit-finish window-closed=true source=command") || log.Contains("source=second-launch"))
                throw new Exception("Command quit source/show logging failed.");
            if (new NotesSession(paths.Notes).Current.Text != "command quit saves this pending edit") throw new Exception("Command quit did not save.");
            Console.WriteLine($"T009 command quit PASS: isolated resident exit=0, pending edit saved, source=command start/finish, no Show signal; elapsed={timer.ElapsedMilliseconds}ms.");
        }
        using (var absent = StartChild("--selftest-quit", id))
        {
            await absent.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(2));
            if (absent.ExitCode != 0) throw new Exception("No-resident quit failed.");
        }
        var stalledReady = Path.Combine(root, "stalled-ready");
        using var stalled = StartChild("--selftest-quit-stalled", id, stalledReady);
        while (!File.Exists(stalledReady) && !stalled.HasExited) await Task.Delay(20);
        var timeout = Stopwatch.StartNew();
        using var timed = StartChild(true, "--selftest-quit", id);
        await timed.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(6));
        if (timed.ExitCode != 1 || timeout.ElapsedMilliseconds < 4900 || timeout.ElapsedMilliseconds > 5900) throw new Exception("Quit timeout contract failed.");
        if (!(await timed.StandardError.ReadToEndAsync()).Contains("resident did not exit within 5 seconds")) throw new Exception("Quit timeout message missing.");
        Console.WriteLine($"T009 timeout PASS: exit=1 after {timeout.ElapsedMilliseconds}ms; no-resident exit=0.");
        await stalled.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(3));
    }
    private static async Task RunChild(string mode, string argument)
    {
        var executable = Environment.ProcessPath!;
        var start = new ProcessStartInfo(executable) { UseShellExecute = false, CreateNoWindow = true };
        if (string.Equals(Path.GetFileNameWithoutExtension(executable), "dotnet", StringComparison.OrdinalIgnoreCase))
            start.ArgumentList.Add(typeof(Program).Assembly.Location);
        start.ArgumentList.Add(mode); start.ArgumentList.Add(argument);
        using var process = Process.Start(start) ?? throw new Exception("Could not start selftest child.");
        try { await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(5)); }
        catch { throw; }
        if (process.ExitCode != 0) throw new Exception($"{mode} child exit={process.ExitCode}");
    }
    private void Log(string message) => _log.WriteLine($"{DateTimeOffset.UtcNow:O} {message}");
}
using System.Text.Json;

namespace AntiQuickPad.Notes;

/// <summary>Loads and persists a small ordered collection of plain Markdown notes.</summary>
public sealed class NotesSession
{
    private const string StateFileName = "notes.json";
    private readonly string _directory;
    private readonly string _statePath;
    private List<Note> _notes;

    public NotesSession(string directory)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(directory);
        _directory = Path.GetFullPath(directory);
        _statePath = Path.Combine(_directory, StateFileName);

        if (File.Exists(_statePath))
        {
            (_notes, CurrentIndex) = Load();
        }
        else
        {
            _notes = [NewEmptyNote()];
            CurrentIndex = 0;
            Save();
        }
    }

    public IReadOnlyList<Note> Notes => _notes.AsReadOnly();
    public int CurrentIndex { get; private set; }
    public Note Current => _notes[CurrentIndex];

    public Note CreateNote()
    {
        var note = NewEmptyNote();
        _notes.Add(note);
        CurrentIndex = _notes.Count - 1;
        return note;
    }

    public void DeleteCurrent()
    {
        var removed = Current;
        _notes.RemoveAt(CurrentIndex);
        if (_notes.Count == 0)
        {
            _notes.Add(NewEmptyNote());
            CurrentIndex = 0;
        }
        else if (CurrentIndex >= _notes.Count)
        {
            CurrentIndex = _notes.Count - 1;
        }

        // Persist the new index/order before removing content, so a failed manifest
        // write never leaves a manifest pointing at a deleted note.
        Save();
        var oldPath = NotePath(removed.Id);
        if (File.Exists(oldPath)) File.Delete(oldPath);
    }

    public void Select(int index)
    {
        ArgumentOutOfRangeException.ThrowIfNegative(index);
        ArgumentOutOfRangeException.ThrowIfGreaterThanOrEqual(index, _notes.Count);
        CurrentIndex = index;
    }

    public void UpdateCurrent(string text, int caretOffset)
    {
        ArgumentNullException.ThrowIfNull(text);
        _notes[CurrentIndex] = Current with
        {
            Text = text,
            CaretOffset = Math.Clamp(caretOffset, 0, text.Length)
        };
    }

    /// <summary>Atomically replaces each Markdown file and then the session manifest.</summary>
    public void Save()
    {
        Directory.CreateDirectory(_directory);
        foreach (var note in _notes)
            AtomicWrite(NotePath(note.Id), note.Text);

        var manifest = new StateDto
        {
            CurrentIndex = CurrentIndex,
            Notes = _notes.Select(n => new NoteDto { Id = n.Id, CaretOffset = n.CaretOffset }).ToList()
        };
        AtomicWrite(_statePath, JsonSerializer.Serialize(manifest, JsonOptions));
    }

    /// <summary>Exercises create, edit, save, and reload without touching user data.</summary>
    public static bool RunPersistenceSmoke(string parentDirectory)
    {
        var scratch = Path.Combine(Path.GetFullPath(parentDirectory), "notes-smoke-" + Guid.NewGuid().ToString("N"));
        try
        {
            var first = new NotesSession(scratch);
            first.UpdateCurrent("# round trip\n", 4);
            first.CreateNote();
            first.UpdateCurrent("second", 3);
            first.Select(0);
            first.Save();

            var restored = new NotesSession(scratch);
            var roundTrip = restored.Notes.Count == 2
                && restored.CurrentIndex == 0
                && restored.Current.Text == "# round trip\n"
                && restored.Current.CaretOffset == 4
                && restored.Notes[1].Text == "second"
                && restored.Notes[1].CaretOffset == 3;
            var deletedId = restored.Current.Id;
            restored.DeleteCurrent();
            var afterDelete = new NotesSession(scratch);
            var deleted = afterDelete.Notes.Count == 1 && afterDelete.Current.Text == "second"
                && !File.Exists(Path.Combine(scratch, deletedId + ".md"));
            afterDelete.DeleteCurrent();
            var afterLastDelete = new NotesSession(scratch);
            return roundTrip && deleted && afterLastDelete.Notes.Count == 1
                && afterLastDelete.Current.Text == string.Empty && afterLastDelete.CurrentIndex == 0;
        }
        finally
        {
            if (Directory.Exists(scratch)) Directory.Delete(scratch, recursive: true);
        }
    }

    private (List<Note> Notes, int CurrentIndex) Load()
    {
        try
        {
            var json = File.ReadAllText(_statePath);
            var state = JsonSerializer.Deserialize<StateDto>(json, JsonOptions)
                ?? throw new InvalidDataException("Notes manifest is empty.");
            if (state.Notes is null || state.Notes.Count == 0)
                throw new InvalidDataException("Notes manifest contains no notes.");
            if (state.CurrentIndex < 0 || state.CurrentIndex >= state.Notes.Count)
                throw new InvalidDataException("Notes manifest current index is out of range.");

            var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var notes = new List<Note>(state.Notes.Count);
            foreach (var entry in state.Notes)
            {
                if (!Guid.TryParseExact(entry.Id, "N", out _) || !ids.Add(entry.Id))
                    throw new InvalidDataException("Notes manifest contains an invalid or duplicate note id.");
                var text = File.ReadAllText(NotePath(entry.Id));
                notes.Add(new Note(entry.Id, text, Math.Clamp(entry.CaretOffset, 0, text.Length)));
            }

            return (notes, state.CurrentIndex);
        }
        catch (JsonException ex)
        {
            throw new InvalidDataException("Notes manifest is corrupt; it was left untouched.", ex);
        }
    }

    private static Note NewEmptyNote() => new(Guid.NewGuid().ToString("N"), string.Empty, 0);
    private string NotePath(string id) => Path.Combine(_directory, id + ".md");

    private static void AtomicWrite(string destination, string contents)
    {
        var temp = destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
        try
        {
            File.WriteAllText(temp, contents);
            File.Move(temp, destination, overwrite: true);
        }
        finally
        {
            if (File.Exists(temp)) File.Delete(temp);
        }
    }

    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };

    private sealed class StateDto
    {
        public int CurrentIndex { get; set; }
        public List<NoteDto>? Notes { get; set; }
    }

    private sealed class NoteDto
    {
        public string Id { get; set; } = string.Empty;
        public int CaretOffset { get; set; }
    }
}
