using AvaloniaEdit.Document;

namespace InputProbe;

internal static class EditorOperations
{
    internal readonly record struct TabResult(int CaretOffset, int? SelectionStart, int? SelectionEnd, bool Changed);

    public static string? ToggleCheckbox(TextDocument document, int markerOffset, ref int caretOffset)
    {
        if (markerOffset < 0 || markerOffset + 3 > document.TextLength) return null;
        var token = document.GetText(markerOffset, 3);
        var replacement = token.Equals("[ ]", StringComparison.Ordinal) ? "[x]" :
            token.Equals("[x]", StringComparison.OrdinalIgnoreCase) ? "[ ]" : null;
        if (replacement is null) return null;
        document.Replace(markerOffset, 3, replacement);
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        return replacement;
    }

    // This is the shared handler path for keyboard input and smoke checks. A null
    // selection means a caret-only edit on the current line.
    public static TabResult ApplyTab(TextDocument document, int caretOffset, int? selectionStart, int? selectionEnd, bool outdent)
    {
        caretOffset = Math.Clamp(caretOffset, 0, document.TextLength);
        if (selectionStart is null || selectionEnd is null || selectionStart == selectionEnd)
        {
            var line = document.GetLineByOffset(caretOffset);
            var prefixLength = Math.Min(line.Length, 4);
            var prefix = document.GetText(line.Offset, prefixLength);
            if (outdent)
            {
                var remove = prefix.StartsWith('\t') ? 1 : prefix.TakeWhile(c => c == ' ').Count();
                remove = Math.Min(remove, 4);
                if (remove == 0) return new(caretOffset, null, null, false);
                document.Remove(line.Offset, remove);
                return new(Math.Max(line.Offset, caretOffset >= line.Offset + remove ? caretOffset - remove : caretOffset), null, null, true);
            }

            document.Insert(caretOffset, "    ");
            return new(caretOffset + 4, null, null, true);
        }

        var start = Math.Clamp(Math.Min(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var end = Math.Clamp(Math.Max(selectionStart.Value, selectionEnd.Value), 0, document.TextLength);
        var first = document.GetLineByOffset(start);
        var last = document.GetLineByOffset(Math.Max(start, end - 1));
        var lineNumbers = new List<int>();
        for (var line = first; line.LineNumber <= last.LineNumber; line = line.NextLine!)
        {
            lineNumbers.Add(line.LineNumber);
            if (line == last || line.NextLine is null) break;
        }

        var caret = caretOffset;
        var a = selectionStart.Value;
        var b = selectionEnd.Value;
        var changed = false;
        document.BeginUpdate();
        try
        {
            foreach (var number in lineNumbers.Distinct().OrderByDescending(x => x))
            {
                var line = document.GetLineByNumber(number);
                if (!outdent)
                {
                    document.Insert(line.Offset, "    ");
                    caret = MapInsert(caret, line.Offset, 4); a = MapInsert(a, line.Offset, 4); b = MapInsert(b, line.Offset, 4);
                    changed = true;
                }
                else
                {
                    var prefix = document.GetText(line.Offset, Math.Min(4, line.Length));
                    var remove = prefix.StartsWith('\t') ? 1 : prefix.TakeWhile(c => c == ' ').Count();
                    if (remove > 0)
                    {
                        document.Remove(line.Offset, remove);
                        caret = MapRemove(caret, line.Offset, remove); a = MapRemove(a, line.Offset, remove); b = MapRemove(b, line.Offset, remove);
                        changed = true;
                    }
                }
            }
        }
        finally { document.EndUpdate(); }
        return new(caret, a, b, changed);
    }

    private static int MapInsert(int offset, int at, int length) => offset >= at ? offset + length : offset;
    private static int MapRemove(int offset, int at, int length) => offset >= at + length ? offset - length : offset >= at ? at : offset;
}
using System.Text.Json;

namespace InputProbe;

internal sealed class Note
{
    public string Id { get; set; } = Guid.NewGuid().ToString("N");
    public string Text { get; set; } = "";
}

internal sealed class NoteStore(string path)
{
    public string Path { get; } = path;
    public List<Note> Load()
    {
        try
        {
            if (!File.Exists(Path)) return [new Note { Text = Fixture }];
            var notes = JsonSerializer.Deserialize<List<Note>>(File.ReadAllText(Path));
            return notes is { Count: > 0 } ? notes : [new Note { Text = Fixture }];
        }
        catch { return [new Note { Text = Fixture }]; }
    }

    public void Save(IReadOnlyList<Note> notes)
    {
        Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Path)!);
        var clean = notes.Select(n => new Note { Id = n.Id, Text = n.Text }).ToList();
        var temp = Path + ".tmp";
        File.WriteAllText(temp, JsonSerializer.Serialize(clean, new JsonSerializerOptions { WriteIndented = true }));
        File.Move(temp, Path, true);
    }

    public static string Fixture => "# AntiQuickPad spike\n\n## A focused scratchpad\n\nVisible **bold**, *italic*, and ~~strike~~ markers remain editable.\n\n- [ ] Click the checkbox marker to toggle it (undo with Ctrl+Z)\n- [x] Keep notes local\n\n```python\ndef quick_note():\n    return 'wrapped and highlighted'\n```\n\nDrag the grab strip to move notes. Mouse wheel tilts by about 120 px per notch.";
}

internal static class CarouselMath
{
    public static double WheelDeltaToPixels(double delta) => -delta * 120d;
    public static double DragDelta(double origin, double current) => current - origin;
    public static bool ShouldCreateNote(int index, int count, double displacement) => count > 0 && index == count - 1 && displacement < -170;
    public static double RubberBand(double offset, double limit = 180) => Math.Sign(offset) * limit * (1 - Math.Exp(-Math.Abs(offset) / limit));
    public static int SnapIndex(int current, double displacement, double velocityPxPerMs, int count, bool wheel = false)
    {
        if (count < 1) return 0;
        var threshold = wheel ? 60d : 170d;
        var direction = displacement < -threshold || velocityPxPerMs < -.55 ? 1 : displacement > threshold || velocityPxPerMs > .55 ? -1 : 0;
        return Math.Clamp(current + direction, 0, count - 1);
    }
    public static List<Note> PruneInteriorBlanks(IReadOnlyList<Note> notes)
    {
        var result = notes.Where((n, i) => !string.IsNullOrWhiteSpace(n.Text) || i == notes.Count - 1).ToList();
        return result.Count == 0 ? [new Note()] : result;
    }
}

internal readonly record struct WheelBurstResult(int TargetIndex, bool CreateAtNewestEdge, int BurstNumber);

// Treat a burst as one page request. A quick reversal changes the requested
// destination for that same burst instead of queueing another page animation.
internal sealed class WheelBurstState
{
    public const int IdleGapMs = 140;
    private int _startIndex;
    private int _count;
    private int _direction;
    private long _lastEventMs;
    private int _burstNumber;
    public bool IsActive { get; private set; }
    public long LastEventMs => _lastEventMs;
    public int BurstNumber => _burstNumber;

    public WheelBurstResult Add(int settledIndex, int noteCount, double delta, long nowMs)
    {
        if (Math.Abs(delta) < .001 || noteCount < 1) return new(settledIndex, false, _burstNumber);
        if (!IsActive || nowMs - _lastEventMs > IdleGapMs)
        {
            _startIndex = Math.Clamp(settledIndex, 0, noteCount - 1);
            _count = noteCount;
            _direction = 0;
            _burstNumber++;
            IsActive = true;
        }

        _direction = Math.Sign(delta);
        _lastEventMs = nowMs;
        var requested = _startIndex + _direction;
        return new(Math.Clamp(requested, 0, _count - 1), requested >= _count, _burstNumber);
    }

    public bool IsExpired(long nowMs) => IsActive && nowMs - _lastEventMs > IdleGapMs;

    public WheelBurstResult Complete()
    {
        var requested = _startIndex + _direction;
        var result = new WheelBurstResult(Math.Clamp(requested, 0, Math.Max(0, _count - 1)), requested >= _count, _burstNumber);
        IsActive = false;
        return result;
    }
}
