    fn wheel(&mut self, dx: f32, window: &mut Window, cx: &mut Context<Self>) {
        self.stats.borrow_mut().wheel_events += 1;
        let now = self.now();
        let event = self.carousel.wheel(&mut self.book, dx as f64, now);
        if event == CarouselEvent::None { self.stats.borrow_mut().coalesced_wheel += 1; }
        self.after_page(event, window, cx);
    }
    fn tick(&mut self, window: &mut Window, cx: &mut Context<Self>) {
        let events = self
            .shell
            .as_mut()
            .map(|native| native.poll())
            .unwrap_or_default();
        for event in events {
            match event {
                shell::ShellEvent::Shown => {
                    cx.activate(true);
                    self.focus_editor(window, cx);
                    log_line(&self.log, "EDITOR_REFOCUS", "show_event");
                    let log = self.log.clone();
                    let state = self
                        .editors
                        .get(&self.book.notes[self.book.current_index].id)
                        .unwrap()
                        .clone();
                    window.on_next_frame(move |window, cx| {
                        log_line(
                            &log,
                            "SHOW_EDITABLE_FRAME",
                            &format!(
                                "editor_focus={}",
                                state.read(cx).focus_handle(cx).is_focused(window)
                            ),
                        );
                    });
                }
                shell::ShellEvent::Hidden => {
                    self.sync_text(cx);
                    self.save();
                    self.drag = None;
                }
                shell::ShellEvent::Quit => {
                    self.sync_text(cx);
                    self.save();
                    cx.quit();
                    return;
                }
                shell::ShellEvent::Error(error) => {
                    self.status = error;
                    cx.notify();
                }
            }
        }
        let moving = self.drag.is_some() || self.carousel.x.abs() > 0.0001;
        self.stats.borrow_mut().state(moving);
        let sample = self.stats.borrow_mut().sample();
        if let Some(sample) = sample { log_line(&self.log, "FRAME_STATS", &sample); }
        if self.dirty && !moving && self.last_edit.elapsed() > Duration::from_millis(500) {
            self.sync_text(cx);
            self.save();
            cx.notify();
        }
    }
    fn material(&mut self, mode: usize, window: &mut Window, cx: &mut Context<Self>) {
        self.material = mode;
        if let Some(native) = &mut self.shell {
            native.clear_backdrop();
        }
        window.set_background_appearance(WindowBackgroundAppearance::Opaque);
        window.set_background_appearance(match mode {
            0 => WindowBackgroundAppearance::Transparent,
            1 => WindowBackgroundAppearance::MicaBackdrop,
            _ => WindowBackgroundAppearance::Blurred,
        });
        log_line(
            &self.log,
            "MATERIAL_REQUEST",
            &["Transparent", "MicaBackdrop", "Blurred"][mode],
        );
        cx.notify();
    }
}
impl Render for Scratchpad {
    fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
        self.width = (f32::from(window.viewport_size().width) - 32.0).max(320.0);
        let width = self.width;
        self.stats.borrow_mut().renders += 1;
        self.stats.borrow_mut().state(self.drag.is_some() || self.carousel.x.abs()>0.0001);
        if !self.first_frame {
            self.first_frame = true;
            let started = self.start;
            };
            if posted == 0 {
                let error = message_error("PostMessageW(WM_HOTKEY self-check probe)");
                shell.dispose();
                return Err(error);
            }
            let deadline = Instant::now() + Duration::from_secs(2);
            while !shell.shared.self_check_ack.load(Ordering::Acquire) && Instant::now() < deadline {
                thread::sleep(Duration::from_millis(5));
            }
            let passed = shell.shared.self_check_ack.load(Ordering::Acquire);
            let chord = shell.active_hotkey().to_owned();
            shell.dispose();
            if !passed {
                return Err(ShellError("posted WM_HOTKEY self-check probe was not dispatched within 2000ms".into()));
            }
            Ok(format!("registered={chord}; posted WM_HOTKEY dispatch round-trip=passed; physical keystroke delivery=not tested"))
        }

        /// Bind after GPUI creates its top-level window. Matching is constrained
        /// to this process, exact title, unowned top-level HWND, and a real window.
        pub fn bind(&mut self, title: &str) -> Result<(), ShellError> {
            self.title = title.to_owned();
            let mut query = FindWindowQuery {
                process: unsafe { GetCurrentProcessId() },
                title: wide(title),
                class: wide(GPUI_WINDOW_CLASS),
                found: null_mut(),
            };
            unsafe {
                EnumWindows(Some(find_exact_window), &mut query as *mut _ as Lparam);
            }
            if query.found.is_null() {
                log(
                    &self.log_path,
                    "SHELL_ERROR",
                    &format!(
                        "bind failed: no unowned {GPUI_WINDOW_CLASS} top-level window in this process with exact title {:?}",
                        title
                    ),
                );
                return Err(ShellError(format!(
                    "could not bind GPUI window with exact title {title:?}; call bind after open_window creates it"
                )));
            }
            self.shared
                .target_hwnd
                .store(query.found as isize, Ordering::Release);
            let started = Instant::now();
            unsafe {
                ShowWindow(query.found, SW_HIDE);
            }
            log(
                &self.log_path,
                "HIDE",
                &format!("initial_hide_request_us={}", started.elapsed().as_micros()),
            );
            Ok(())
        }

        /// Drain native messages. Call from the GPUI main-thread timer/tick.
        pub fn poll(&mut self) -> Vec<ShellEvent> {
            let mut events = Vec::new();
            while let Ok(event) = self.rx.try_recv() {
                events.push(event);
            }
            let started = self.shared.show_started_us.load(Ordering::Acquire);
            if started != 0 {
                let hwnd = self.shared.target_hwnd.load(Ordering::Acquire) as Hwnd;
                if !hwnd.is_null()
                    && unsafe { IsWindowVisible(hwnd) != 0 && GetForegroundWindow() == hwnd }
                    && !self.shared.ready_logged.swap(true, Ordering::AcqRel)
                {
                    let now = epoch_micros();
                    log(
                        &self.log_path,
                        "SHOW_READY",
                        &format!(
                            "show_to_visible_and_foreground_us={}",
                            now.saturating_sub(started)
                        ),
                    );
                    self.shared.show_started_us.store(0, Ordering::Release);
                } else if epoch_micros().saturating_sub(started) > 2_000_000 {
                    log(
                        &self.log_path,
                        "SHOW_TIMEOUT",
                        "window did not become visible and foreground within 2000ms",
                    );
                    self.shared.show_started_us.store(0, Ordering::Release);
                }
            }
            events
        }

        #[allow(dead_code)] // Available for app commands; hotkey/tray use the native dispatcher.
        pub fn toggle(&mut self) -> Result<(), ShellError> {
            let hwnd = self.window()?;
            native_set_visible(&self.shared, unsafe { IsWindowVisible(hwnd) == 0 });
            Ok(())
        }

        pub fn show(&mut self) -> Result<(), ShellError> {
            self.window()?;
            native_set_visible(&self.shared, true);
            Ok(())
        }

        pub fn hide(&mut self) -> Result<(), ShellError> {
            self.window()?;
            native_set_visible(&self.shared, false);
            Ok(())
        }

