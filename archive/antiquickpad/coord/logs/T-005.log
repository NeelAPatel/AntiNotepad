    private static readonly Regex ItalicPattern = new(@"(?<!\*)\*(?!\*)[^*\r\n].*?\*(?!\*)|(?<!_)_(?!_)[^_\r\n].*?_(?!_)", RegexOptions.Compiled);
    private static readonly Regex StrikePattern = new(@"~~[^~\r\n].*?~~", RegexOptions.Compiled);
