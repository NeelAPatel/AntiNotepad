        };
        notebook.next_id = notebook
            .notes
            .iter()
            .map(|n| n.id)
            .max()
            .unwrap_or(0)
            .saturating_add(1)
            .max(1);
        notebook.prune_blank_interiors();
        Ok(notebook)
