    fn schedule_scroll_settle(&mut self, cx: &mut Context<Self>) {
        self.scroll_settle_epoch = self.scroll_settle_epoch.wrapping_add(1);
        let epoch = self.scroll_settle_epoch;
        cx.spawn(async move |this, cx| {
