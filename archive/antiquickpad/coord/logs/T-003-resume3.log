+fn horizontal_steps(delta: ScrollDelta) -> f32 {
+    match delta {
+        ScrollDelta::Pixels(delta) => f32::from(delta.x) / 40.0, // optional, untested smooth-input scaling
+        ScrollDelta::Lines(delta) => {
+            #[link(name = "user32")]
+            unsafe extern "system" { fn SystemParametersInfoW(action:u32,param:u32,value:*mut u32,flags:u32)->i32; }
+            let mut chars = 0u32;
+            if unsafe { SystemParametersInfoW(108,0,&mut chars,0) } != 0 && chars>0 && chars!=u32::MAX { delta.x/chars as f32 } else { delta.x }
+        }
+    }
+}
