    fn message_error(where_: &str) -> ShellError {
        let code = std::io::Error::last_os_error();
        pub fn show(&mut self) -> Result<(), ShellError> {
            self.window()?;
            native_set_visible(&self.shared, true);
            Ok(())
        }

        pub fn hide(&mut self) -> Result<(), ShellError> {
            self.window()?;
            native_set_visible(&self.shared, false);
            Ok(())
        }

        fn window(&self) -> Result<Hwnd, ShellError> {
            let hwnd = self.shared.target_hwnd.load(Ordering::Acquire) as Hwnd;
            if hwnd.is_null() || unsafe { IsWindow(hwnd) == 0 } {
                Err(ShellError(format!("GPUI window is not bound or has closed (title {:?})", self.title)))
            } else { Ok(hwnd) }
        }

        /// Remove tray/hotkey registrations and join the native message thread.
        pub fn dispose(&mut self) {
            let hwnd = self.native_hwnd.swap(0, Ordering::AcqRel) as Hwnd;
            // Windows requires a window to be destroyed by its creating thread.
            // WM_CLOSE is therefore posted to the tray thread's message queue.
            if !hwnd.is_null() { unsafe { PostMessageW(hwnd, WM_CLOSE, 0, 0); } }
            if let Some(thread) = self.thread.take() { let _ = thread.join(); }
            log(&self.log_path, "SHELL", "disposed=true");
        }
    }

    impl Drop for Shell { fn drop(&mut self) { self.dispose(); } }

    struct FindWindowQuery { process: Uint, title: Vec<u16>, class: Vec<u16>, found: Hwnd }

    unsafe extern "system" fn find_exact_window(hwnd: Hwnd, param: Lparam) -> Bool {
        let query = unsafe { &mut *(param as *mut FindWindowQuery) };
        if !query.found.is_null() || unsafe { GetWindow(hwnd, GW_OWNER).is_null() == false } { return 1; }
        let mut process = 0;
        unsafe { GetWindowThreadProcessId(hwnd, &mut process); }
        if process != query.process { return 1; }
        let len = unsafe { GetWindowTextLengthW(hwnd) };
        if len < 0 || len as usize + 1 != query.title.len() { return 1; }
        let mut title = vec![0u16; len as usize + 1];
        let copied = unsafe { GetWindowTextW(hwnd, title.as_mut_ptr(), title.len() as i32) };
        if copied != len || title != query.title { return 1; }
        let mut class = vec![0u16; query.class.len()];
        let copied_class = unsafe { GetClassNameW(hwnd, class.as_mut_ptr(), class.len() as i32) };
        if copied_class >= 0 && copied_class as usize + 1 == query.class.len() && class == query.class {
            query.found = hwnd;
            return 0;
        }
        1
    }

    unsafe extern "system" fn wnd_proc(hwnd: Hwnd, msg: Uint, wparam: Wparam, lparam: Lparam) -> Lresult {
        match msg {
            WM_HOTKEY if wparam == HOTKEY_ID as usize => {
                let state = unsafe { GetWindowLongPtrW(hwnd, GWLP_USERDATA) as *const NativeShared };
                if !state.is_null() {
                    let state = unsafe { &*state };
                    let target = state.target_hwnd.load(Ordering::Acquire) as Hwnd;
                    native_set_visible(state, target.is_null() || unsafe { IsWindowVisible(target) == 0 });
                }
                0
            }
            WM_TRAY => {
                let state = unsafe { GetWindowLongPtrW(hwnd, GWLP_USERDATA) as *const NativeShared };
                match lparam as usize {
                    WM_RBUTTONUP => unsafe { show_tray_menu(hwnd, state); },
                    WM_LBUTTONUP => if !state.is_null() {
                        let state = unsafe { &*state };
                        let target = state.target_hwnd.load(Ordering::Acquire) as Hwnd;
                        native_set_visible(state, target.is_null() || unsafe { IsWindowVisible(target) == 0 });
                    },
                    _ => {}
                }
                0
            }
            WM_CLOSE => { unsafe { DestroyWindow(hwnd); } 0 }
            WM_DESTROY => {
                let state = unsafe { GetWindowLongPtrW(hwnd, GWLP_USERDATA) as *const NativeShared };
                if !state.is_null() {
                    unsafe { SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0); drop(Arc::from_raw(state)); }
                }
                unsafe { PostQuitMessage(0); }
                0
            }
            _ => unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) },
        }
    }

    unsafe fn show_tray_menu(hwnd: Hwnd, state: *const NativeShared) {
        if state.is_null() { return; }
        let menu = unsafe { CreatePopupMenu() };
        if menu.is_null() { return; }
        let show = wide("Show"); let hide = wide("Hide"); let quit = wide("Quit");
        unsafe {
            AppendMenuW(menu, MF_STRING, ID_SHOW, show.as_ptr());
            AppendMenuW(menu, MF_STRING, ID_HIDE, hide.as_ptr());
            AppendMenuW(menu, MF_SEPARATOR, 0, null());
            AppendMenuW(menu, MF_STRING, ID_QUIT, quit.as_ptr());
            let mut point = Point { x: 0, y: 0 };
            GetCursorPos(&mut point);
            SetForegroundWindow(hwnd);
            let selected = TrackPopupMenu(menu, TPM_RIGHTBUTTON | TPM_RETURNCMD, point.x, point.y, 0, hwnd, null());
            let shared = &*state;
            match selected {
                ID_SHOW => native_set_visible(shared, true),
                ID_HIDE => native_set_visible(shared, false),
                ID_QUIT => { let _ = shared.events.send(ShellEvent::Quit); }
                _ => {}
            }
            DestroyMenu(menu);
        }
    }

    fn tray_data(hwnd: Hwnd) -> NotifyIconDataW {
        let mut tip = [0u16; 128];
        let text = wide("AntiQuickPad");
        tip[..text.len().min(128)].copy_from_slice(&text[..text.len().min(128)]);
        NotifyIconDataW { cb_size: size_of::<NotifyIconDataW>() as Uint, hwnd, id: 1,
            flags: NIF_MESSAGE | NIF_ICON | NIF_TIP, callback_message: WM_TRAY,
            icon: null_mut(), tip, state: 0, state_mask: 0, info: [0; 256],
            timeout_or_version: NotifyTimeout { version: 4 }, info_title: [0; 64],
            info_flags: 0, guid_item: Guid { data1: 0, data2: 0, data3: 0, data4: [0; 8] }, balloon_icon: null_mut() }
    }

    fn native_thread(log_path: PathBuf, shared: Arc<NativeShared>, startup: mpsc::SyncSender<Result<isize, ShellError>>) {
        let class_name = wide("AntiQuickPadShellMessageWindow");
        let instance = unsafe { GetModuleHandleW(null()) };
        let class = WndClassW { style: 0, wnd_proc: Some(wnd_proc), cls_extra: 0, wnd_extra: 0,
            instance, icon: null_mut(), cursor: null_mut(), background: null_mut(), menu_name: null(), class_name: class_name.as_ptr() };
        unsafe { RegisterClassW(&class); }
        // HWND_MESSAGE is the documented pseudo-parent ((HWND)-3).
        let hwnd = unsafe { CreateWindowExW(0, class_name.as_ptr(), class_name.as_ptr(), 0, 0, 0, 0, 0, (-3isize) as Hwnd, null_mut(), instance, null_mut()) };
        if hwnd.is_null() { let error = message_error("CreateWindowExW(message-only)"); log(&log_path, "SHELL_ERROR", &error.to_string()); let _ = startup.send(Err(error)); return; }
        let shared_ptr = Arc::into_raw(shared.clone());
        unsafe { SetWindowLongPtrW(hwnd, GWLP_USERDATA, shared_ptr as isize); }
        let icon = unsafe { LoadIconW(null_mut(), IDI_APPLICATION) };
        let mut data = tray_data(hwnd);
        data.icon = icon;
        let tray_ok = unsafe { Shell_NotifyIconW(NIM_ADD, &data) != 0 };
        if !tray_ok { let error = message_error("Shell_NotifyIconW(NIM_ADD)"); log(&log_path, "SHELL_ERROR", &error.to_string()); unsafe { DestroyWindow(hwnd); } let _ = startup.send(Err(error)); return; }
        if unsafe { RegisterHotKey(hwnd, HOTKEY_ID, MOD_CONTROL | MOD_ALT | MOD_NOREPEAT, VK_SPACE) } == 0 {
            let error = message_error("RegisterHotKey(Ctrl+Alt+Space)");
            log(&log_path, "SHELL_ERROR", &format!("hotkey registration failed: {error}"));
            unsafe { Shell_NotifyIconW(NIM_DELETE, &data); DestroyWindow(hwnd); }
            let _ = startup.send(Err(error)); return;
        }
        log(&log_path, "REGISTER", "tray_icon=true\thotkey=Ctrl+Alt+Space\tresult=success");
        let _ = startup.send(Ok(hwnd as isize));
        let mut msg: Msg = unsafe { zeroed() };
        loop {
            let result = unsafe { GetMessageW(&mut msg, null_mut(), 0, 0) };
            if result <= 0 { break; }
            unsafe { TranslateMessage(&msg); DispatchMessageW(&msg); }
        }
        unsafe {
            UnregisterHotKey(hwnd, HOTKEY_ID);
            Shell_NotifyIconW(NIM_DELETE, &data);
        }
        log(&log_path, "REGISTER", "tray_icon=false\thotkey_registered=false");
    }

}

