const LANG: &str = "antiquickpad-markdown";

/// Create the persistent source editor entity. The GPUI editor defaults to
/// soft wrapping, line numbers, folding, and two-space soft tabs.
pub fn create(text: impl Into<String>, window: &mut Window, cx: &mut App) -> Entity<EditorState> {
    let editor = cx.new(|cx| {
        EditorState::new(window, cx)
            .language(LANG)
            .soft_wrap(true)
            .line_number(true)
            .folding(true)
            .default_value(text.into())
    });
    editor.update(cx, |state, cx| {
        state.set_highlighter_factory(
            Rc::new(|language| {
                (language == LANG).then(|| {
                    Box::new(MarkdownSourceHighlighter::default()) as Box<dyn InputHighlighter>
                })
            }),
            cx,
        );
    });
    editor
}

/// Render the live editor and turn clicks on source checkbox markers into
//! Windows tray and global-hotkey shell for the GPUI spike.
//!
//! The native message pump owns only a hidden message-only HWND, the tray icon,
//! and Ctrl+Alt+Space registration. It sends [`ShellEvent`]s over an std channel;
//! the GPUI thread must call [`Shell::poll`] and apply them there.

use std::{
    fs::OpenOptions,
    io::Write,
    path::PathBuf,
    sync::{mpsc, Mutex, OnceLock},
    time::{Instant, SystemTime, UNIX_EPOCH},
};

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ShellEvent {
    Shown,
    Hidden,
    Quit,
    Error(String),
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ShellError(pub String);

