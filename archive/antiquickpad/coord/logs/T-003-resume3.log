        pub fn poll(&mut self) -> Vec<ShellEvent> {
            let mut events = Vec::new();
            while let Ok(event) = self.rx.try_recv() { events.push(event); }
            let started = self.shared.show_started_us.load(Ordering::Acquire);
            if started != 0 {
                let hwnd = self.shared.target_hwnd.load(Ordering::Acquire) as Hwnd;
                if !hwnd.is_null() && unsafe { IsWindowVisible(hwnd) != 0 && GetForegroundWindow() == hwnd }
                    && !self.shared.ready_logged.swap(true, Ordering::AcqRel) {
                    let now = epoch_micros();
                    log(&self.log_path, "SHOW_READY", &format!("show_to_visible_and_foreground_us={}", now.saturating_sub(started)));
                    self.shared.show_started_us.store(0, Ordering::Release);
                } else if epoch_micros().saturating_sub(started) > 2_000_000 {
                    log(&self.log_path, "SHOW_TIMEOUT", "window did not become visible and foreground within 2000ms");
                    self.shared.show_started_us.store(0, Ordering::Release);
                }
            }
            events
        }

        pub fn toggle(&mut self) -> Result<(), ShellError> {
        let dt = now_ms.saturating_sub(previous) as f64 / 1000.0;
        if dt <= 0.0 { return; }
        let mut remaining = dt.min(0.1);
        while remaining > 0.0 {
            let step = remaining.min(1.0 / 120.0);
            let acceleration = SPRING_K * (self.target as f64 - self.x as f64) - SPRING_C * self.velocity;
            self.velocity += acceleration * step;
            self.x = (self.x as f64 + self.velocity * step) as f32;
            remaining -= step;
        }
        if (self.x - self.target).abs() < 0.001 && self.velocity.abs() < 0.01 {
            self.x = self.target;
            self.velocity = 0.0;
        }
    }

    fn commit_direction(&mut self, notebook: &mut Notebook, direction: i32) -> CarouselEvent {
        if direction > 0 {
            if notebook.current_index + 1 < notebook.notes.len() {
                notebook.current_index += 1;
                self.x = -1.0; self.target = 0.0; self.velocity = 0.0; self.last_tick_ms = None;
                CarouselEvent::PageChanged { index: notebook.current_index }
            } else {
                notebook.add_note(String::new());
                self.x = -1.0; self.target = 0.0; self.velocity = 0.0; self.last_tick_ms = None;
                CarouselEvent::NoteCreated { index: notebook.current_index }
            }
        } else if notebook.current_index > 0 {
            notebook.current_index -= 1;
            self.x = 1.0; self.target = 0.0; self.velocity = 0.0; self.last_tick_ms = None;
            CarouselEvent::PageChanged { index: notebook.current_index }
        } else { self.target = 0.0; CarouselEvent::None }
    }
}


