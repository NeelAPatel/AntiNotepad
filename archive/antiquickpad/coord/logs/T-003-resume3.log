// # spike — disposable Gate 1 probe, not the carousel implementation.
use gpui_kit::component::input::{Editor, EditorState};
use gpui_kit::*;
use std::{
    cell::RefCell,
    collections::VecDeque,
    fs::OpenOptions,
    io::Write,
    path::PathBuf,
    rc::Rc,
    time::{SystemTime, UNIX_EPOCH},
};

fn log_line(path: &PathBuf, kind: &str, detail: &str) {
    let micros = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_micros();
    if let Ok(mut file) = OpenOptions::new().create(true).append(true).open(path) {
        if let Err(error) = writeln!(file, "{micros}\t{kind}\t{detail}") {
            eprintln!("probe log write failed: {error}");
        }
    } else {
        eprintln!("cannot open probe log: {}", path.display());
    }
}

// Read the same Windows scaling settings used by the pinned wheel backend.
// These are normalized wheel steps, not an assertion about physical detents.
fn wheel_steps(dx: f32, dy: f32, units: &str) -> String {
    if units != "lines" {
        return "notch_steps_x=NA\tnotch_steps_y=NA".into();
    }
    #[link(name = "user32")]
    unsafe extern "system" {
        fn SystemParametersInfoW(action: u32, param: u32, value: *mut u32, flags: u32) -> i32;
    }
    let read = |action| {
        let mut value = 0u32;
        // GETWHEELSCROLLCHARS / GETWHEELSCROLLLINES write one UINT; no settings mutation.
        if unsafe { SystemParametersInfoW(action, 0, &mut value, 0) } != 0
            && value > 0
            && value != u32::MAX
        {
            Some(value as f32)
        } else {
            None
        }
    };
    let step = |delta: f32, amount: Option<f32>| {
        amount
            .map(|scale| format!("{:.4}", delta / scale))
            .unwrap_or_else(|| "NA".into())
    };
    format!(
        "notch_steps_x={}\tnotch_steps_y={}",
        step(dx, read(108)),
        step(dy, read(104))
    )
}

fn show_event(recent: &Rc<RefCell<VecDeque<String>>>, detail: String) {
    let mut rows = recent.borrow_mut();
    rows.push_back(detail);
    while rows.len() > 7 {
        rows.pop_front();
    }
}

struct Probe {
    editor: Entity<EditorState>,
    log: PathBuf,
    recent: Rc<RefCell<VecDeque<String>>>,
}
impl Probe {
    fn new(log: PathBuf, window: &mut Window, cx: &mut Context<Self>) -> Self {
        let fixture = (1..=70).map(|n| format!("Line {n:02}: Editable scratchpad input probe. Keep the pointer over this editor while testing horizontal wheel, vertical wheel and held-button mouse drag.\n")).collect::<String>();
        let editor = cx.new(|cx| {
            EditorState::new(window, cx)
                .soft_wrap(true)
                .default_value(fixture)
        });
        editor.update(cx, |state, cx| state.focus(window, cx));
        log_line(&log, "SESSION", "editor_created_focus_requested");
        Self {
            editor,
            log,
            recent: Rc::new(RefCell::new(VecDeque::new())),
        }
    }
}
impl Render for Probe {
    fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
        let log = self.log.clone();
        let key_log = log.clone();
        let focus = self.editor.read(cx).focus_handle(cx);
        let key_focus = focus.clone();
        let recent = self.recent.clone();
        let key_recent = recent.clone();
        let weak = cx.entity().downgrade();
        let key_weak = weak.clone();
        let mouse_log = log.clone();
        let mouse_focus = focus.clone();
        let mouse_recent = recent.clone();
        let mouse_weak = weak.clone();
        // Painted before the editor: Capture runs before its Bubble scroll consumer.
        // This canvas installs listeners, with no hitbox and no event consumption.
        let observer = canvas(|_, _, _| (), move |_, _, window, _| {
            let down_log = mouse_log.clone();
            let down_focus = mouse_focus.clone();
            let down_recent = mouse_recent.clone();
            let down_weak = mouse_weak.clone();
            window.on_mouse_event(move |event: &MouseDownEvent, phase, window, cx| {
                if phase != DispatchPhase::Capture { return; }
                let detail = format!("button={:?}\tx={:?}\ty={:?}\teditor_focus={}", event.button, event.position.x, event.position.y, down_focus.is_focused(window));
                log_line(&down_log, "MOUSE_PRESS", &detail);
                show_event(&down_recent, format!("MOUSE_PRESS\t{detail}"));
                let _ = down_weak.update(cx, |_, cx| cx.notify());
            });
            let move_log = mouse_log.clone();
            let move_focus = mouse_focus.clone();
            let move_recent = mouse_recent.clone();
            let move_weak = mouse_weak.clone();
            window.on_mouse_event(move |event: &MouseMoveEvent, phase, window, cx| {
                if phase != DispatchPhase::Capture || event.pressed_button.is_none() { return; }
                let detail = format!("button={:?}\tx={:?}\ty={:?}\teditor_focus={}", event.pressed_button, event.position.x, event.position.y, move_focus.is_focused(window));
                log_line(&move_log, "MOUSE_DRAG_MOVE", &detail);
                show_event(&move_recent, format!("MOUSE_DRAG_MOVE\t{detail}"));
                let _ = move_weak.update(cx, |_, cx| cx.notify());
            });
            window.on_mouse_event(move |event: &MouseUpEvent, phase, window, cx| {
                if phase != DispatchPhase::Capture { return; }
                let detail = format!("button={:?}\tx={:?}\ty={:?}\teditor_focus={}", event.button, event.position.x, event.position.y, mouse_focus.is_focused(window));
                log_line(&mouse_log, "MOUSE_RELEASE", &detail);
                show_event(&mouse_recent, format!("MOUSE_RELEASE\t{detail}"));
                let _ = mouse_weak.update(cx, |_, cx| cx.notify());
            });
            window.on_mouse_event(move |event: &ScrollWheelEvent, phase, window, cx| {
                if phase != DispatchPhase::Capture { return; }
                let (units, dx, dy) = match event.delta {
                    ScrollDelta::Pixels(delta) => ("pixels", f32::from(delta.x), f32::from(delta.y)),
                    ScrollDelta::Lines(delta) => ("lines", delta.x, delta.y),
                };
                let detail = format!("phase={:?}\tunits={units}\tdx={dx:.4}\tdy={dy:.4}\t{}\teditor_focus={}\tx={:?}\ty={:?}", event.touch_phase, wheel_steps(dx, dy, units), focus.is_focused(window), event.position.x, event.position.y);
                log_line(&log, "PUBLIC_SCROLL", &detail);
                let mut rows = recent.borrow_mut();
                rows.push_back(detail);
                while rows.len() > 7 { rows.pop_front(); }
                drop(rows);
                let _ = weak.update(cx, |_, cx| cx.notify());
            });
            window.on_key_event(move |event: &KeyDownEvent, phase, window, cx| {
                if phase != DispatchPhase::Capture { return; }
                let label = match event.keystroke.key.as_str() {
                    "f1" => "SLOW_PAN",
                    "f2" => "PAN_PAUSE_LIFT",
                    "f3" => "FAST_FLICK",
                    "f4" => "INTERRUPT_INERTIA",
                    "f5" => "VERTICAL_SCROLL",
                    "f6" => "TEXT_SELECTION",
                    "f7" => "HORIZONTAL_WHEEL",
                    "f8" => "COMPLETE",
                    "f9" => "DRAG",
                    _ => return,
                };
                let detail = format!("{label}\teditor_focus={}", key_focus.is_focused(window));
                log_line(&key_log, "MARKER", &detail);
                let mut rows = key_recent.borrow_mut();
                rows.push_back(detail);
                while rows.len() > 7 { rows.pop_front(); }
                drop(rows);
                let _ = key_weak.update(cx, |_, cx| cx.notify());
            });
        }).absolute().size_full();
        let rows = self.recent.borrow().iter().cloned().collect::<Vec<_>>();
        div().relative().size_full().flex().flex_col().gap_2().p_4()
            .bg(rgb(0x161b22)).text_color(rgb(0xe6edf3))
            .child(observer)
            .child("AntiQuickPad B — Gate 1 input probe (physical test pending)")
            .child("Click editor; type OK. Pointer inside editor: F7 horizontal wheel | F5 vertical wheel | F6 selection/undo | F9 held-button drag | F8 done")
            .child(format!("Trace: {}", self.log.display()))
            .child(Editor::new(&self.editor).h(px(380.0)))
            .child(div().text_size(px(12.0)).children(rows.into_iter().map(|row| div().child(row))))
    }
}
fn main() {
    let log = std::env::var_os("ANTIQUICKPAD_PROBE_LOG")
        .map(PathBuf::from)
        .unwrap_or_else(|| {
            PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../docs/spikes/B/input-probe.tsv")
        });
    // Native callback reads this variable; launch-probe.ps1 sets it before process creation.
    log_line(
        &log,
