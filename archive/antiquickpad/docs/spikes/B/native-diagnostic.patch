+fn probe_wheel_trace(message: &str, raw_delta: i16) {
+    use std::io::Write as _;
+    let path = std::env::var_os("ANTIQUICKPAD_PROBE_LOG").map(std::path::PathBuf::from)
+        .unwrap_or_else(|| std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
