+    let micros = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default().as_micros();
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = writeln!(file, "{micros}\tNATIVE_WHEEL\tmessage={message}\traw_delta={raw_delta}\tnotch_delta={:.4}", raw_delta as f32 / WHEEL_DELTA as f32);
+    }
+}
