<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="AppInfo.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>antinotepad.ico</ApplicationIcon>
    <!-- A resident tray app: no background GC thread, smaller committed heap. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup>
    <AntiNotepadDev Condition="'$(AntiNotepadDev)' == ''">false</AntiNotepadDev>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AntiNotepadDev)' == 'true'">
    <AssemblyTitle>$(AppName) (dev)</AssemblyTitle>
    <Product>$(AppName) (dev)</Product>
    <ApplicationIcon>antinotepad-dev.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AppName">
      <Value>$(AppName)</Value>
    </AssemblyMetadata>
    <AssemblyMetadata Include="AntiNotepadDev">
      <Value>$(AntiNotepadDev)</Value>
    </AssemblyMetadata>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="antinotepad.ico" />
    <AvaloniaResource Include="antinotepad-dev.ico" />
    <!-- Microsoft's Fluent UI System Icons (MIT): named icons that look the same on every PC. Its licence ships beside the app. -->
    <AvaloniaResource Include="Assets/Fonts/FluentSystemIcons-Regular.ttf" />
    <None Include="Assets/Fonts/FluentSystemIcons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Link="Licenses/FluentSystemIcons-LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>
</Project>
